# Perfect Cube OBJ — Consistent CCW Winding — Outward Normals
# For AMOURANTH RTX Engine — Empire Scale — Pink Photons Eternal

# Vertices (8 for a cube, centered at origin, side length 2)
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Faces — ALL COUNTER-CLOCKWISE (viewed from outside)
# Front (+Z)
f 1 6 5
f 6 7 5

# Back (-Z)
f 3 2 4
f 2 1 4

# Right (+X)
f 2 7 6
f 7 3 2

# Left (-X)
f 4 5 8
f 5 7 8

# Top (+Y)
f 4 8 3
f 8 7 3

# Bottom (-Y)
f 5 1 2
f 5 2 6