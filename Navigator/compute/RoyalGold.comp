#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

#define PI  3.14159265359
#define TAU (2.0 * PI)
#define MAX_STEPS 160
#define MAX_DIST  50.0
#define SURF_DIST 0.001

// Generate colorful noise for vibrant backgrounds and effects
float hash(vec3 p) {
    p = fract(p * 0.3183099 + .1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f*f*(3.0-2.0*f);
    return mix(mix(mix( hash(i + vec3(0,0,0)), 
                        hash(i + vec3(1,0,0)), f.x),
                   mix( hash(i + vec3(0,1,0)), 
                        hash(i + vec3(1,1,0)), f.x), f.y),
               mix(mix( hash(i + vec3(0,0,1)), 
                        hash(i + vec3(1,0,1)), f.x),
                   mix( hash(i + vec3(0,1,1)), 
                        hash(i + vec3(1,1,1)), f.x), f.y), f.z);
}

// Create a rainbow color effect
vec3 rainbow(float t) {
    t = fract(t);
    return 0.5 + 0.5 * cos(TAU * (t + vec3(0.0, 0.33, 0.67)));
}

// Rotation matrix for swirl effects
mat2 rot(float a) {
    float c = cos(a), s = sin(a);
    return mat2(c, -s, s, c);
}

// Signed Distance Functions for shapes
float sdSphere(vec3 p, float r) { return length(p) - r; }

float sdBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0);
}

// Scene: Dreamlike islands in a colorful sky
float map(vec3 p) {
    float d = MAX_DIST;

    // Fanciful main island
    vec3 baseP = p;
    baseP.y += 1.5 + sin(pc.totalTime * 0.3) * 0.15;
    float base = sdSphere(baseP, 4.0);
    base += 1.2 * noise(baseP * 1.2 + vec3(0.0, pc.totalTime * 0.4, 0.0));
    d = min(d, base);

    // Satellite islands rotating around
    for (int i = 0; i < 6; ++i) {
        float fi = float(i);
        vec3 off = vec3(sin(fi * 1.618 + pc.totalTime * 0.5) * 6.0,
                        2.0 + sin(fi * 2.718 + pc.totalTime * 0.6) * 2.0,
                        cos(fi * 3.141 + pc.totalTime * 0.7) * 6.0);
        float chunk = sdSphere(p - off, 1.5 + 0.5 * sin(fi * 12.0 + pc.totalTime));
        chunk += 0.6 * noise((p - off) * 4.0);
        d = min(d, chunk);
    }

    // Crystal features glowing with light
    vec3 cryP = p;
    cryP.xz *= rot(pc.totalTime * 0.2);
    cryP.y += 3.0;
    float crystal = sdSphere(cryP, 0.4 + 0.2 * sin(cryP.y * 15.0 + pc.totalTime * 2.0));
    d = min(d, crystal);

    return d;
}

// Raymarching to render the scene
float rayMarch(vec3 ro, vec3 rd) {
    float dO = 0.0;
    for (int i = 0; i < MAX_STEPS; i++) {
        vec3 p = ro + rd * dO;
        float dS = map(p);
        dO += dS;
        if (dO > MAX_DIST || abs(dS) < SURF_DIST) break;
    }
    return dO;
}

// Calculate normal vectors for lighting
vec3 getNormal(vec3 p) {
    float d = map(p);
    vec2 e = vec2(0.001, 0.0);
    vec3 n = d - vec3(
        map(p - e.xyy),
        map(p - e.yxy),
        map(p - e.yyx));
    return normalize(n);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim) * 2.0 - 1.0;
    uv.x *= float(dim.x) / float(dim.y);

    // Dynamic camera orbiting the scene
    float camT = pc.totalTime * 0.12;
    vec3 ro = vec3(sin(camT) * 18.0, 5.0 + sin(camT * 0.8) * 3.0, cos(camT) * 18.0);
    vec3 ta = vec3(0.0, 3.0, 0.0);
    vec3 ww = normalize(ta - ro);
    vec3 uu = normalize(cross(ww, vec3(0,1,0)));
    vec3 vv = cross(uu, ww);
    vec3 rd = normalize(uv.x * uu + uv.y * vv + 1.6 * ww);

    float d = rayMarch(ro, rd);

    vec3 col = vec3(0.0);

    // Vibrant sky background
    float skyGrad = 0.5 + 0.5 * uv.y;
    col = rainbow(skyGrad * 0.3 + pc.totalTime * 0.05) * 0.8;
    col += vec3(1.0, 0.95, 0.8) * pow(1.0 - length(uv) * 0.4, 6.0) * 0.6; // Sunlight

    // Twinkling stars for added magic
    float stars = smoothstep(0.98, 1.0, noise(vec3(uv * 200.0, pc.totalTime * 0.5)));
    col += vec3(1.0) * stars * 1.5;

    if (d < MAX_DIST) {
        vec3 p = ro + rd * d;
        vec3 n = getNormal(p);

        // Bright ambient light effect
        vec3 lightDir = normalize(vec3(0.6, 1.0, 0.8));
        float diff = max(0.0, dot(n, lightDir));

        // Rainbow accents and sparkle effects
        float rim = pow(1.0 - max(0.0, dot(n, -rd)), 3.0);
        float sparkle = smoothstep(0.7, 0.95, noise(p * 20.0 + vec3(pc.totalTime * 3.0)));

        // Colorful crystal material with golden hints
        float rainbowAmt = smoothstep(0.3, 0.8, noise(p * 4.0 + pc.totalTime * 0.3));
        vec3 albedo = rainbow(rainbowAmt * 0.4 + pc.totalTime * 0.1);
        albedo = mix(albedo, vec3(0.98, 0.85, 0.55), 0.6); // Golden touch

        vec3 lighting = albedo * diff * vec3(1.0, 0.95, 0.85) * 2.0; // Sunlight effect
        lighting += albedo * rim * rainbow(rim * 2.0 + pc.totalTime * 0.8) * 1.8;
        lighting += albedo * sparkle * 3.0; // Sparkling effects
        lighting += albedo * 0.25; // Ambient light bounce

        col = lighting;
    }

    // Final color boosting for a vibrant glow
    col *= 1.2 + 0.3 * sin(pc.totalTime * 0.5 + length(uv) * 3.0);

    // Showstopper finale!
    imageStore(outputImage, pix, vec4(col, 1.0)); // IMPRESSIVE DISPLAY
}