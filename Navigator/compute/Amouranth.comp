// =============================================================================
// Shader code – FULL ORIGINAL BODY PRESERVED BELOW
// =============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

layout(push_constant) uniform Push {
    float       totalTime;
} pc;

// ── SDF primitives ──────────────────────────────────────────────────────────

mat2 rot2(float a) { float c=cos(a), s=sin(a); return mat2(c,-s,s,c); }

float sdSphere(vec3 p, float r) { return length(p) - r; }

float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p-a, ba = b-a;
    float h = clamp(dot(pa,ba)/dot(ba,ba), 0.0, 1.0);
    return length(pa - ba*h) - r;
}

float sdEllipsoid(vec3 p, vec3 r) {
    float k0 = length(p/r);
    float k1 = length(p/(r*r));
    return k0*(k0-1.0)/k1;
}

float sdCylinder(vec3 p, float r, float h) {
    vec2 d = vec2(length(p.xz)-r, abs(p.y)-h);
    return min(max(d.x,d.y),0.0) + length(max(d,0.0));
}

float sdTorus(vec3 p, vec2 t) {
    vec2 q = vec2(length(p.xz)-t.x,p.y);
    return length(q)-t.y;
}

float noise3(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p); f = f*f*(3.0-2.0*f);
    float a = fract(sin(dot(i, vec3(12.9898,78.233,45.5432))) * 43758.5453);
    float b = fract(sin(dot(i+vec3(1,0,0), vec3(12.9898,78.233,45.5432))) * 43758.5453);
    float c = fract(sin(dot(i+vec3(0,1,0), vec3(12.9898,78.233,45.5432))) * 43758.5453);
    float d = fract(sin(dot(i+vec3(1,1,0), vec3(12.9898,78.233,45.5432))) * 43758.5453);
    return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
}

// ── Jump ──────────────────────────────────────────────────────────────────

float jumpOffset() {
    float t = pc.totalTime * JUMP_FREQ;
    float cycle = sin(t) * 0.5 + 0.5;
    float vel = cos(t) * JUMP_FREQ;
    return cycle * JUMP_AMP * (1.0 - exp(-abs(vel) * GRAVITY_DAMP));
}

// ── Map ───────────────────────────────────────────────────────────────────

float map(vec3 pos) {
    vec3 p = pos / GLOBAL_SCALE;
    float jump = jumpOffset();
    p.y += jump * 0.6;

    float breath = sin(pc.totalTime * BREATH_SPEED) * BREATH_AMP;
    p.y += breath * 0.5;

    float d = 1e10;

    float headTilt = sin(pc.totalTime * HEAD_TILT_FREQ + 1.2) * HEAD_TILT_AMP;

    vec3 headP = p - vec3(0.0, 1.78 + jump*0.2, 0.0);
    headP.xz *= rot2(headTilt);
    d = min(d, sdSphere(headP, 0.34));

    vec3 neckP = p - vec3(0.0, 1.42 + jump*0.15, 0.0);
    neckP.xz *= rot2(headTilt * 0.6);
    d = min(d, sdCapsule(neckP, vec3(0,-0.16,0), vec3(0,0.16,0), 0.105));

    vec3 torsoP = p - vec3(0.0, 1.05 + jump*0.1, 0.0);
    torsoP.y += breath * 0.4;
    d = min(d, sdEllipsoid(torsoP, vec3(0.38, 0.58, 0.28)));

    float jigT = pc.totalTime * BOOB_JIGGLE_FREQ + jump * 3.0;
    float jigL = sin(jigT) * exp(-abs(sin(jigT*0.4))*BOOB_JIGGLE_DAMP) * BOOB_JIGGLE_AMP_LEFT;
    float jigR = sin(jigT + BOOB_JIGGLE_PHASE_DIFF) * exp(-abs(sin(jigT*0.4))*BOOB_JIGGLE_DAMP) * BOOB_JIGGLE_AMP_RIGHT;

    vec3 leftBoobP  = p - vec3(-BOOB_SEPARATION, BOOB_BASE_Y + jump*0.3 + breath*0.5, BOOB_BASE_Z);
    leftBoobP  += vec3(0.05*jigL, -0.11*abs(jigL), 0.06*jigL);
    d = min(d, sdSphere(leftBoobP, BOOB_RADIUS_LEFT));

    vec3 rightBoobP = p - vec3(BOOB_SEPARATION, BOOB_BASE_Y + jump*0.3 + breath*0.5, BOOB_BASE_Z);
    rightBoobP += vec3(-0.05*jigR, -0.11*abs(jigR), 0.06*jigR);
    d = min(d, sdSphere(rightBoobP, BOOB_RADIUS_RIGHT));

    float armSwing = sin(pc.totalTime * ARM_SWAY_FREQ + jump * 2.0) * ARM_SWAY_AMP;
    float armAngle = armSwing + ELBOW_BEND_RELAX;

    // Left arm – physics loose joints (gravity sag + acceleration/damping)
    vec3 shoulderL = vec3(-SHOULDER_X_OFFSET, SHOULDER_Y + jump*0.15, 0.02);
    vec3 elbowL_target = shoulderL + vec3(-ARM_UPPER_LENGTH * cos(armAngle), -ARM_UPPER_LENGTH * sin(armAngle) - 0.12, 0.04);  // gravity pull down
    vec3 elbowL = mix(elbowL_target, elbowL_target + vec3(0, -0.18, 0), 0.6);  // increased loose sag
    vec3 wristL = elbowL + vec3(-ARM_LOWER_LENGTH * cos(armAngle*0.85), -ARM_LOWER_LENGTH * sin(armAngle*0.85) - 0.10, 0.03);  // more gravity

    d = min(d, sdCapsule(p - shoulderL, vec3(0,0,0), elbowL - shoulderL, ARM_THICKNESS));
    d = min(d, sdCapsule(p - elbowL,    vec3(0,0,0), wristL - elbowL,    ARM_THICKNESS * 0.90));

    // Right arm – symmetric but phase offset for natural resting pose
    vec3 shoulderR = vec3( SHOULDER_X_OFFSET, SHOULDER_Y + jump*0.15, 0.02);
    vec3 elbowR_target = shoulderR + vec3( ARM_UPPER_LENGTH * cos(armAngle), -ARM_UPPER_LENGTH * sin(armAngle) - 0.12, 0.04);
    vec3 elbowR = mix(elbowR_target, elbowR_target + vec3(0, -0.18, 0), 0.6);
    vec3 wristR = elbowR + vec3( ARM_LOWER_LENGTH * cos(armAngle*0.85), -ARM_LOWER_LENGTH * sin(armAngle*0.85) - 0.10, 0.03);

    d = min(d, sdCapsule(p - shoulderR, vec3(0,0,0), elbowR - shoulderR, ARM_THICKNESS));
    d = min(d, sdCapsule(p - elbowR,    vec3(0,0,0), wristR - elbowR,    ARM_THICKNESS * 0.90));

    // Hands & fingers (unchanged)
    vec3 palmL = wristL + vec3(-0.03 * cos(armAngle*1.1), -0.06 * sin(armAngle*1.1), 0.02);
    d = min(d, sdEllipsoid(p - palmL, vec3(HAND_SCALE*0.82, HAND_SCALE*0.58, HAND_SCALE*0.48)));

    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float spread = (fi - 1.5) * 0.26;
        float curl   = 0.12 + 0.08 * abs(spread);
        vec3 base = palmL + vec3(spread * HAND_SCALE * 0.45, -HAND_SCALE * 0.28, spread * HAND_SCALE * 0.28);
        vec3 mid  = base + vec3(0.0, -FINGER_LENGTH*0.45, 0.0);
        vec3 tip  = mid  + vec3(0.0, -FINGER_LENGTH*0.55 * cos(curl), -FINGER_LENGTH*0.55 * sin(curl));
        d = min(d, sdCapsule(p - base, vec3(0,0,0), mid - base, FINGER_THICKNESS));
        d = min(d, sdCapsule(p - mid,  vec3(0,0,0), tip - mid,  FINGER_THICKNESS * 0.82));
    }

    vec3 thumbBaseL = palmL + vec3(-0.12 * HAND_SCALE, -HAND_SCALE * 0.18, 0.18 * HAND_SCALE);
    vec3 thumbMidL  = thumbBaseL + vec3(-THUMB_LENGTH*0.4 * cos(THUMB_ANGLE), -THUMB_LENGTH*0.4 * sin(THUMB_ANGLE), 0.04);
    vec3 thumbTipL  = thumbMidL  + vec3(-THUMB_LENGTH*0.6 * cos(THUMB_ANGLE*0.9), -THUMB_LENGTH*0.6 * sin(THUMB_ANGLE*0.9), 0.03);
    d = min(d, sdCapsule(p - thumbBaseL, vec3(0,0,0), thumbMidL - thumbBaseL, THUMB_THICKNESS));
    d = min(d, sdCapsule(p - thumbMidL,  vec3(0,0,0), thumbTipL - thumbMidL,  THUMB_THICKNESS * 0.85));

    vec3 palmR = wristR + vec3(0.03 * cos(armAngle*1.1), -0.06 * sin(armAngle*1.1), 0.02);
    d = min(d, sdEllipsoid(p - palmR, vec3(HAND_SCALE*0.82, HAND_SCALE*0.58, HAND_SCALE*0.48)));

    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float spread = (fi - 1.5) * -0.26;
        float curl   = 0.12 + 0.08 * abs(spread);
        vec3 base = palmR + vec3(spread * HAND_SCALE * 0.45, -HAND_SCALE * 0.28, -spread * HAND_SCALE * 0.28);
        vec3 mid  = base + vec3(0.0, -FINGER_LENGTH*0.45, 0.0);
        vec3 tip  = mid  + vec3(0.0, -FINGER_LENGTH*0.55 * cos(curl), -FINGER_LENGTH*0.55 * sin(curl));
        d = min(d, sdCapsule(p - base, vec3(0,0,0), mid - base, FINGER_THICKNESS));
        d = min(d, sdCapsule(p - mid,  vec3(0,0,0), tip - mid,  FINGER_THICKNESS * 0.82));
    }

    vec3 thumbBaseR = palmR + vec3(0.12 * HAND_SCALE, -HAND_SCALE * 0.18, 0.18 * HAND_SCALE);
    vec3 thumbMidR  = thumbBaseR + vec3(THUMB_LENGTH*0.4 * cos(THUMB_ANGLE), -THUMB_LENGTH*0.4 * sin(THUMB_ANGLE), 0.04);
    vec3 thumbTipR  = thumbMidR  + vec3(THUMB_LENGTH*0.6 * cos(THUMB_ANGLE*0.9), -THUMB_LENGTH*0.6 * sin(THUMB_ANGLE*0.9), 0.03);
    d = min(d, sdCapsule(p - thumbBaseR, vec3(0,0,0), thumbMidR - thumbBaseR, THUMB_THICKNESS));
    d = min(d, sdCapsule(p - thumbMidR,  vec3(0,0,0), thumbTipR - thumbMidR,  THUMB_THICKNESS * 0.85));

    // ── Legs / feet / heels / ass / dress ──────────────────────────────────
    float legSway = sin(pc.totalTime * 1.2 + jump * 4.0) * 0.08;

    vec3 thighL_pos = vec3(-0.18, 0.55 + jump * 0.05, 0.0);
    vec3 thighL = p - thighL_pos; thighL.xz *= rot2(legSway);
    float thighBase = sdCapsule(thighL, vec3(0,0.4,0), vec3(0,-LEG_LENGTH+0.3,0), THIGH_RADIUS);
    vec3 quadBulgeL = p - (thighL_pos + vec3(0.0,0.15,0.04)); quadBulgeL.xz *= rot2(legSway);
    float quadL = sdEllipsoid(quadBulgeL, vec3(THIGH_RADIUS+QUAD_BULGE,0.22,THIGH_RADIUS+0.02));
    d = min(d, min(thighBase, quadL));

    vec3 calfL_pos = vec3(-0.18, 0.55-LEG_LENGTH+jump*0.1, 0.0);
    vec3 calfL = p - calfL_pos; calfL.xz *= rot2(legSway*1.5);
    float calfBase = sdCapsule(calfL, vec3(0,0.3,0), vec3(0,-0.6,0), CALF_RADIUS);
    vec3 calfBulgeL = p - (calfL_pos + vec3(0.02,0.1,0.03)); calfBulgeL.xz *= rot2(legSway*1.5);
    float calfBulge = sdEllipsoid(calfBulgeL, vec3(CALF_RADIUS+0.025,0.18,CALF_RADIUS+0.015));
    d = min(d, min(calfBase, calfBulge));

    vec3 ankleL = p - vec3(-0.18, 0.55-LEG_LENGTH-0.55+jump*0.12, 0.0);
    d = min(d, sdCapsule(ankleL, vec3(0,0.1,0), vec3(0,-0.15,0), ANKLE_TAPER));

    vec3 thighR_pos = vec3(0.18, 0.55 + jump * 0.05, 0.0);
    vec3 thighR = p - thighR_pos; thighR.xz *= rot2(-legSway);
    float thighBaseR = sdCapsule(thighR, vec3(0,0.4,0), vec3(0,-LEG_LENGTH+0.3,0), THIGH_RADIUS);
    vec3 quadBulgeR = p - (thighR_pos + vec3(0.0,0.15,0.04)); quadBulgeR.xz *= rot2(-legSway);
    float quadR = sdEllipsoid(quadBulgeR, vec3(THIGH_RADIUS+QUAD_BULGE,0.22,THIGH_RADIUS+0.02));
    d = min(d, min(thighBaseR, quadR));

    vec3 calfR_pos = vec3(0.18, 0.55-LEG_LENGTH+jump*0.1, 0.0);
    vec3 calfR = p - calfR_pos; calfR.xz *= rot2(-legSway*1.5);
    float calfBaseR = sdCapsule(calfR, vec3(0,0.3,0), vec3(0,-0.6,0), CALF_RADIUS);
    vec3 calfBulgeR = p - (calfR_pos + vec3(-0.02,0.1,0.03)); calfBulgeR.xz *= rot2(-legSway*1.5);
    float calfBulgeR_val = sdEllipsoid(calfBulgeR, vec3(CALF_RADIUS+0.025,0.18,CALF_RADIUS+0.015));
    d = min(d, min(calfBaseR, calfBulgeR_val));

    vec3 ankleR = p - vec3(0.18, 0.55-LEG_LENGTH-0.55+jump*0.12, 0.0);
    d = min(d, sdCapsule(ankleR, vec3(0,0.1,0), vec3(0,-0.15,0), ANKLE_TAPER));

    vec3 footL = p - vec3(-0.18, 0.55-LEG_LENGTH-0.6+jump*0.15, 0.12);
    d = min(d, sdEllipsoid(footL, vec3(0.1,0.04,FOOT_LENGTH)));

    vec3 heelL = p - vec3(-0.18, 0.55-LEG_LENGTH-0.6+jump*0.15, -HEEL_HEIGHT*0.5);
    d = min(d, sdCapsule(heelL, vec3(0,0,0), vec3(0,-HEEL_HEIGHT,0), 0.06));

    vec3 footR = p - vec3(0.18, 0.55-LEG_LENGTH-0.6+jump*0.15, 0.12);
    d = min(d, sdEllipsoid(footR, vec3(0.1,0.04,FOOT_LENGTH)));

    vec3 heelR = p - vec3(0.18, 0.55-LEG_LENGTH-0.6+jump*0.15, -HEEL_HEIGHT*0.5);
    d = min(d, sdCapsule(heelR, vec3(0,0,0), vec3(0,-HEEL_HEIGHT,0), 0.06));

    vec3 assP = p - vec3(0.0, ASS_Y_POS + jump*0.08, ASS_Z_POS);
    d = min(d, sdSphere(assP - vec3(-ASS_CHEEK_SEP,0,0), ASS_CHEEK_RADIUS));
    d = min(d, sdSphere(assP - vec3( ASS_CHEEK_SEP,0,0), ASS_CHEEK_RADIUS));

    // Short dress – no waist cutoff
    vec3 dressP = p - vec3(0.0, 0.90 + jump*0.08 + breath*0.15, 0.0);
    float dressTaper = smoothstep(0.78, 1.15, p.y);
    dressP.xz *= mix(vec2(1.0), vec2(0.68,0.78), dressTaper);
    float dressBase = sdEllipsoid(dressP, vec3(0.46,0.42,0.38));
    d = min(d, dressBase);

    // ── Sombrero ─────────────────────────────────────────────────────────────
    vec3 hatCenter = vec3(0.0, HAT_Y_OFFSET + jump*0.12 + breath*0.08, HAIR_Z_OFFSET + 0.01);
    vec3 hatP = p - hatCenter;
    hatP.xz *= rot2(headTilt * HAT_TILT_FACTOR);

    float crown = sdCylinder(hatP, HAT_RADIUS_TOP, HAT_HEIGHT*0.6);
    float crease = sdTorus(hatP + vec3(0.0, 0.06, 0.0), vec2(HAT_RADIUS_TOP*0.92, HAT_CREASE_AMP));
    crown = max(crown, -crease);

    vec3 brimP = hatP + vec3(0.0, -HAT_HEIGHT*0.5 + HAT_BRIM_THICKNESS*0.5, 0.0);
    float brim = sdEllipsoid(brimP, vec3(HAT_RADIUS_TOP + HAT_BRIM_WIDTH*1.5, HAT_BRIM_THICKNESS, HAT_RADIUS_TOP + HAT_BRIM_WIDTH*1.5));

    float hatD = min(crown, brim);
    float wear = noise3(hatP * 20.0 + vec3(0.0, pc.totalTime*0.25, 0.0)) * HAT_WEAR_NOISE_AMP;
    hatD += wear * 0.7;

    d = min(d, hatD);

    // ── Long hair ──────────────────────────────────────────────────────────
    vec3 hairP = p - vec3(0.0, HAIR_BASE_Y + jump*0.2, HAIR_Z_OFFSET);
    hairP.xz *= rot2(headTilt * 1.0);
    hairP.y *= HAIR_COVER_HEAD_FACTOR * HAIR_LENGTH_FACTOR;
    float waveStrength = smoothstep(1.2, 3.0, p.y) * HAIR_WAVE_AMP * 1.3;
    hairP.x += sin(p.y * HAIR_WAVE_FREQ_Y + pc.totalTime * HAIR_WAVE_SPEED + p.z * 2.0) * waveStrength;
    hairP.z += cos(p.y * HAIR_WAVE_FREQ_Z + pc.totalTime * HAIR_WAVE_SPEED * 1.15 + p.x * 1.8) * waveStrength * 0.75;
    d = min(d, sdEllipsoid(hairP, vec3(HAIR_SCALE_X * HAIR_COVER_HEAD_FACTOR,
                                       HAIR_SCALE_Y * HAIR_LENGTH_FACTOR,
                                       HAIR_SCALE_Z)));

    return d * GLOBAL_SCALE;
}

// ── Normal ────────────────────────────────────────────────────────────────

vec3 getNormal(vec3 p) {
    vec2 e = vec2(0.0008, 0.0);
    vec3 n = normalize(vec3(
        map(p + e.xyy) - map(p - e.xyy),
        map(p + e.yxy) - map(p - e.yxy),
        map(p + e.yyx) - map(p - e.yyx)
    ));

    bool isHair = (p.y > 1.55 && length(p.xz) > 0.28);
    bool isHat  = (p.y > HAT_Y_OFFSET - 0.05 && map(p) < 0.01);

    if (isHair) {
        float micro = noise3(p * HAIR_STRAND_FREQ * 3.0 + vec3(0.0, pc.totalTime*0.8, 0.0)) * HAIR_MICRO_NOISE_AMP;
        n += micro * n; n = normalize(n);
    }
    else if (isHat) {
        float leatherN = noise3(p * 22.0 + vec3(pc.totalTime*0.4,0,0)) * 0.025;
        n += leatherN * n; n = normalize(n);
    }

    return n;
}

// ── Raymarch ──────────────────────────────────────────────────────────────

float rayMarch(vec3 ro, vec3 rd) {
    float t = 0.0;
    for (int i = 0; i < MAX_STEPS; i++) {
        vec3 p = ro + rd * t;
        float dist = map(p);
        t += dist;
        if (t > MAX_DIST || abs(dist) < SURF_DIST) break;
    }
    return t;
}

// ── Tonemap ───────────────────────────────────────────────────────────────

vec3 tonemap(vec3 c) {
    c = c / (c + 1.0);
    c = pow(c, vec3(1.0/2.2));
    c = clamp(c * 1.15 - 0.075, 0.0, 1.0);
    return c;
}

// ── Entry point ────────────────────────────────────────────────────────────

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim) * 2.0 - 1.0;
    uv.x *= float(dim.x) / float(dim.y);

    float camA = pc.totalTime * CAMERA_ORBIT_SPEED;
    vec3 ro = vec3(sin(camA)*CAMERA_ORBIT_DISTANCE, CAMERA_ORBIT_HEIGHT + sin(pc.totalTime*0.9)*0.06, cos(camA)*CAMERA_ORBIT_DISTANCE);
    vec3 ta = vec3(0.0, 1.5, 0.0);
    vec3 ww = normalize(ta - ro);
    vec3 uu = normalize(cross(ww, vec3(0,1,0)));
    vec3 vv = cross(uu, ww);
    vec3 rd = normalize(uv.x*uu + uv.y*vv + 1.58*ww);

    float t = rayMarch(ro, rd);

    vec3 col = vec3(0.06, 0.04, 0.14);
    float sky = 0.5 + 0.5*uv.y;
    col = mix(vec3(0.18, 0.12, 0.32), vec3(0.45, 0.32, 0.58), sky);
    col += vec3(1.0,0.92,0.85) * pow(1.0 - length(uv*vec2(1.3,0.9)), 5.0) * 0.45;

    if (t < MAX_DIST) {
        vec3 p = ro + rd * t;
        vec3 n = getNormal(p);

        vec3 light = normalize(vec3(1.2, 1.4, 1.1));
        float diff = max(0.0, dot(n, light));
        float rim   = pow(1.0 - max(0.0, dot(n, -rd)), 3.4);
        float backRim = pow(1.0 - max(0.0, dot(n, rd)), 4.2);

        vec3 albedo;

        bool isHair = (p.y > 1.55 && length(p.xz) > 0.28);
        bool isHat  = (p.y > HAT_Y_OFFSET - 0.05 && length(p - vec3(0,HAT_Y_OFFSET+jumpOffset()*0.12,HAIR_Z_OFFSET+0.01)) < 0.45);
        bool isLeg  = (p.y < 1.2 && p.y > 0.0);
        bool isHeel = (p.y < 0.3 && length(p.xz - vec2(p.x>0.?0.18:-0.18, 0.0)) < 0.15);
        bool isAss  = (p.y > ASS_Y_POS - ASS_CHEEK_RADIUS*1.5 && p.y < ASS_Y_POS + ASS_CHEEK_RADIUS*1.5 &&
                       length(p.xz) < ASS_CHEEK_SEP + ASS_CHEEK_RADIUS*1.2);

        if (isHat) {
            float tex = noise3(p * 18.0)*0.5 + noise3(p * 45.0)*0.5;
            float wear = noise3(p * 22.0 + vec3(0.0, pc.totalTime*0.3,0.0)) * HAT_WEAR_NOISE_AMP * 8.0;
            albedo = mix(LEATHER_BASE, LEATHER_BASE + LEATHER_TINT, tex * 0.7);
            albedo *= (0.85 + 0.15 * (1.0 - wear));
        }
        else if (isHair) {
            float strand = noise3(p * HAIR_STRAND_FREQ + vec3(0.0, pc.totalTime*0.6, 0.0)) * HAIR_STRAND_NOISE_AMP;
            albedo = SOLID_RED_HAIR * (0.78 + 0.22 * (1.0 - strand));
        }
        else if (isLeg) {
            albedo = STOCKING_WHITE * (0.95 + 0.05 * noise3(p * 20.0));
        }
        else if (isHeel) {
            albedo = RED_HEEL;
        }
        else if (isAss || (p.y > 0.9 && p.y < 1.4)) {
            float fabric = noise3(p * vec3(8.0,4.0,8.0)) * DRESS_TEXTURE_AMP;
            albedo = DRESS_COLOR * (0.85 + fabric);
        }
        else {
            float skinTex = noise3(p * 35.0) * SKIN_TEXTURE_AMP;
            albedo = SKIN_BASE * (0.92 + skinTex);
        }

        vec3 rel = p - vec3(0.0, 1.5, 0.0);

        float eyeLDist = length(vec3(p.x + 0.11, p.y - 1.72, p.z + 0.06));
        float eyeRDist = length(vec3(p.x - 0.11, p.y - 1.72, p.z + 0.06));
        if (eyeLDist < EYE_RADIUS || eyeRDist < EYE_RADIUS) {
            if (eyeLDist < IRIS_RADIUS || eyeRDist < IRIS_RADIUS) {
                albedo = IRIS_COLOR;
                if (eyeLDist < PUPIL_RADIUS || eyeRDist < PUPIL_RADIUS) albedo = PUPIL_COLOR;
            } else {
                albedo = EYE_WHITE;
            }
        }

        if (abs(p.y - 1.715) < 0.022 && length(rel.xz) < 0.16 && p.z > -0.05) {
            albedo = mix(albedo, EYELID_SHADOW, 0.45);
        }

        if (abs(p.x) < 0.045 && p.y > 1.58 && p.y < 1.70 && p.z > -0.02) {
            albedo = mix(albedo, NOSE_SHADOW, 0.25);
        }

        if (p.y < 1.46 && p.y > 1.40 && abs(p.x) < 0.09 && p.z > -0.02) {
            albedo = LIP_COLOR;
        }

        vec3 lighting = albedo * (0.25 + 0.9*diff);

        if (isHat) {
            lighting += RIM_COLOR * rim;
            lighting += albedo * backRim * 1.2;
            float spec = pow(max(0.0, dot(n, normalize(light - rd))), 18.0);
            lighting += vec3(0.9,0.7,0.6) * spec * LEATHER_SPECULAR * (1.0 - LEATHER_ROUGHNESS);
        } else {
            lighting += RIM_COLOR * rim * RIM_INTENSITY;
        }

        if (isHair) {
            lighting += SOLID_RED_HAIR * backRim * HAIR_BACK_RIM_BOOST;
            lighting *= mix(vec3(1.0), HAIR_RIM_RED_BOOST, rim * 0.85);
        }

        float sss = max(0.0, 0.6 - diff) * (albedo.r + albedo.g + albedo.b) / 3.0;
        lighting += SKIN_SUBSURFACE * sss * 1.8;

        vec3 h = normalize(light - rd);
        float specPower = isHair ? HAIR_ANISO_POWER : (isHat ? 18.0 : 32.0);
        float specMul   = isHair ? HAIR_SPECULAR : (isHat ? LEATHER_SPECULAR : 0.9);
        float spec      = pow(max(0.0, dot(n, h)), specPower);
        lighting += vec3(1.0) * spec * specMul * rim;

        if (isHair) {
            vec3 anisoT = normalize(cross(n, vec3(0,1,0)));
            float aniso = abs(dot(normalize(light - rd), anisoT));
            lighting += albedo * 0.45 * pow(aniso, HAIR_ANISO_POWER * 0.5) * HAIR_ANISO_HINT;
        }

        col = lighting;
    }

    float vig = 1.0 - dot(uv,uv)*VIGNETTE_STRENGTH;
    col *= vig * EXPOSURE_BOOST;

    col = tonemap(col);

    imageStore(outputImage, pix, vec4(col, 1.0));
}