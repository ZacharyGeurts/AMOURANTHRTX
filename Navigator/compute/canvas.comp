#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

#define PI          3.14159265358979323846
#define TAU         (2.0 * PI)
#define PHI         1.618033988749895
#define EPS         0.0001
#define NUM_ORBS    8192u               // 8k — change to 16384u or 32768u if you want more

// Fast hash
float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    return fract(2.0 * p * (p + 33.33));
}

// Soft glow
float glow(float d, float str) {
    return exp(-d * d * str);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(hdrImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim);
    uv = uv * 2.0 - 1.0;
    uv.x *= float(dim.x) / float(dim.y);

    float t = pc.totalTime * 0.4;

    vec3 col = vec3(0.004, 0.006, 0.012);  // deep void

    // Background — very faint nebula
    vec2 nuv = uv * 3.0 + vec2(t * 0.02, sin(t * 0.05) * 0.01);
    float neb = sin(nuv.x * 4.0 + t * 0.6) * 0.5 + 0.5;
    neb *= smoothstep(0.0, -0.8, uv.y) * 0.08;
    col += vec3(0.03, 0.08, 0.15) * neb;

    // Thousands of glowing orbs
    for (uint i = 0u; i < NUM_ORBS; ++i) {
        float fi = float(i);
        float seed = hash11(fi * 0.00013 + 0.001);

        // Base orbit radius & speed (larger i → farther & slower)
        float radius = 0.5 + 4.5 * seed;
        float speed  = 0.3 + 0.7 * (1.0 - seed);

        // Position — 3D spherical orbit with slow precession
        float theta = TAU * seed + t * speed;
        float phi   = 0.4 * TAU * seed + t * 0.08 * (seed - 0.5);
        vec3 orbPos = vec3(
            radius * sin(phi) * cos(theta),
            radius * cos(phi) * 0.6,
            radius * sin(phi) * sin(theta)
        );

        // Individual size & pulse phase
        float orbSize = 0.02 + 0.05 * seed;
        float phase = t * (3.0 + 6.0 * seed) + fi * PHI;

        // Distance to orb
        float d = length(uv - orbPos.xy * 1.2) - orbSize;

        // Color — smooth gradient across the swarm
        vec3 orbCol = mix(vec3(0.1, 0.6, 1.0), vec3(0.9, 0.2, 0.5), seed);

        // Intensity — pulse + distance falloff
        float intensity = glow(d, 25.0) * (0.6 + 0.4 * sin(phase));

        col += orbCol * intensity * 2.5;

        // Very faint trail (motion blur feel)
        vec2 trailUV = uv - orbPos.xy * 1.2;
        float trail = glow(length(trailUV), 60.0) * 0.15 * (0.5 + 0.5 * sin(phase + 2.0));
        col += orbCol * trail;
    }

    // Gentle vignette
    float vig = 1.0 - length(uv) * 0.6;
    col *= vig * 0.92 + 0.08;

    // Final HDR — keep it punchy but not blinding
    imageStore(hdrImage, pix, vec4(col * 1.8, 1.0));
}