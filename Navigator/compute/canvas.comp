#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float : enable  // If needed for precision

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;  // Matches your dispatch (width+15)/16, etc.

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;  // Storage image for read/write
layout(set = 0, binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 view;
    mat4 proj;
    vec4 cameraPos;
    vec4 prevCameraPos;
    double exposure;
    double genesisTime;
    uint randomSeed;
    uint maxDepth;
    uint frameCount;
    uint padding[1];
} camera;

layout(set = 0, binding = 2, std140) readonly buffer LivingWorldData {
    vec4 sunDirAndIntensity;
    vec4 skyDayTop;
    vec4 skyDayHorizon;
    vec4 skyNight;
    vec4 groundColorDay;
    vec4 groundColorNight;
    float dayNightFactor;
    float cloudDensity;
    float fogDensity;
    float temperature;
    uint frameSeed;
    uint padding[3];
} world;

layout(push_constant) uniform Push {
    float totalTime;
} push;

#define PI 3.1415926535897932384626433832795
#define EPS 0.001
#define INF 1e10

// RNG - PCG hash
uvec2 pcg2d(uvec2 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * 1664525u;
    v.y += v.x * 1664525u;
    v = v ^ (v >> 16u);
    v.x += v.y * 1664525u;
    v.y += v.x * 1664525u;
    v = v ^ (v >> 16u);
    return v;
}

float rand(inout uvec2 state) {
    state = pcg2d(state);
    return float(state.x) / float(0xffffffffu);
}

// Sky color
vec3 getSky(vec3 dir) {
    float sun = max(0.0, dot(dir, world.sunDirAndIntensity.xyz));
    sun = pow(sun, 32.0) * world.sunDirAndIntensity.w;

    vec3 daySky = mix(world.skyDayHorizon.xyz, world.skyDayTop.xyz, dir.y * 0.5 + 0.5);
    vec3 nightSky = world.skyNight.xyz;
    vec3 sky = mix(nightSky, daySky, world.dayNightFactor);

    return sky + vec3(1.0, 0.9, 0.8) * sun;
}

// Ground color
vec3 getGround(vec3 pos, vec3 dir) {
    vec3 dayGround = world.groundColorDay.xyz;
    vec3 nightGround = world.groundColorNight.xyz;
    vec3 ground = mix(nightGround, dayGround, world.dayNightFactor);

    return ground;
}

vec3 traceRay(vec3 ro, vec3 rd) {
    if (rd.y > 0.0) {
        return getSky(rd);
    } else {
        float t = -ro.y / rd.y;
        if (t > 0.0) {
            vec3 hitP = ro + rd * t;
            return getGround(hitP, rd);
        } else {
            return vec3(0.0);
        }
    }
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(hdrImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    uvec2 rngState = uvec2(coord) ^ camera.randomSeed ^ world.frameSeed ^ uvec2(push.totalTime * 1000.0);

    vec2 jitter = vec2(rand(rngState), rand(rngState)) - 0.5;
    vec2 uv = (vec2(coord) + jitter) / vec2(size);
    uv = uv * 2.0 - 1.0;
    uv.y = -uv.y;  // Vulkan clip space

    vec4 rayClip = vec4(uv, 1.0, 1.0);
    vec4 rayEye = camera.projInverse * rayClip;
    rayEye = vec4(rayEye.xy, -1.0, 0.0);
    vec3 rd = normalize((camera.viewInverse * rayEye).xyz);
    vec3 ro = camera.cameraPos.xyz;

    vec3 currentSample = traceRay(ro, rd);

    vec4 prev = (camera.frameCount == 0) ? vec4(0.0) : imageLoad(hdrImage, coord);
    vec4 accum = (prev * float(camera.frameCount) + vec4(currentSample, 1.0)) / float(camera.frameCount + 1);

    accum.rgb *= float(camera.exposure);

    // Simple tonemap
    accum.rgb = accum.rgb / (accum.rgb + vec3(1.0));

    imageStore(hdrImage, coord, accum);
}