#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// HDR output
layout(set = 0, binding = 0, rgba32f) uniform image2D hdrCanvas;

// Camera uniforms (now with inverses)
layout(set = 0, binding = 1) uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  viewInverse;     // Added
    mat4  projInverse;     // Added
    vec3  position;
    float near;
    float far;
    vec3  forward;
    float fovY;
} camera;

// World state
layout(set = 0, binding = 2, scalar) buffer restrict readonly LivingWorldBuffer {
    vec4  sunDirAndIntensity;
    vec4  windDirAndSpeed;
    float temperature;
    float humidity;
    float airPressure;
    float cloudDensity;
    uint  frameSeed;
    uint  padding;
} world;

// Push constant: total time
layout(push_constant) uniform PushConstants {
    float totalTime;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(hdrCanvas);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    float t = pc.totalTime;

    // ── Compute world-space ray direction ───────────────────────────────
    vec2 uv   = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc  = uv * 2.0 - 1.0;
    vec4 targ = camera.projInverse * vec4(ndc, -1.0, 1.0);
    targ     /= targ.w;
    vec3 rayDir = normalize((camera.viewInverse * targ).xyz);

    // ── Basic sky gradient (blue → warm horizon) ────────────────────────
    float upDot = max(0.0, rayDir.y);
    vec3 sky = mix(vec3(0.9, 0.6, 0.3), vec3(0.1, 0.4, 0.9), upDot);

    // ── Sun disk ────────────────────────────────────────────────────────
    vec3 sunDir = normalize(world.sunDirAndIntensity.xyz);
    float sunCos = dot(rayDir, sunDir);
    float sun = smoothstep(0.999, 1.0, sunCos) * 8.0;
    vec3 sunLight = vec3(1.0, 0.95, 0.8) * sun * world.sunDirAndIntensity.a;

    // ── Simple animated clouds using frameSeed noise ────────────────────
    uint n = world.frameSeed ^ (pixel.x * 1664525u + pixel.y * 1013904223u);
    n ^= n >> 16;
    n *= 0x85ebca6bu;
    n ^= n >> 13;
    n *= 0xc2b2ae35u;
    n ^= n >> 16;
    float noise = float(n) / 4294967295.0;

    float cloud = 0.0;
    cloud += smoothstep(0.45, 0.55, sin(t * 0.08 + uv.x * 6.0 + noise * 3.0));
    cloud += smoothstep(0.42, 0.58, sin(t * 0.12 + uv.y * 5.0 + noise * 2.5)) * 0.6;
    cloud = clamp(cloud * world.cloudDensity * 1.5, 0.0, 1.0);
    vec3 clouds = vec3(1.0) * cloud * 0.7;

    // ── Final composition ───────────────────────────────────────────────
    vec3 col = sky + sunLight + clouds * (1.0 - sun);

    // Subtle horizon glow
    col += vec3(0.8, 0.5, 0.3) * (1.0 - upDot) * 0.4;

    imageStore(hdrCanvas, pixel, vec4(col, 1.0));
}