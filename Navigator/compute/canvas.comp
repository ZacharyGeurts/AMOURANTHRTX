#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ────────────────────────────────────────────────────────────────
// HDR Canvas Output — binding 0
// ────────────────────────────────────────────────────────────────
layout(set = 0, binding = 0, rgba32f) uniform image2D hdrCanvas;

// ────────────────────────────────────────────────────────────────
// Camera Uniform Buffer — binding 1
// ────────────────────────────────────────────────────────────────
layout(set = 0, binding = 1) uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    vec3  position;
    float near;
    float far;
    vec3  forward;
    float fovY;
    // ... expand as needed
} camera;

// ────────────────────────────────────────────────────────────────
// Living World Buffer — binding 2, now readable + writable
// ────────────────────────────────────────────────────────────────
layout(set = 0, binding = 2, scalar) buffer restrict coherent LivingWorldBuffer
{
    vec4  sunDirAndIntensity;
    vec4  windDirAndSpeed;
    float temperature;
    float humidity;
    float airPressure;
    float cloudDensity;
    uint  frameSeed;
    uint  padding;
} world;

// ────────────────────────────────────────────────────────────────
// Push constant
// ────────────────────────────────────────────────────────────────
layout(push_constant) uniform PushConstants
{
    float totalTime;
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 canvasSize = imageSize(hdrCanvas);

    if (pixel.x >= canvasSize.x || pixel.y >= canvasSize.y) return;

    float t = pc.totalTime;

    // ── Day/night cycle (unchanged) ───────────────────────────────
    float dayPhase   = fract(t / 86400.0);
    float solarAngle = dayPhase * 6.283185307179586;

    float declination = 0.409 * sin( (t / 86400.0 - 81.0) * 0.0172 );

    float elevation = asin(sin(declination) * sin(0.0) +
                           cos(declination) * cos(0.0) * cos(solarAngle));
    float cosAz     = (sin(elevation) * sin(0.0) - sin(declination)) /
                      (cos(elevation) * cos(0.0));
    float azimuth   = cos(solarAngle) < 0 ? acos(cosAz) : -acos(cosAz);

    vec3 sunDir = normalize(vec3(
        cos(elevation) * sin(azimuth),
        sin(elevation),
        cos(elevation) * cos(azimuth)
    ));

    float sunHeight   = max(0.0, elevation);
    float intensity   = sunHeight * sunHeight * 1.6 + 0.18;
    intensity        *= (1.0 + 0.12 * sin(solarAngle * 12.0));

    world.sunDirAndIntensity = vec4(sunDir, clamp(intensity, 0.0, 1.8));

    // Wind, temp, humidity, pressure, clouds, seed (unchanged)
    float slow   = t * 0.00075;
    float medium = t * 0.0065;
    float fast   = t * 0.018;

    vec3 windBase = vec3(
        sin(slow * 1.4) * 0.65 + cos(medium * 2.3) * 0.35,
        0.0,
        cos(slow * 1.2) * 0.65 + sin(medium * 1.9) * 0.35
    );

    vec3 windGust = vec3(
        sin(fast + sin(t * 0.041)) * 0.4,
        0.0,
        cos(fast * 1.1 + cos(t * 0.037)) * 0.4
    );

    vec3 windDir = normalize(windBase + windGust * 0.6);
    float windSpeed = 4.5 + sin(t * 0.00095) * 5.0 + sin(t * 0.095) * 6.0;

    world.windDirAndSpeed = vec4(windDir, clamp(windSpeed, 0.0, 18.0));

    float diurnalTemp   = sin(solarAngle - 0.6) * 14.0;
    float seasonalDrift = sin((t / 86400.0 - 172.0) * 0.0172) * 8.0;
    world.temperature = 17.0 + diurnalTemp + seasonalDrift;

    float baseHumid = 0.48 + (1.0 - abs(diurnalTemp / 14.0)) * 0.42;
    float rainPulse = fract(sin(t * 0.000142) * 43758.5453 + 12.9898);
    float rainMod   = (rainPulse > 0.92) ? (rainPulse - 0.92) * 12.5 : 0.0;
    world.humidity = clamp(baseHumid + rainMod * 0.55 - 0.15, 0.05, 0.98);

    world.airPressure  = 1013.0 + sin(t * 0.000195) * 18.0 +
                                 cos(t * 0.00115) * 4.5;

    world.cloudDensity = 0.28 + sin(t * 0.000084) * 0.22 +
                               sin(t * 0.00051 + 3.7) * 0.31 +
                               (rainPulse > 0.88 ? 0.4 : 0.0);

    uint seed = uint(t * 98765.4321);
    seed = seed * 1664525u + 1013904223u;
    world.frameSeed = seed;

    // ── Simple test output with noise using frameSeed (now readable) ─────
    vec2 uv = vec2(pixel) / vec2(canvasSize);
    vec3 col = vec3(1.0, 0.0, 1.0); // Hardcoded bright pink for debug

    imageStore(hdrCanvas, pixel, vec4(col, 1.0));
}