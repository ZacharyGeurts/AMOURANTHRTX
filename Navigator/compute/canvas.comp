#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

#define PI          3.14159265358979323846
#define TAU         (2.0 * PI)
#define PHI         1.618033988749895
#define EPS         0.0001
#define TRAIL_LENGTH      0.52

// ────────────────────────────────────────────────
// Tune these three values depending on your target resolution & GPU
#define NUM_ORBS          1024u
#define GLOW_STRENGTH     38.0        // higher = sharper / smaller glow radius
#define TRAIL_STRENGTH    110.0       // higher = narrower trails
// ────────────────────────────────────────────────

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    return fract(2.0 * p * (p + 33.33));
}

float softGlow(float d, float strength) {
    d = max(0.0, d);
    return exp2(-d * d * strength);     // slightly sharper & faster than exp(-x)
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(hdrImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim);
    uv = uv * 2.0 - 1.0;
    uv.x *= float(dim.x) / float(dim.y);

    float t = pc.totalTime * 0.4;

    vec3 col = vec3(0.004, 0.006, 0.012);   // deep space black-blue

    // ─── Very faint animated nebula background ───────────────────────────────
    vec2 nuv = uv * 3.0 + vec2(t * 0.02, sin(t * 0.05) * 0.01);
    float neb = sin(nuv.x * 4.0 + t * 0.6) * 0.5 + 0.5;
    neb *= smoothstep(0.0, -0.8, uv.y) * 0.08;
    col += vec3(0.03, 0.08, 0.15) * neb;

    // ─── Early out: skip orb loop if pixel is way outside possible influence ──
    const float maxInfluence = 5.2;   // covers largest orb radius + glow + trail
    if (length(uv) > maxInfluence) {
        imageStore(hdrImage, pix, vec4(col * 1.8, 1.0));
        return;
    }

    // ─── Main glowing orbs loop ──────────────────────────────────────────────
    for (uint i = 0u; i < NUM_ORBS; ++i) {
        float fi = float(i);
        float seed = hash11(fi * 0.00013 + 0.001);

        // ─── IMPROVED ANIMATION ──────────────────────────────────────────────
        // Faster base speed + stronger variation + gentle spiral twist
        float radiusBase   = 0.5 + 4.5 * seed;
        float angularSpeed = 0.6 + 1.2 * (1.0 - seed);           // noticeably faster orbits
        float spiral       = 0.18 * sin(t * 0.25 + seed * TAU);  // gentle inward/outward breathing spiral

        float theta = TAU * seed + t * angularSpeed + spiral * 1.2;
        float phi   = 0.4 * TAU * seed + t * 0.12 * (seed - 0.5) + spiral * 0.8;

        vec3 orbPos = vec3(
            radiusBase * sin(phi) * cos(theta),
            radiusBase * cos(phi) * 0.6,
            radiusBase * sin(phi) * sin(theta)
        );

        float orbSizeBase = 0.02 + 0.05 * seed;
        float pulsePhase  = t * (4.5 + 9.0 * seed) + fi * PHI;   // faster, more lively pulsing
        float sizeOsc     = 0.12 * sin(pulsePhase * 1.6);        // size breathing → less static/melty

        float orbRadius = orbSizeBase * (1.0 + sizeOsc);

        // Project to screen space
        vec2 orbScreen = orbPos.xy * 1.2;

        // Core orb distance
        float d = length(uv - orbScreen) - orbRadius;

        // Color gradient across the swarm
        vec3 orbCol = mix(
            vec3(0.10, 0.60, 1.00),
            vec3(0.90, 0.20, 0.50),
            seed
        );

        // Soft core glow + pulsing (same strength as original)
        float intensity = softGlow(d * 1.4, GLOW_STRENGTH)
                        * (0.55 + 0.45 * sin(pulsePhase));

        col += orbCol * intensity * 2.8;

        // ─── Improved trail: follows actual motion direction ─────────────────
        vec2 motionDir  = vec2(cos(theta), sin(theta));   // approximate velocity direction
        vec2 trailUV    = uv - orbScreen;
        float trailProj = dot(trailUV, motionDir);
        float trailDist = length(trailUV - trailProj * motionDir);

        float trail = softGlow(trailDist * 1.8 + trailProj * 0.3, TRAIL_STRENGTH)
                    * 0.12
                    * (0.5 + 0.5 * sin(pulsePhase + 2.0))
                    * smoothstep(0.0, TRAIL_LENGTH, trailProj + 0.1);

        col += orbCol * trail;
    }

    // ─── Gentle vignette ─────────────────────────────────────────────────────
    float vig = 1.0 - length(uv) * 0.62;
    col *= vig * 0.92 + 0.08;

    // Final output — mild HDR scaling
    imageStore(hdrImage, pix, vec4(col * 1.8, 1.0));
}