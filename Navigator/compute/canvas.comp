#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

layout(push_constant) uniform PushConstants {
    float       time;
    uint        frameSeed;

    vec3        cameraPos;
    float       pad0;

    vec4        cameraQuat;
    float       cameraFovDeg;
    float       aspectRatio;
    float       exposure;

    vec3        sunDir;
    float       sunIntensity;

    vec3        moonDir;
    float       moonIntensity;

    vec3        windDir;
    float       windStrength;

    float       temperatureC;
    float       humidity;
    float       airPressureKPa;
    float       precipitationFactor;

    float       fogDensity;
    float       dayNightFactor;
    float       cloudCoverage;
    uint        debugFlags;

    float       pad1[3];
} pc;

// ────────────────────────────────────────────────
// Helpers
// ────────────────────────────────────────────────
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031,0.1030,0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f*f*(3.0-2.0*f);
    float a = hash12(i + vec2(0.0,0.0));
    float b = hash12(i + vec2(1.0,0.0));
    float c = hash12(i + vec2(0.0,1.0));
    float d = hash12(i + vec2(1.0,1.0));
    return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
}

// ────────────────────────────────────────────────
// Sky
// ────────────────────────────────────────────────
vec3 sampleSky(vec3 dir) {
    float y = max(0.0, dir.y);
    float day = pc.dayNightFactor;

    vec3 sky = mix(
        mix(vec3(0.15, 0.25, 0.50), vec3(0.02, 0.05, 0.15), 1.0 - y),
        mix(vec3(0.50, 0.75, 1.00), vec3(0.70, 0.85, 1.00), 1.0 - y),
        day
    );

    float sun = smoothstep(0.998, 0.9998, dot(dir, normalize(pc.sunDir)));
    sky += vec3(1.4, 1.1, 0.8) * sun * pc.sunIntensity * 60.0 * day;

    return sky;
}

// ────────────────────────────────────────────────
// Seamless procedural grass texture
// ────────────────────────────────────────────────
vec3 grassTexture(vec2 uv) {
    float n = noise(uv * 2.0) * 0.5 + noise(uv * 5.0) * 0.3 + noise(uv * 12.0) * 0.2;
    vec3 dark = vec3(0.15, 0.35, 0.08);
    vec3 light = vec3(0.25, 0.55, 0.12);
    return mix(dark, light, n);
}

// ────────────────────────────────────────────────
// Sample ground with material tint
// ────────────────────────────────────────────────
vec3 sampleGround(vec3 hit) {
    // Use RoughConcrete from materials.hpp as base
    vec3 baseColor = vec3(0.45, 0.45, 0.42);  // RoughConcrete.baseColor.rgb
    float roughness = 0.88;  // RoughConcrete.roughness
    float specular = 0.22;  // RoughConcrete.specular

    // Apply grass texture tint
    vec3 tex = grassTexture(hit.xz) * baseColor;

    vec3 normal = vec3(0,1,0);

    float sun = max(0.0, dot(normal, pc.sunDir)) * pc.sunIntensity * 1.4;
    float amb = 0.20 + 0.40 * pc.dayNightFactor;

    vec3 color = tex * (sun + amb);

    // Specular highlight (simple)
    vec3 view = normalize(pc.cameraPos - hit);
    vec3 halfV = normalize(pc.sunDir + view);
    float spec = pow(max(0.0, dot(normal, halfV)), (1.0 - roughness) * 128.0) * specular;
    color += vec3(1.0) * spec * pc.sunIntensity * pc.dayNightFactor;

    // Wetness
    float wet = pc.humidity * pc.precipitationFactor * 1.2;
    color = mix(color, vec3(0.18, 0.26, 0.34), wet * 0.5);

    // Fog
    float dist = length(hit - pc.cameraPos);
    float fog = 1.0 - exp(-dist * pc.fogDensity * 0.0004);
    vec3 fogC = mix(vec3(0.72, 0.82, 0.96), vec3(0.42, 0.50, 0.68), pc.dayNightFactor * 0.35);
    color = mix(color, fogC, fog);

    return color;
}

// ────────────────────────────────────────────────
// Main — your working version as base
// ────────────────────────────────────────────────
void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim) * 2.0 - 1.0;
    uv.x *= pc.aspectRatio;

    float fov = 60.0;
    float tanHalf = tan(radians(fov) * 0.5);
    vec3 rayDir = normalize(vec3(uv.x * tanHalf, uv.y * tanHalf - 0.15, 1.0));

    vec3 ro = vec3(0.0, 5.0, 0.0);

    vec3 color = sampleSky(rayDir);

    float t = -ro.y / rayDir.y;
    if (rayDir.y < 0.0 && t > 0.001) {
        vec3 hit = ro + rayDir * t;
        color = sampleGround(hit);
    }

    color *= 1.5;

    imageStore(outputImage, pix, vec4(color, 1.0));
}