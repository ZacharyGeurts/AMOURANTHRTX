#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// HDR output
layout(set = 0, binding = 0, rgba32f) uniform image2D hdrCanvas;

// Camera uniforms (with inverses)
layout(set = 0, binding = 1) uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  viewInverse;
    mat4  projInverse;
    vec3  position;
    float near;
    float far;
    vec3  forward;
    float fovY;
} camera;

// Living world state
layout(set = 0, binding = 2, scalar) buffer restrict readonly LivingWorldBuffer {
    vec4  sunDirAndIntensity;     // .xyz = direction, .w = intensity (0..1+)
    vec4  windDirAndSpeed;
    float temperature;
    float humidity;
    float airPressure;
    float cloudDensity;
    uint  frameSeed;
    uint  padding;
} world;

// Push constant: total engine time in seconds
layout(push_constant) uniform PushConstants {
    float totalTime;
} pc;

// ─────────────────────────────────────────────────────────────────────────────
// Constants
// ─────────────────────────────────────────────────────────────────────────────
const float PI          = 3.14159265359;
const float DAY_LENGTH  = 1200.0;       // 20 minutes full cycle (1200 seconds)
const vec3  NIGHT_SKY   = vec3(0.01, 0.02, 0.08);
const vec3  SUN_COLOR   = vec3(1.0, 0.95, 0.85);
const vec3  MOON_COLOR  = vec3(0.9, 0.95, 1.0);
const float GROUND_Y    = -0.5;         // world-space ground plane height

// Simple hash for noise (used for clouds & stars)
float hash(vec2 p) {
    p = fract(p * vec2(123.456, 789.101));
    p += dot(p, p + 45.67);
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(hdrCanvas);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    float t = pc.totalTime;

    // ── Normalized day time ────────────────────────────────────────────────
    float dayFrac   = mod(t, DAY_LENGTH) / DAY_LENGTH;          // 0..1 over one day
    float sunAngle  = dayFrac * 2.0 * PI - PI * 0.5;            // sunrise at bottom
    vec3 sunDir     = normalize(vec3(cos(sunAngle), sin(sunAngle), 0.4 * sin(sunAngle * 2.0)));

    // Night → day → night transition helpers
    float sunHeight = sunDir.y;
    float dayFactor = smoothstep(-0.1, 0.3, sunHeight);         // 0 at night, 1 at day
    float nightFactor = smoothstep(0.0, -0.15, sunHeight);      // 0 at day, 1 at deep night

    // ── Compute ray direction from camera ──────────────────────────────────
    vec2 uv   = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc  = uv * 2.0 - 1.0;
    vec4 targ = camera.projInverse * vec4(ndc, -1.0, 1.0);
    targ     /= targ.w;
    vec3 rayDir = normalize((camera.viewInverse * targ).xyz);

    // ── Sky color base ─────────────────────────────────────────────────────
    float upDot = max(0.0, rayDir.y);
    vec3 skyDay   = mix(vec3(0.6, 0.8, 1.0), vec3(0.1, 0.4, 0.9), upDot);
    vec3 skyNight = mix(NIGHT_SKY, vec3(0.05, 0.1, 0.2), upDot * upDot);
    vec3 sky      = mix(skyNight, skyDay, dayFactor);

    // ── Sun / sunset glow ──────────────────────────────────────────────────
    float sunCos   = dot(rayDir, sunDir);
    float sunDisk  = smoothstep(0.9995, 1.0, sunCos) * 15.0 * dayFactor;
    float sunHalo  = pow(max(0.0, sunCos), 32.0) * 4.0 * dayFactor;

    vec3 sunContrib = SUN_COLOR * (sunDisk + sunHalo) * world.sunDirAndIntensity.w;

    // Sunset / sunrise warm rim
    float horizonGlow = smoothstep(0.0, 0.15, 1.0 - abs(rayDir.y)) * (1.0 - dayFactor);
    vec3 sunset = vec3(1.0, 0.6, 0.3) * horizonGlow * 2.5;

    // ── Moon at night ──────────────────────────────────────────────────────
    vec3 moonDir = -sunDir;  // opposite to sun
    float moonCos = dot(rayDir, moonDir);
    float moon = smoothstep(0.998, 1.0, moonCos) * 2.0 * nightFactor;
    vec3 moonContrib = MOON_COLOR * moon * 0.6;

    // ── Simple animated clouds ─────────────────────────────────────────────
    float cloud = 0.0;
    vec2 cloudUV = uv * 5.0 + vec2(t * 0.02, t * 0.015) + world.windDirAndSpeed.xy * t * 0.005;
    cloud += smoothstep(0.45, 0.55, sin(cloudUV.x * 6.0 + hash(uv * 10.0) * 3.0));
    cloud += smoothstep(0.42, 0.58, sin(cloudUV.y * 5.0 + hash(uv * 15.0) * 2.5)) * 0.6;
    cloud = clamp(cloud * world.cloudDensity * 1.8, 0.0, 1.0);
    vec3 clouds = vec3(1.0) * cloud * mix(0.7, 1.2, dayFactor);

    // ── Ground plane intersection (simple fog + ground color) ──────────────
    float groundHit = (GROUND_Y - camera.position.y) / rayDir.y;
    vec3 groundColor = vec3(0.18, 0.35, 0.12); // dark green grass
    if (groundHit > 0.0 && rayDir.y < 0.0) {
        vec3 hitPos = camera.position + rayDir * groundHit;
        float distFade = exp(-groundHit * 0.0008); // fog
        groundColor *= mix(vec3(0.4), vec3(1.0), dayFactor); // brighter in day
        sky = mix(sky, groundColor, distFade * (1.0 - upDot));
    }

    // ── Final composition ──────────────────────────────────────────────────
    vec3 col = sky + sunContrib + sunset + moonContrib + clouds;

    // Night sky subtle stars
    if (nightFactor > 0.6) {
        vec2 starUV = rayDir.xz * 50.0;
        float stars = step(0.98, hash(starUV + floor(starUV * 0.3))) * nightFactor * 0.4;
        col += vec3(stars);
    }

    // Very subtle ambient from world temperature/humidity
    col *= mix(1.0, 1.15, world.temperature * 0.01);

    imageStore(hdrCanvas, pixel, vec4(col, 1.0));
}