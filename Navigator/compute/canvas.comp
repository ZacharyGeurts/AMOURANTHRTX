#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// HDR output
layout(set = 0, binding = 0, rgba32f) uniform image2D hdrCanvas;

// Camera uniforms
layout(set = 0, binding = 1) uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  viewInverse;
    mat4  projInverse;
    vec3  position;
    float near;
    float far;
    vec3  forward;
    float fovY;
} camera;

// Living world
layout(set = 0, binding = 2, scalar) buffer restrict readonly LivingWorldBuffer {
    vec4  sunDirAndIntensity;     // .xyz = direction, .w = intensity
    vec4  windDirAndSpeed;
    float temperature;
    float humidity;
    float airPressure;
    float cloudDensity;
    float fogDensity;             // ← added to match host
    uint  frameSeed;
    uint  padding[2];
} world;

// Push constant: total time
layout(push_constant) uniform PushConstants {
    float totalTime;
} pc;

// Constants
const float PI          = 3.14159265359;
const float DAY_LENGTH  = 1200.0;
const vec3  NIGHT_SKY   = vec3(0.005, 0.01, 0.04);
const vec3  SUN_COLOR   = vec3(1.0, 0.96, 0.88);
const float GROUND_Y    = -0.5;
const float EXPOSURE    = 0.1;

// Hash noise
float hash(vec2 p) {
    p = fract(p * vec2(123.456, 789.101));
    p += dot(p, p + 45.67);
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(hdrCanvas);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    float t = pc.totalTime;

    // Day/night
    float dayFrac   = mod(t, DAY_LENGTH) / DAY_LENGTH;
    float sunAngle  = dayFrac * 2.0 * PI - PI * 0.5;
    vec3 sunDir     = normalize(vec3(cos(sunAngle), sin(sunAngle)*0.8 + 0.2, sin(sunAngle*1.5)*0.3));

    float sunHeight = max(0.0, sunDir.y);
    float dayFactor = smoothstep(0.0, 0.4, sunHeight);

    // Ray direction
    vec2 uv   = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc  = uv * 2.0 - 1.0;
    vec4 targ = camera.projInverse * vec4(ndc, -1.0, 1.0);
    targ     /= targ.w;
    vec3 rayDir = normalize((camera.viewInverse * targ).xyz);

    float upDot = max(0.0, rayDir.y);

    // Sky
    vec3 skyDay = mix(vec3(0.6, 0.85, 1.0), vec3(0.2, 0.5, 0.95), upDot);
    vec3 sky    = mix(NIGHT_SKY, skyDay, dayFactor);

    // Sun
    float sunCos  = dot(rayDir, sunDir);
    float sunDisk = smoothstep(0.997, 1.0, sunCos) * 30.0 * dayFactor;
    float sunHalo = pow(max(0.0, sunCos), 64.0) * 6.0 * dayFactor;
    vec3 sunContrib = SUN_COLOR * (sunDisk + sunHalo) * world.sunDirAndIntensity.w * 2.0;

    // Horizon glow
    float horizon = smoothstep(0.0, 0.2, 1.0 - abs(rayDir.y));
    vec3 sunset = vec3(1.0, 0.5, 0.2) * horizon * 3.0 * (1.0 - dayFactor);

    // Clouds
    vec2 cloudUV = uv * 4.0 + vec2(t * 0.015, t * 0.01) + world.windDirAndSpeed.xy * t * 0.008;
    float cloud  = 0.0;
    cloud += smoothstep(0.4, 0.6, sin(cloudUV.x * 8.0 + hash(uv * 12.0) * 4.0));
    cloud += smoothstep(0.38, 0.62, sin(cloudUV.y * 6.0 + hash(uv * 18.0) * 3.0)) * 0.7;
    cloud = clamp(cloud * world.cloudDensity * 2.0, 0.0, 1.0);
    vec3 clouds = vec3(1.0) * cloud * mix(0.8, 1.3, dayFactor);

    // Composition
    vec3 col = sky + sunContrib + sunset + clouds;

    // Ground plane + fog
    float groundHit = (GROUND_Y - camera.position.y) / rayDir.y;
    if (groundHit > 0.0 && rayDir.y < 0.0) {
        float dist = groundHit;
        float fog = exp(-dist * world.fogDensity * 0.8);
        vec3 ground = mix(vec3(0.08, 0.12, 0.06), vec3(0.25, 0.45, 0.15), dayFactor);
        col = mix(col, ground, (1.0 - fog) * 0.7);
    }

    // Exposure + simple tonemap
    col *= EXPOSURE;
    col = col / (col + 1.0);

    imageStore(hdrCanvas, pixel, vec4(col, 1.0));
}