#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// HDR output
layout(set = 0, binding = 0, rgba32f) uniform image2D hdrCanvas;

// Camera uniforms
layout(set = 0, binding = 1) uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  viewInverse;
    mat4  projInverse;
    vec3  position;
    float near;
    float far;
    vec3  forward;
    float fovY;
} camera;

// Living world
layout(set = 0, binding = 2, scalar) buffer restrict readonly LivingWorldBuffer {
    vec4  sunDirAndIntensity;     // .xyz = direction, .w = intensity
    vec4  windDirAndSpeed;
    float temperature;
    float humidity;
    float airPressure;
    float cloudDensity;
    float fogDensity;
    uint  frameSeed;
    uint  padding[2];
} world;

// Push constant: total time
layout(push_constant) uniform PushConstants {
    float totalTime;
} pc;

// Constants
const float PI          = 3.14159265359;
const float DAY_LENGTH  = 1200.0;
const vec3  NIGHT_SKY   = vec3(0.005, 0.01, 0.04);
const vec3  SUN_COLOR   = vec3(1.0, 0.96, 0.88);
const float GROUND_Y    = -0.5;
const float EXPOSURE    = 1.0;

// Better hash (2D → 1D)
float hash12(vec2 p) {
    vec3 p3  = fract(vec3(p.xyx) * .1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Fractional Brownian Motion (multi-octave noise) — no more ugly tiling
float fbm(vec2 uv, float time) {
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    vec2 shift = vec2(100.0);  // offset to avoid repetition

    for (int i = 0; i < 5; ++i) {  // 5 octaves
        float n = hash12(uv * frequency + shift + time * 0.1);
        value += amplitude * n;
        amplitude *= 0.5;
        frequency *= 2.0;
        shift = shift * 2.0 + vec2(17.7, 31.3);  // pseudo-random shift
    }
    return value;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(hdrCanvas);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    float t = pc.totalTime;

    // Day/night cycle
    float dayFrac   = mod(t, DAY_LENGTH) / DAY_LENGTH;
    float sunAngle  = dayFrac * 2.0 * PI - PI * 0.5;
    vec3 sunDir     = normalize(vec3(cos(sunAngle), sin(sunAngle)*0.8 + 0.2, sin(sunAngle*1.5)*0.3));

    float sunHeight = max(0.0, sunDir.y);
    float dayFactor = smoothstep(0.0, 0.4, sunHeight);

    // Ray direction
    vec2 uv   = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc  = uv * 2.0 - 1.0;
    vec4 targ = camera.projInverse * vec4(ndc, -1.0, 1.0);
    targ     /= targ.w;
    vec3 rayDir = normalize((camera.viewInverse * targ).xyz);

    float upDot = max(0.0, rayDir.y);

    // Sky gradient (day)
    vec3 skyDay = mix(vec3(0.6, 0.85, 1.0), vec3(0.2, 0.5, 0.95), upDot);
    vec3 sky    = mix(NIGHT_SKY, skyDay, dayFactor);

    // Sun disk + halo (brighter, more visible)
    float sunCos  = dot(rayDir, sunDir);
    float sunDisk = smoothstep(0.997, 1.0, sunCos) * 40.0 * dayFactor;
    float sunHalo = pow(max(0.0, sunCos), 32.0) * 8.0 * dayFactor;
    vec3 sunContrib = SUN_COLOR * (sunDisk + sunHalo) * world.sunDirAndIntensity.w * 2.5;

    // Horizon glow (sunset/sunrise)
    float horizon = smoothstep(0.0, 0.18, 1.0 - abs(rayDir.y));
    vec3 sunset = vec3(1.0, 0.55, 0.25) * horizon * 4.0 * (1.0 - dayFactor);

    // Improved clouds — layered FBM + wind + time evolution
    vec2 windOffset = world.windDirAndSpeed.xy * t * 0.02;
    vec2 cloudUV = (uv * 5.0 + windOffset) + hash12(uv) * 10.0;  // per-pixel variation

    float cloud = 0.0;
    cloud += fbm(cloudUV + vec2(t * 0.015), t * 0.03) * 0.6;
    cloud += fbm(cloudUV * 2.0 + vec2(t * 0.025), t * 0.05) * 0.3;
    cloud += fbm(cloudUV * 4.0 + vec2(t * 0.04), t * 0.08) * 0.1;
    cloud = smoothstep(0.35, 0.65, cloud);
    cloud = clamp(cloud * world.cloudDensity * 2.5, 0.0, 1.0);

    vec3 clouds = vec3(1.0) * cloud * mix(0.75, 1.4, dayFactor);

    // Composition
    vec3 col = sky + sunContrib + sunset + clouds;

    // Ground plane + fog
    float groundHit = (GROUND_Y - camera.position.y) / rayDir.y;
    if (groundHit > 0.0 && rayDir.y < 0.0) {
        float dist = groundHit;
        float fog = exp(-dist * world.fogDensity * 1.2);
        vec3 ground = mix(vec3(0.08, 0.12, 0.06), vec3(0.25, 0.45, 0.15), dayFactor);
        col = mix(col, ground, (1.0 - fog) * 0.8);
    }

    // Final exposure + tonemap (Reinhard — prevents blowout)
    col *= EXPOSURE;
    col = col / (col + 1.0);

    imageStore(hdrCanvas, pixel, vec4(col, 1.0));
}