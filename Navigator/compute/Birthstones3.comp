#version 460
#extension GL_EXT_scalar_block_layout : enable

// =============================================================================
// Birthstone Showcase 2026 – Realistic version with flying orb lights
// Polished dark granite/marble countertop floor + subtle reflectivity
// 1–3 selectable flying glowing orbs with different motion styles
// Pure physically plausible shading – no fake bloom/glow post effects
// =============================================================================

layout(push_constant) uniform Push {
    float time;     // seconds
} pc;

// ─── Scene config ───────────────────────────────────────────────────────────
#define COLS 4
#define ROWS 3

// === Choose number of orbs (1–3) and flying style here =======================
#define NUM_ORBS  1             // ← change to 1, 2 or 3
#define ORB_STYLE 1             // 0 = slow hypnotic float, 1 = lazy orbit, 2 = gentle random wander

const float GEM_BASE_SCALE   = 0.33;
const float ROT_SPEED_Y      = 0.018;       // very slow & natural
const float ROT_SPEED_X      = 0.008;
const float X_TILT_AMP       = 0.10;

const vec3  KEY_LIGHT_DIR    = normalize(vec3(0.72, 0.84, 1.22));
const vec3  AMBIENT          = vec3(0.055, 0.060, 0.085);

// ─── Flying orb lights ──────────────────────────────────────────────────────
struct Orb {
    vec3  pos;
    vec3  color;
    float radius;
    float intensity;
};

Orb getOrb(int i) {
    Orb o;
    float t = pc.time * 0.4;    // base time scale – adjust for faster/slower motion

    if (i == 0) {
        // Style 0 – slow hypnotic vertical bobbing + small circle
        vec2 circle = 0.28 * vec2(sin(t*0.9), cos(t*0.9));
        o.pos = vec3(-0.65 + circle.x, 0.85 + 0.24 * sin(t*1.7 + 2.1), 0.35 + circle.y * 0.7);
        o.color = vec3(1.00, 0.74, 0.51);
    } else if (i == 1) {
        // Style 1 – lazy wide orbit around scene center
        float a = t * 0.6 + 3.14;
        o.pos = vec3(0.70 * cos(a), 1.10 + 0.18 * sin(t*1.1 + 4.2), 0.70 * sin(a));
        o.color = vec3(0.62, 0.88, 1.00);
    } else { // i==2
        // Style 2 – gentle 3D wandering (Perlin-like)
        vec3 seed = vec3(17.3*i, 42.1*i, 81.4*i);
        vec3 drift = 0.16 * vec3(
            sin(t*0.48 + seed.x) + 0.6*sin(t*1.13 + seed.y*1.4),
            0.7 + 0.3*sin(t*0.77 + seed.z) + 0.4*cos(t*0.92 + seed.x*2.3),
            sin(t*0.61 + seed.y) + 0.5*cos(t*1.44 + seed.z*1.7)
        );
        o.pos = vec3(0.0, 0.95, -0.1) + drift;
        o.color = vec3(0.98, 0.58, 1.00);
    }

    o.radius    = 0.085 * float(i);     // slightly different sizes
    o.intensity = 1.2 * float(i);
    return o;
}

// ─── Stone properties ───────────────────────────────────────────────────────
struct Stone {
    vec3  tint;
    float ior;
    float subsurface;
    float brilliance;
};

Stone getStone(int month) {
    Stone s;
    if (month == 0) {   // 0  Garnet
        s.tint = vec3(0.84,0.07,0.04); s.ior=1.760; s.subsurface=0.06; s.brilliance=1.10;
    } else if (month == 1) { // 1  Amethyst
        s.tint = vec3(0.56,0.20,0.90); s.ior=1.545; s.subsurface=0.05; s.brilliance=0.94;
    } else if (month == 2) { // 2  Aquamarine
        s.tint = vec3(0.50,0.84,1.00)*0.88; s.ior=1.575; s.subsurface=0.04; s.brilliance=1.05;
    } else if (month == 3) { // 3  Diamond
        s.tint = vec3(1.035,1.035,1.055); s.ior=2.417; s.subsurface=0.00; s.brilliance=1.48;
    } else if (month == 4) { // 4  Emerald
        s.tint = vec3(0.05,0.64,0.16)*0.90; s.ior=1.575; s.subsurface=0.12; s.brilliance=0.76;
    } else if (month == 5) { // 5  Pearl
        s.tint = vec3(0.995,0.98,0.96); s.ior=1.53; s.subsurface=0.18; s.brilliance=0.50;
    } else if (month == 6) { // 6  Ruby
        s.tint = vec3(0.92,0.08,0.11); s.ior=1.77; s.subsurface=0.05; s.brilliance=1.20;
    } else if (month == 7) { // 7  Peridot
        s.tint = vec3(0.74,0.99,0.30); s.ior=1.67; s.subsurface=0.07; s.brilliance=1.04;
    } else if (month == 8) { // 8  Sapphire
        s.tint = vec3(0.07,0.16,0.84); s.ior=1.77; s.subsurface=0.04; s.brilliance=1.10;
    } else if (month == 9) { // 9  Opal
        s.tint = vec3(0.96,0.90,0.98); s.ior=1.45; s.subsurface=0.22; s.brilliance=0.70;
    } else if (month ==10) { //10  Topaz
        s.tint = vec3(1.00,0.70,0.16); s.ior=1.62; s.subsurface=0.06; s.brilliance=0.96;
    } else {                 //11  Turquoise
        s.tint = vec3(0.14,0.74,0.80); s.ior=1.61; s.subsurface=0.10; s.brilliance=0.60;
    }
    return s;
}

// ─── Gem SDF definitions (centered, symmetric) ──────────────────────────────
float sdf_jan_garnet(vec3 p) {
    vec2 q = abs(p.xy) - vec2(0.92, 0.92);
    float cush = length(max(q,0.0)) + min(max(q.x,q.y),0.0) - 0.18;
    return max(cush, abs(p.z) - 0.70);
}

float sdf_feb_amethyst(vec3 p) {
    vec2 shifted = p.xy; shifted.y = abs(shifted.y - 0.1);
    float r = length(shifted);
    float shape = r - 0.9 * (1.0 + 0.25 * p.y);
    return max(shape, abs(p.z) - 0.68);
}

float sdf_mar_aquamarine(vec3 p) {
    vec3 q = abs(p);
    float sq = max(q.x - 0.95, q.y - 0.95) - 0.02;
    return max(sq, abs(q.z) - 0.70);
}

float sdf_apr_diamond(vec3 p) {
    float r = length(p.xy);
    float crown = p.z - 0.405 + r * 0.32;
    float pav   = -p.z - 0.595 + r * 1.12;
    return max(r - 1.0, max(crown, pav));
}

float sdf_may_emerald(vec3 p) {
    vec3 q = abs(p);
    float table = p.z - 0.30;
    float step1 = max(max(q.x-1.55,q.y-0.96), q.z - 0.62);
    float step2 = max(max(q.x-1.42,q.y-0.83), q.z - 0.50);
    float depth = abs(q.z) - 0.68;
    return max(table, max(step1, max(step2, depth))) + 0.035;
}

float sdf_jun_pearl(vec3 p) {
    float dome = length(p) - 0.98;
    float base = abs(p.z) - 0.10;
    return max(dome, base) + 0.02 * abs(p.z);
}

float sdf_jul_ruby(vec3 p) {
    vec2 q = abs(p.xy) - vec2(0.92, 0.92);
    float cush = length(max(q,0.0)) + min(max(q.x,q.y),0.0) - 0.20;
    return max(cush, abs(p.z) - 0.74);
}

float sdf_aug_peridot(vec3 p) {
    float len = length(p.xy * vec2(1.6, 0.8));
    float shape = len - 1.0;
    return max(shape, abs(p.z) - 0.68);
}

float sdf_sep_sapphire(vec3 p) {
    vec3 q = p; q.x *= 1.30;
    float r = length(q.xy);
    float crown = q.z - 0.36 + r * 0.39;
    float pav   = -q.z - 0.64 + r * 0.92;
    return max(r - 1.0, max(crown, pav));
}

float sdf_oct_opal(vec3 p) {
    float dome = length(p) - 0.90;
    float base = abs(p.z) - 0.08;
    return max(dome, base);
}

float sdf_nov_topaz(vec3 p) {
    vec3 q = abs(p);
    float rect = max(q.x - 1.52, q.y - 0.94) - 0.08;
    return max(rect, abs(q.z) - 0.70);
}

float sdf_dec_turquoise(vec3 p) {
    float dome = length(p) - 0.94;
    float base = abs(p.z) - 0.09;
    return max(dome, base);
}

float gemSDF(vec3 p, int month) {
    float scale = 1.0 + 0.015 * length(p);
    if (month == 0) return sdf_jan_garnet(p)     * scale;
    if (month == 1) return sdf_feb_amethyst(p)   * scale;
    if (month == 2) return sdf_mar_aquamarine(p) * scale;
    if (month == 3) return sdf_apr_diamond(p)    * scale;
    if (month == 4) return sdf_may_emerald(p)    * scale;
    if (month == 5) return sdf_jun_pearl(p)      * scale;
    if (month == 6) return sdf_jul_ruby(p)       * scale;
    if (month == 7) return sdf_aug_peridot(p)    * scale;
    if (month == 8) return sdf_sep_sapphire(p)   * scale;
    if (month == 9) return sdf_oct_opal(p)       * scale;
    if (month ==10) return sdf_nov_topaz(p)      * scale;
    return sdf_dec_turquoise(p)                  * scale;
}

// ─── Polished dark granite/marble countertop ────────────────────────────────
vec3 polishedGranite(vec2 uv) {
    vec2 t = uv * vec2(1.9, 1.35);

    // Deep charcoal base
    vec3 col = vec3(0.014, 0.012, 0.018);

    // Slow drifting large-scale veins
    t += pc.time * vec2(0.005, 0.007);
    float veins = 0.5 + 0.5 * sin(t.x * 4.1 + sin(t.y * 3.2) * 1.8);
    veins += 0.25 * sin(t.x * 11.3 + t.y * 8.7 + 4.1);
    veins = smoothstep(0.36, 0.68, veins);

    vec3 veinCol = vec3(0.042, 0.036, 0.052);
    col = mix(col, veinCol, veins * 0.60);

    // Fine crystalline grain
    vec2 grainUv = t * 22.0;
    float grain = fract(sin(dot(grainUv, vec2(127.1, 311.7))) * 43758.5453);
    grain = smoothstep(0.44, 0.56, grain);
    col += (grain - 0.5) * 0.022;

    return col;
}

float graniteFresnel(vec3 N, vec3 V) {
    float NoV = max(0.0, dot(N, V));
    float F0 = 0.045;               // polished dark stone ~4–5%
    return F0 + (1.0 - F0) * pow(1.0 - NoV, 5.0);
}

// ─── Math helpers ───────────────────────────────────────────────────────────
mat3 rotY(float a) {
    float c=cos(a), s=sin(a);
    return mat3(c,0,s, 0,1,0, -s,0,c);
}

mat3 rotX(float a) {
    float c=cos(a), s=sin(a);
    return mat3(1,0,0, 0,c,-s, 0,s,c);
}

// ─── Compute shader entry ───────────────────────────────────────────────────
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = vec2(pix) / vec2(dim);

    // Floor color + subtle reflection prep
    vec3 color = polishedGranite(uv);

    // Very approximate floor normal (slightly bumpy)
    vec2 nUv = uv * 18.0;
    vec3 floorN = normalize(vec3(
        polishedGranite(uv + vec2(0.004,0)).r - polishedGranite(uv - vec2(0.004,0)).r,
        0.08,
        polishedGranite(uv + vec2(0,0.004)).r - polishedGranite(uv - vec2(0,0.004)).r
    ));
    vec3 viewDir = normalize(vec3(uv * 2.0 - 1.0, -1.8)); // rough perspective

    // Add subtle floor reflection (orb & key light)
    float floorFres = graniteFresnel(floorN, viewDir);
    vec3 refl = AMBIENT * 0.4;

    for (int i = 0; i < NUM_ORBS; ++i) {
        Orb o = getOrb(i);
        vec3 toOrb = o.pos - vec3(uv * 2.0 - 1.0, 0.0) * vec3(1.4, 1.4, 1.0);
        float dist = length(toOrb);
        float contrib = o.intensity / (dist * dist + 0.04);
        refl += o.color * contrib * 0.22;
    }
    refl += KEY_LIGHT_DIR.z * 0.12; // faint key light bounce

    color += refl * floorFres * 0.75;

    // ─── Gems ───────────────────────────────────────────────────────────────
    float cw = 1.0 / float(COLS);
    float ch = 1.0 / float(ROWS);

    int cx = int(uv.x / cw);
    int cy = int((1.0 - uv.y) / ch);

    if (cx >= 0 && cx < COLS && cy >= 0 && cy < ROWS) {
        int month = cy * COLS + cx;
        Stone s = getStone(month);

        vec2 cellUV = fract(uv / vec2(cw, ch)) - 0.5;
        float angY = pc.time * ROT_SPEED_Y + float(month) * 2.4;
        float angX = sin(pc.time * ROT_SPEED_X + float(month) * 1.3) * X_TILT_AMP;

        mat3 rot = rotY(angY) * rotX(angX);
        vec3 pos = rot * vec3(cellUV * 1.20, 0.0);

        float d = gemSDF(pos / GEM_BASE_SCALE, month);

        if (d < 0.018) {
            vec3 eps = vec3(0.005, 0.0, 0.005);
            vec3 nor = normalize(vec3(
                gemSDF((pos + eps.xyy)/GEM_BASE_SCALE, month) - gemSDF((pos - eps.xyy)/GEM_BASE_SCALE, month),
                gemSDF((pos + eps.yxy)/GEM_BASE_SCALE, month) - gemSDF((pos - eps.yxy)/GEM_BASE_SCALE, month),
                gemSDF((pos + eps.yyx)/GEM_BASE_SCALE, month) - gemSDF((pos - eps.yyx)/GEM_BASE_SCALE, month)
            ));

            mat3 invRot = transpose(rot);
            vec3 L = normalize(invRot * KEY_LIGHT_DIR);
            vec3 V = normalize(invRot * vec3(0,0,-1));

            float NoV = max(0.0, dot(nor, V));
            float NoL = max(0.0, dot(nor, L));

            float F0  = pow((1.0 - s.ior)/(1.0 + s.ior), 2.0);
            float fres = F0 + (1.0 - F0) * pow(1.0 - NoV, 5.0);

            vec3 diffuse = s.tint * (NoL * 0.18 + AMBIENT * 1.35);

            vec3 H = normalize(L + V);
            float NoH = max(0.0, dot(nor, H));
            float spec = pow(NoH, 140.0 + s.brilliance * 480.0) * fres * 2.4;

            float sss = s.subsurface * (0.5 + 0.5 * NoV) * 1.2;

            color += diffuse;
            color += vec3(spec) * 1.9;
            color += s.tint * sss * 0.45;

            // Add orb contribution to gems
            for (int i = 0; i < NUM_ORBS; ++i) {
                Orb o = getOrb(i);
                vec3 worldPos = rot * vec3(cellUV * 1.20, 0.0) * GEM_BASE_SCALE + vec3(cx - 1.5, 0.0, cy - 0.5) * 0.8;
                vec3 toOrb = o.pos - worldPos;
                float dist = length(toOrb);
                vec3 oL = normalize(toOrb);
                float oNoL = max(0.0, dot(nor, oL));
                float oAtten = o.intensity / (dist * dist + 0.06);
                color += s.tint * oNoL * oAtten * 0.45;
                float oFres = F0 + (1.0 - F0) * pow(1.0 - max(0.0, dot(nor, normalize(oL + V))), 5.0);
                color += vec3(1.0) * pow(max(0.0, dot(nor, normalize(oL + V))), 80.0) * oFres * oAtten * 1.1;
            }
        }
    }

    // Gentle tonemap – keeps it natural
    color = color / (1.0 + color);
    color = pow(color, vec3(0.92));

    imageStore(outputImage, pix, vec4(color, 1.0));
}