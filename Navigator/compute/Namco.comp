#version 460
#extension GL_EXT_scalar_block_layout : enable

// =============================================================================
// AMOURANTH RTX — Canvas Compute Shader
// Living World Edition — Pac-Man homage (classic mouth behavior)
// Power pellets floating, rough reflective materials, dim entity lighting only
// =============================================================================

// ─── Compile-time tuning ────────────────────────────────────────────────────
#define WORKGROUP_SIZE_X        16
#define WORKGROUP_SIZE_Y        16

#define ENTITY_SCALE            0.085
#define CHOMP_FREQ              0.55
#define CHOMP_PHASE_SPREAD      1.0
#define GHOST_WAVE_FREQ         12.0
#define GHOST_WAVE_AMP          0.08
#define AA_WIDTH                0.010
#define GLOW_WIDTH              0.015
#define DOT_PULSE_SPEED         1.0
#define DOT_PULSE_AMP           0.15
#define WALL_HEIGHT_GRAD        0.35
#define LIGHT_INTENSITY         0.25     // cut to 25%
#define SPEC_ROUGHNESS          0.4
#define SPEC_POWER              32.0

#define GHOST_TILT_MAX_DEG      18.0
#define GHOST_TILT_SMOOTH       8.0

#define PACMAN_ROT_OFFSET       -1.57079632679  // +90° = π/2 radians

// ─── Push constants ─────────────────────────────────────────────────────────
layout(push_constant) uniform PushConstants {
    float       time;
    uint        frameSeed;
    vec3        cameraPos;
    float       pad0;
    vec4        cameraQuat;
    float       cameraFovDeg;
    float       aspectRatio;
    float       exposure;
    vec3        sunDir;
    float       sunIntensity;
    vec3        moonDir;
    float       moonIntensity;
    vec3        windDir;
    float       windStrength;
    float       temperatureC;
    float       humidity;
    float       airPressureKPa;
    float       precipitationFactor;
    float       fogDensity;
    float       dayNightFactor;
    float       cloudCoverage;
    uint        debugFlags;
    int         samplesPerPixel;
    float       temporalBlend;
    int         maxRecursion;
    float       pad1[4];
} pc;

// ─── Layout ─────────────────────────────────────────────────────────────────
layout(local_size_x = WORKGROUP_SIZE_X, local_size_y = WORKGROUP_SIZE_Y, local_size_z = 1) in;
layout(rgba32f, set = 0, binding = 0) writeonly uniform image2D outputImage;

// ─── Helpers ────────────────────────────────────────────────────────────────
float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    return fract(2.0 * p * (p + 33.33));
}

vec2 hash22(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yxz + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}

mat2 rot2(float a) {
    float c = cos(a), s = sin(a);
    return mat2(c, -s, s, c);
}

float sdCircle(vec2 p, float r) { return length(p) - r; }

// ─── SDF shapes ─────────────────────────────────────────────────────────────
float sdPacMouth(vec2 p, float r, float openAngle) {
    float d = sdCircle(p, r);

    // Classic Pac-Man: symmetric open (top/bottom jaw each move openAngle/2)
    // openAngle = 0 → fully closed
    // openAngle = ~1.0–1.4 radians → wide open like original game
    float halfOpen = openAngle * 0.5;

    float a = atan(p.y, p.x);
    // Sector cut is symmetric around forward direction (after rotation)
    float sector = abs(mod(a + 3.14159265, 6.283185) - 3.14159265); // centered at 0
    float cut = (sector < halfOpen) ? 100.0 : -100.0;

    return max(d, cut);
}

float sdGhostBody(vec2 p, float waveTime) {
    float body = sdCircle(p, 1.0);
    vec2 skirt = p;
    skirt.x += GHOST_WAVE_AMP * sin(GHOST_WAVE_FREQ * skirt.y + waveTime);
    return min(body, sdCircle(skirt - vec2(0.0, -0.85), 0.92));
}

float sdPacCharacter(vec2 p, float mouthOpen) {
    vec2 q = p / ENTITY_SCALE;
    float body = sdPacMouth(q, 1.0, mouthOpen);
    return body * ENTITY_SCALE;
}

float sdGhostCharacter(vec2 p, float mouthOpen, float waveTime) {
    vec2 q = p / ENTITY_SCALE;
    float body = sdGhostBody(q, waveTime + mouthOpen * 2.0);
    return body * ENTITY_SCALE;
}

// ─── Maze ───────────────────────────────────────────────────────────────────
float sdMaze(vec2 p) {
    p *= 0.45;
    vec2 cell = floor(p + 0.5);
    vec2 frac = fract(p + 0.5) - 0.5;

    bool wall = false;
    if (abs(cell.x) > 13.0 || abs(cell.y) > 15.0) wall = true;
    if (abs(cell.y) == 0.0 && abs(cell.x) < 13.0) wall = false;
    if (abs(cell.y) == 7.0) wall = true;
    if (abs(cell.x) == 0.0 || abs(cell.x) == 6.0) wall = (abs(cell.y) > 3.0 && abs(cell.y) < 11.0);
    if (abs(cell.x) == 3.0 || abs(cell.x) == 9.0) wall = abs(cell.y) > 9.0;
    if (cell.y > 4.0 && cell.y < 8.0 && abs(cell.x) < 4.0) wall = true;

    if (!wall) return 100.0;

    return max(abs(frac.x), abs(frac.y)) - 0.48;
}

// ─── Dots ───────────────────────────────────────────────────────────────────
float sdDots(vec2 p) {
    vec2 mp = p * 0.45;
    vec2 grid = floor(mp * 12.0 + 0.5);
    vec2 fp   = fract(mp * 12.0 + 0.5) - 0.5;
    float d   = sdCircle(fp, 0.12);

    if (sdMaze(p) < 0.0) d = 100.0;

    float eat = sin(pc.time * DOT_PULSE_SPEED + hash11(grid.x + grid.y * 31.0) * 6.283185) * 0.5 + 0.5;
    d += eat * DOT_PULSE_AMP;

    return d * 0.08;
}

// ─── Power Pellet ───────────────────────────────────────────────────────────
float sdPowerPellet(vec2 p, vec2 center, float baseR) {
    vec2 lp = p - center;
    float pulse = 0.03 * sin(pc.time * 5.0 + length(lp) * 12.0);
    float r = baseR + pulse;
    return sdCircle(lp, r);
}

// Fake rough metallic specular
vec3 roughMetalSpec(vec3 normalDir, vec3 lightDir, vec3 viewDir, vec3 baseCol, float roughness) {
    vec3 halfDir = normalize(lightDir + viewDir);
    float NdotH = max(dot(normalDir, halfDir), 0.0);
    float spec = pow(NdotH, SPEC_POWER * (1.0 - roughness));
    spec *= (1.0 - roughness * 0.7);
    return baseCol * spec * 1.5;
}

// ─── Main ───────────────────────────────────────────────────────────────────
void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = ivec2(gl_NumWorkGroups.xy * gl_WorkGroupSize.xy);

    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim) * 2.0 - 1.0;
    uv.x *= pc.aspectRatio;

    vec2 squareUV = uv;
    squareUV.x /= pc.aspectRatio;

    vec3 bg = vec3(0.008, 0.01, 0.015);
    vec3 color = bg;

    // Maze walls
    float md = sdMaze(uv);
    if (md < GLOW_WIDTH) {
        float heightShade = 1.0 - (uv.y * 0.5 + 0.5) * WALL_HEIGHT_GRAD;
        vec3 wallBase = mix(vec3(0.02, 0.04, 0.12), vec3(0.04, 0.12, 0.35), heightShade);
        vec3 normal = normalize(vec3(md * 20.0, 0.5, 0.3));
        float glow = smoothstep(GLOW_WIDTH, -0.005, md);
        color = mix(color, wallBase, glow * 0.8);
        if (md > -0.04 && md < 0.0) {
            color *= mix(0.5, 1.0, smoothstep(-0.04, 0.0, md));
        }
    }

    // Dots
    float dd = sdDots(uv);
    if (dd < GLOW_WIDTH) {
        color += vec3(0.9, 0.8, 0.5) * smoothstep(GLOW_WIDTH, 0.0, dd) * 0.8;
    }

    // Entities + lights
    const int N = 5;
    vec3 ghostCols[4] = vec3[](
        vec3(1.00, 0.22, 0.22),
        vec3(1.00, 0.55, 0.75),
        vec3(0.25, 0.85, 1.00),
        vec3(1.00, 0.65, 0.15)
    );

    vec3 lightAccum = vec3(0.0);

    for (int i = 0; i < N; ++i) {
        float fi = float(i);
        float speed = 0.05 + fi * 0.012;

        vec2 rawPos = vec2(
            sin(pc.time * speed + fi * 2.1) * 0.60,
            cos(pc.time * speed * 0.7 + fi * 3.4) * 0.45
        );

        rawPos += hash22(vec2(fi)) * 0.14 - 0.07;
        vec2 pos = clamp(rawPos, vec2(-0.75), vec2(0.75));

        vec2 vel = pos - vec2(
            sin((pc.time - 0.12) * speed + fi * 2.1) * 0.60,
            cos((pc.time - 0.12) * speed * 0.7 + fi * 3.4) * 0.45
        ) - hash22(vec2(fi)) * 0.14 + 0.07;

        float velLen = length(vel);
        vec2 moveDir = (velLen > 0.0005) ? normalize(vel) : vec2(1.0, 0.0);

        vec2 local = squareUV - pos;

        // Classic Pac-Man chomp: 0 → fully closed, up to ~1.0–1.4 radians wide open
        float chompPhase = abs(sin(pc.time * CHOMP_FREQ + fi * CHOMP_PHASE_SPREAD));
        float openAngle = chompPhase * 1.2;           // max open ~68–80 degrees total

        float animT = pc.time * 2.5 + fi * 4.0;

        float d;
        vec3 col = (i == 0) ? vec3(1.00, 0.92, 0.08) : ghostCols[i-1];

        if (i == 0) {
            float angle = atan(moveDir.y, moveDir.x) + PACMAN_ROT_OFFSET;
            local = rot2(angle) * local;
            d = sdPacCharacter(local, openAngle);
        } else {
            vec2 tiltDir = (velLen > 0.0005) ? normalize(vel) : vec2(0.0);
            float tiltStrength = smoothstep(0.0005, 0.006, velLen);
            float tiltAngleRad = radians(GHOST_TILT_MAX_DEG) * tiltStrength;
            tiltAngleRad += sin(pc.time * 1.8 + fi * 4.2) * 0.15 * tiltStrength;
            mat2 tiltRot = rot2(-tiltAngleRad * moveDir.x);
            local = tiltRot * local;
            d = sdGhostCharacter(local, openAngle, animT);
        }

        float distToEntity = length(squareUV - pos);
        float entityLight = LIGHT_INTENSITY / (1.0 + distToEntity * distToEntity * 8.0);
        lightAccum += col * entityLight;

        if (d < AA_WIDTH) {
            color = mix(color, col, smoothstep(AA_WIDTH, -0.005, d));
        }
        if (d > -AA_WIDTH*3.0 && d < AA_WIDTH*3.0) {
            color += col * (1.0 - abs(d / (AA_WIDTH*3.0))) * 1.4;
        }
    }

    color += lightAccum * 0.6;

    // Power pellets
    vec2 ppCenters[4] = vec2[](
        vec2(-0.55,  0.45),
        vec2( 0.55,  0.45),
        vec2(-0.55, -0.45),
        vec2( 0.55, -0.45)
    );

    vec3 ppBaseCol = vec3(1.0, 0.85, 0.4);

    for (int j = 0; j < 4; ++j) {
        vec2 center = ppCenters[j] + vec2(sin(pc.time * 0.8 + float(j)*1.5708)*0.03,
                                          cos(pc.time * 0.8 + float(j)*1.5708)*0.03);

        float pd = sdPowerPellet(squareUV, center, 0.028);

        if (pd < GLOW_WIDTH * 1.5) {
            vec3 normal = normalize(vec3(squareUV - center, 0.3));
            vec3 fakeLightDir = normalize(vec3(0.5, 0.8, 1.2));
            vec3 fakeViewDir  = normalize(vec3(0.0, -0.3, 1.0));

            vec3 spec = roughMetalSpec(normal, fakeLightDir, fakeViewDir, ppBaseCol, SPEC_ROUGHNESS);
            spec += lightAccum * 0.8 * (1.0 - SPEC_ROUGHNESS);

            float flash = 0.5 + 0.5 * sin(pc.time * 8.0 + float(j) * 2.0);
            vec3 ppColor = mix(ppBaseCol, vec3(1.15), flash * 0.4);

            float alpha = smoothstep(GLOW_WIDTH * 1.5, -0.005, pd);
            color = mix(color, ppColor + spec * 1.8, alpha);

            color += ppBaseCol * smoothstep(0.06, 0.015, pd) * 0.5;
        }
    }

    // Post
    float vig = length(uv) * 0.4;
    color *= 1.0 - vig * vig * 0.6;

    float scan = sin(uv.y * float(dim.y) * 6.28318530718) * 0.035;
    color += scan;

    color = pow(color, vec3(0.95));
    color *= pc.exposure;

    if ((pc.debugFlags & 1u) != 0u) {
        color = mix(color, vec3(1.0, 0.2, 0.8), 0.15);
    }

    imageStore(outputImage, pix, vec4(color, 1.0));
}