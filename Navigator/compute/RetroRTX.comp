#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

// ───────────────────────────────────────────────
// Helpers
// ───────────────────────────────────────────────
#define PI     3.14159265358979323846
#define TAU    6.28318530717958647692
#define EPS    0.0006

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p); f = f*f*(3.0-2.0*f);
    return mix(mix(hash12(i+vec2(0,0)), hash12(i+vec2(1,0)), f.x),
               mix(hash12(i+vec2(0,1)), hash12(i+vec2(1,1)), f.x), f.y);
}

float fbm(vec2 p, int oct) {
    float f = 0.0, a = 0.5;
    for (int i = 0; i < oct; ++i) {
        f += a * noise(p);
        p *= 2.03;
        a *= 0.49;
    }
    return f;
}

vec2 retro_pixelate(vec2 uv, float res) {
    return floor(uv * res + 0.5) / res;
}

vec3 neon_glow(vec3 col, float intensity) {
    return col + pow(col, vec3(3.0)) * intensity;
}

// ───────────────────────────────────────────────
// Scene control
// ───────────────────────────────────────────────
#define SCENE_COUNT 8
#define SCENE_DURATION 12.0
#define CROSSFADE_TIME 0.8

int currentScene(float t) { return int(floor(t / SCENE_DURATION)) % SCENE_COUNT; }
float sceneMix(float t) {
    float phase = mod(t, SCENE_DURATION);
    return smoothstep(SCENE_DURATION - CROSSFADE_TIME, SCENE_DURATION, phase);
}

bool isRetroScene(int idx) { return (idx % 2) == 0; }  // 0,2,4,6 = 80s chunky demoscene

// ───────────────────────────────────────────────
// 0. Classic 80s Plasma God (chunky + copper bars vibe)
// ───────────────────────────────────────────────
vec3 fx0_classic_god(vec2 uv, float t) {
    uv = retro_pixelate(uv, 320.0);
    vec2 p = uv * vec2(1.6, 1.0) + vec2(t*0.4, sin(t*0.7)*0.3);
    float plasma = sin(p.x*12.0 + t*3.2)*0.5 + sin(p.y*15.0 + t*2.8)*0.5;
    plasma += sin((p.x + p.y)*18.0 + t*5.0)*0.4;
    plasma = fract(plasma * 0.5 + 0.5);
    
    vec3 col = mix(vec3(0.0,0.8,1.0), vec3(1.0,0.1,0.8), plasma);
    col = mix(col, vec3(1.0,0.9,0.0), smoothstep(0.4,0.6,plasma)*0.7);
    
    // fake copper bars horizontal gradient
    float bar = fract(uv.y * 8.0 + t*1.2);
    bar = smoothstep(0.0,0.05,bar) - smoothstep(0.95,1.0,bar);
    col += vec3(1.0,0.7,0.3) * bar * 1.2;
    
    return neon_glow(col * 1.8, 2.5);
}

// ───────────────────────────────────────────────
// 1. RTX God – volumetric bloom explosion
// ───────────────────────────────────────────────
vec3 fx1_rtx_god(vec2 uv, float t) {
    float collapse = fbm(uv * 4.0 + vec2(t*1.1, t*1.6), 8) * 0.8;
    float osc = cos(t * 5.0 + dot(uv, vec2(22.0,14.0)))*0.5 + 0.5;
    float dark = exp(-length(uv)*2.2) * 2.0;
    
    vec3 col = mix(vec3(0.3,0.6,1.4), vec3(1.0,0.9,0.6), collapse * osc * dark);
    col += vec3(1.4,1.1,0.8) * pow(collapse, 5.0) * dark * 4.0;
    col += pow(col, vec3(2.8)) * 1.5;  // aggressive bloom
    
    return col * 2.1;
}

// ───────────────────────────────────────────────
// 4. Classic 80s Parallax Starfield + tunnel twist
// ───────────────────────────────────────────────
vec3 fx4_classic_starfield(vec2 uv, float t) {
    uv = retro_pixelate(uv, 320.0);
    vec3 col = vec3(0.0);
    
    for (float layer = 0.5; layer < 7.0; layer += 1.0) {
        vec2 p = uv * (layer * 1.6 + 1.0);
        float rot = t * (0.15 + layer * 0.03) + layer*1.4;
        p *= mat2(cos(rot), -sin(rot), sin(rot), cos(rot));
        p.x += t * 0.3 / layer;
        
        vec2 cell = floor(p * 22.0);
        float star = hash12(cell + layer*13.7);
        float bright = step(0.97 - layer*0.03, star);
        col += vec3(1.2,1.1,0.9) * bright * (2.0 / layer);
    }
    
    // subtle plasma background tint
    float bg = sin(uv.x*8.0 + t*2.0)*0.5 + 0.5;
    col += mix(vec3(0.05,0.0,0.15), vec3(0.0,0.1,0.3), bg) * 0.6;
    
    return neon_glow(col * 2.0, 1.8);
}

// ───────────────────────────────────────────────
// 5. RTX Volumetric Starfield – nebula + god rays + deep field
// ───────────────────────────────────────────────
vec3 fx5_rtx_starfield(vec2 uv, float t) {
    vec3 ro = vec3(sin(t*0.2)*0.5, cos(t*0.3)*0.3, t * 1.4);
    vec3 rd = normalize(vec3(uv.x * 1.8, uv.y * 1.1, 1.6));
    
    vec3 col = vec3(0.0);
    float depth = 0.0;
    
    // Volumetric nebula base
    vec2 nuv = uv * 0.7 + vec2(t*0.04, sin(t*0.09)*0.05);
    float neb = fbm(nuv * 1.2 + vec2(t*0.08,0.0), 7);
    neb += fbm(nuv * 3.8 + vec2(0.0, t*0.12), 5) * 0.35;
    vec3 nebula = mix(vec3(0.02,0.04,0.18), vec3(0.3,0.08,0.45), pow(neb, 3.0));
    nebula += vec3(0.6,0.2,0.9) * pow(neb, 7.0) * 1.1;
    col += nebula * 1.3;
    
    // Layered stars with depth fade + twinkle
    for (float i = 0.8; i <= 9.0; i += 1.0) {
        float z = 18.0 / i;
        vec2 p = (uv * z + vec2(sin(t*0.4 + i*2.1)*0.2, cos(t*0.5 + i*3.3)*0.15));
        vec2 cell = floor(p * (24.0 + i*5.0));
        float h = hash12(cell + i*41.0);
        
        float star = smoothstep(0.96, 0.992, h);
        star *= pow(1.0 - depth, 2.2);
        float twinkle = 0.6 + 0.4 * sin(t * 22.0 + h*120.0 + i*7.0);
        
        vec3 starCol = mix(vec3(1.0,0.95,0.85), vec3(0.8,0.9,1.4), sin(t*1.1 + i + h*50.0)*0.5+0.5);
        col += starCol * star * twinkle * (2.2 / i) * 3.0;
        
        depth += star * 0.35;
    }
    
    // Strong god rays from upper right
    float ray = pow(max(0.0, dot(rd, normalize(vec3(0.8,0.9,1.0)))), 48.0);
    col += vec3(1.4,1.0,0.7) * ray * 1.8 * (1.0 - depth*0.7);
    
    // subtle chromatic edge glow
    col.r += 0.04 * length(uv * vec2(1.2,0.8));
    col.b += 0.04 * length(uv * vec2(-1.0,1.0));
    
    return col * 1.9;
}

// ───────────────────────────────────────────────
// 2 & 3 logs, 6 & 7 earth – kept but intensified
// ───────────────────────────────────────────────
vec3 fx2_classic_logs(vec2 uv, float t) {
    uv = retro_pixelate(uv, 320.0);
    uv.y = 1.0 - uv.y;
    float base = smoothstep(0.0, 0.25, uv.y);
    float flicker = sin(t * 35.0 + uv.x * 55.0) * 0.15 + 0.85;
    vec2 p = uv * vec2(1.0, 3.0) + vec2(0.0, t * 2.2);
    float f = noise(p * 6.0) * 0.55 + noise(p * 14.0 + t * 4.5) * 0.45;
    f = smoothstep(0.2, 0.8, f);
    vec3 col = mix(vec3(1.0,0.3,0.0), vec3(1.0,0.9,0.4), f);
    col *= flicker * 2.0 * base;
    return neon_glow(col, 2.2);
}

vec3 fx3_rtx_logs(vec2 uv, float t) {
    uv.y = 1.0 - uv.y;
    float base = smoothstep(0.0, 0.28, uv.y);
    float tt = t * 2.8;
    vec2 p = (uv - vec2(0.0, 0.75)) * vec2(1.0, 5.0) + vec2(sin(tt*0.6)*0.2, tt * 2.1);
    float f = fbm(p * 4.2 + vec2(tt*0.9,0), 6) * 0.7 + fbm(p * 9.0 + vec2(0,tt*1.6), 5) * 0.3;
    f = smoothstep(0.1, 0.9, f);
    vec3 col = mix(vec3(0.6,0.1,0.0), mix(vec3(1.0,0.3,0.0), vec3(1.0,0.95,0.4), f), f);
    float embers = step(0.93, hash12(p*800.0 + tt*55.0)) * 1.6;
    col += vec3(1.0,0.9,0.5) * embers * 4.5;
    col *= base;
    return neon_glow(col * 2.4, 3.0);
}

vec3 fx6_classic_earth(vec2 uv, float t) {
    uv = retro_pixelate(uv, 320.0);
    float n = sin(uv.x * 55.0 + t * 3.0) * 0.5 + 0.5;
    n += sin(uv.y * 35.0 + t * 2.2 + n*8.0) * 0.3;
    vec3 col = mix(vec3(0.3,0.15,0.05), vec3(0.8,0.5,0.2), n);
    col += vec3(1.0,0.4,0.0) * pow(n, 4.0) * 0.8;
    return neon_glow(col * 1.7, 2.0);
}

vec3 fx7_rtx_earth(vec2 uv, float t) {
    uv *= 5.0;
    float tt = t * 0.6;
    float n = fbm(uv + vec2(tt*0.4, sin(tt*0.9)*0.25), 7) * 0.75;
    n += fbm(uv * 5.0 + vec2(0, tt*1.3), 5) * 0.25;
    vec3 crust = vec3(0.25,0.15,0.1) + vec3(0.6,0.45,0.25) * n * 0.9;
    float magma = pow(0.5 + 0.5 * sin(n * 35.0 + tt * 8.0), 5.0) * 3.5;
    crust += vec3(1.0,0.6,0.05) * magma * 2.2;
    crust = neon_glow(crust, 4.0);
    return crust * 1.8;
}

// ───────────────────────────────────────────────
// Main
// ───────────────────────────────────────────────
void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(hdrImage);
    if (any(greaterThanEqual(pix, res))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(res) * 2.0 - 1.0;
    uv.x *= float(res.x) / float(res.y);

    float t = pc.totalTime;
    float sceneTime = mod(t, SCENE_DURATION * float(SCENE_COUNT));
    int idx = int(floor(sceneTime / SCENE_DURATION));
    float fade = smoothstep(SCENE_DURATION - CROSSFADE_TIME, SCENE_DURATION, mod(sceneTime, SCENE_DURATION));

    vec3 a = vec3(0.0), b = vec3(0.0);
    float localT = mod(t, SCENE_DURATION);

    // Current
    if      (idx == 0) a = fx0_classic_god(uv, localT);
    else if (idx == 1) a = fx1_rtx_god(uv, localT);
    else if (idx == 2) a = fx2_classic_logs(uv, localT);
    else if (idx == 3) a = fx3_rtx_logs(uv, localT);
    else if (idx == 4) a = fx4_classic_starfield(uv, localT);
    else if (idx == 5) a = fx5_rtx_starfield(uv, localT);
    else if (idx == 6) a = fx6_classic_earth(uv, localT);
    else               a = fx7_rtx_earth(uv, localT);

    // Next
    int nidx = (idx + 1) % SCENE_COUNT;
    if      (nidx == 0) b = fx0_classic_god(uv, localT);
    else if (nidx == 1) b = fx1_rtx_god(uv, localT);
    else if (nidx == 2) b = fx2_classic_logs(uv, localT);
    else if (nidx == 3) b = fx3_rtx_logs(uv, localT);
    else if (nidx == 4) b = fx4_classic_starfield(uv, localT);
    else if (nidx == 5) b = fx5_rtx_starfield(uv, localT);
    else if (nidx == 6) b = fx6_classic_earth(uv, localT);
    else                b = fx7_rtx_earth(uv, localT);

    vec3 finalColor = mix(a, b, fade);

    // Unified post – heavy glow + contrast + vignette
    finalColor = pow(finalColor, vec3(0.9));               // slight gamma
    finalColor += pow(finalColor, vec3(3.5)) * 0.35;       // strong bloom feel
    float vig = 1.0 - dot(uv, uv) * 0.28;
    finalColor *= vig * 1.25;

    imageStore(hdrImage, pix, vec4(finalColor, 1.0));
}