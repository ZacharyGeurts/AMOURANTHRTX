// anyhit.rahit
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_hierarchy : enable

struct Payload {
    vec3 color;
    vec3 attenuation;
    uint depth;
    bool miss;
};

layout(location = 0) rayPayloadInEXT Payload payload;

hitAttributeEXT vec3 hitAttribs;

layout(binding = 3, set = 0) uniform sampler2D skinAlbedoTex;      // Albedo / base color map (RGB)
layout(binding = 4, set = 0) uniform sampler2D skinNormalTex;      // Normal map (RGB, tangent space)
layout(binding = 5, set = 0) uniform sampler2D skinSubsurfaceTex;  // Subsurface strength / thickness map (R channel typically)

layout(push_constant, scalar) uniform PushConstants {
    mat4 invView;
    mat4 invProj;
    float totalTime;
    uint spp;
    uint frameSeed;
    uint forceEnvOnly;
    float jitterStrength;
    uint maxRecursion;
    uint useEnvSky;
    uint flipEnvV;
    uint showHotPink;
    float environmentExposure;
    float skyIntensity;
    float environmentRotationY;
    vec3 billboardBaseColor;
    float billboardAlphaCutoff;
    uint billboardUseAlphaBlend;
    uint showNormals;
    uint showUVs;
    uint showWireframe;
    uint enableReflections;
    uint enableShadows;
    uint enableVolumetrics;
    float fogPulseSpeed;
    float fogPulseAmount;
    float lightBobSpeed;
    float lightBobAmplitude;
    float lightOrbitSpeed;
    float lightOrbitAmplitude;
    float lightColorPulseSpeed;
    float lightColorPulseAmount;
} pc;

// Simple hash for noise
float hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return float(seed) * (1.0 / 4294967296.0);
}

void main()
{
    // Assume skin material is on instanceCustomIndex 0 (adjust if you have multiple materials)
    // Change this condition if your skin geometry uses a different custom index
    if (gl_InstanceCustomIndexEXT != 0) {
        return;
    }

    // Barycentric coordinates from hit attributes
    vec3 bary = vec3(1.0 - hitAttribs.x - hitAttribs.y, hitAttribs.x, hitAttribs.y);

    // Compute UV coordinates (assuming a standard triangle with UVs at vertices: (0,1), (0,0), (1,0))
    vec2 uv = bary.x * vec2(0.0, 1.0) +
              bary.y * vec2(0.0, 0.0) +
              bary.z * vec2(1.0, 0.0);

    // Sample skin textures
    vec4 albedoSample = texture(skinAlbedoTex, uv);
    float alpha = albedoSample.a;

    // Basic alpha test – discard fully transparent pixels (e.g. for eyelashes, hair alpha, etc.)
    if (alpha < 0.5) {
        ignoreIntersectionEXT;
        return;
    }

    // Sample subsurface map (usually red channel stores thickness or SSS strength)
    float subsurfaceStrength = texture(skinSubsurfaceTex, uv).r;

    // Optional: subtle pore / micro-noise to break up perfect smoothness
    // Can be used later in closesthit for specular roughness variation
    float microNoise = 0.95 + 0.05 * hash((gl_PrimitiveID + gl_InstanceID * 1000) ^ uint(pc.totalTime * 1000.0));

    // For skin, we generally want to accept the intersection on any opaque/semi-opaque pixel
    // No aggressive alpha cutout like snow/flakes – skin is mostly solid with soft alpha edges
    // If using alpha blending (e.g. for translucency), we can keep the hit and handle blending in closesthit
    // Otherwise, just accept the hit

    // If alpha-blend mode is requested (could be used for thin ear/nose translucency), keep hit
    if (pc.billboardUseAlphaBlend != 0) {
        return; // Accept intersection, blending/emissive will be handled in closesthit if needed
    }

    // Standard opaque-ish skin: accept hit if above a reasonable threshold
    // Lower than 0.5 to preserve soft skin edges (pores, hair, etc.)
    if (alpha < pc.billboardAlphaCutoff * 0.6) {
        ignoreIntersectionEXT;
    }

    // Hit accepted – closest hit shader will handle realistic skin shading (SSS, specular, etc.)
}