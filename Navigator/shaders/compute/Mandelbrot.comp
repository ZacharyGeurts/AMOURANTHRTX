#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

// ────────────────────────────────────────────────
// Controls
// ────────────────────────────────────────────────

#define CYCLE_TIME          6000.0f              // zoom 60 s → hop
#define ZOOM_POWER          1200.0f              // ~10¹²× per cycle
#define MAX_ITER            4096u
#define ESCAPE              16.0f
#define PERIOD_CHECK_DEPTH  32u                // how many iterations to check for cycle

// Starting spots
const vec2 spots[6] = vec2[6](
    vec2(-0.745429,  0.113010),
    vec2(-1.769383,  0.004237),
    vec2(-0.72689,   0.188887),
    vec2( 0.33800,  -0.57500),
    vec2(-0.16200,   1.03200),
    vec2(-0.10110,   0.95630)
);

// ────────────────────────────────────────────────
// Detect low period (simple cycle check)
// ────────────────────────────────────────────────

int detectPeriod(vec2 z0) {
    vec2 z = z0;
    vec2 seen[PERIOD_CHECK_DEPTH];
    for (uint i = 0u; i < PERIOD_CHECK_DEPTH; ++i) {
        seen[i] = z;
        z = vec2(z.x*z.x - z.y*z.y, 2.0*z.x*z.y) + z0;
        for (uint j = 0u; j < i; ++j) {
            if (distance(z, seen[j]) < 1e-6) {
                return int(i - j); // period length
            }
        }
    }
    return 0; // no short period detected
}

vec3 mandelbrotPattern(vec2 c) {
    vec2 z = vec2(0.0);
    int period = detectPeriod(c);

    if (period > 0 && period <= 5) {
        // Inside low-period bulb → fast analytic color (no full iteration)
        float angle = atan(c.y, c.x) + pc.totalTime * 0.1;
        return 0.5 + 0.5 * cos(3.0 + float(period) * 2.0 + vec3(0.0, 0.6, 1.2) * angle);
    }

    // Normal full iteration
    float mu = -1.0;
    for (uint i = 0u; i < MAX_ITER; ++i) {
        z = vec2(z.x*z.x - z.y*z.y, 2.0*z.x*z.y) + c;
        if (dot(z, z) > ESCAPE) {
            mu = float(i) + 1.0 - log(log(dot(z,z)))/log(2.0);
            break;
        }
    }

    if (mu < 0.0) return vec3(0.0);

    float t = mu / float(MAX_ITER);
    vec3 col = 0.5 + 0.5 * cos(3.0 + t*8.0*vec3(1.0, 1.2, 1.4));
    col = pow(col, vec3(0.98));

    return col;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(hdrImage);

    if (any(greaterThanEqual(pix, res))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(res) * 2.0 - 1.0;
    uv.x *= float(res.x) / float(res.y);

    // 60-second zoom lock + hop
    float t = pc.totalTime;
    float phase = mod(t, CYCLE_TIME);
    float cycle = floor(t / CYCLE_TIME);

    int spotIdx = int(cycle) % 6;
    vec2 center = spots[spotIdx];

    float zoom = exp2(-phase * (ZOOM_POWER / CYCLE_TIME));

    vec2 c = center + uv * zoom * 500.0;

    vec3 color = mandelbrotPattern(c);

    float vig = 1.0 - dot(uv, uv) * 0.12;
    color *= vig;

    imageStore(hdrImage, pix, vec4(color, 1.0));
}