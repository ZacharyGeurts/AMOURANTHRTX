#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

// ────────────────────────────────────────────────
//   TIMING & ANIMATION
// ────────────────────────────────────────────────
#define CYCLE_DURATION       20.0
#define PAN_FRACTION         0.20         // first 20% = smooth travel to target
#define ZOOM_FRACTION        (1.0 - PAN_FRACTION)
#define START_ZOOM           3.2
#define MAX_ZOOM_EXP         20.0
#define PRECISION_SAFETY     1.8e-6       // reset before float precision dies
#define MAX_ITER             4608u
#define ESCAPE               400.0        // high value = cleaner distance estimate

// ────────────────────────────────────────────────
//   Classic & deep Mandelbrot locations
// ────────────────────────────────────────────────
const vec2 locations[] = vec2[](
    vec2(-0.745429,     0.113010),        // Seahorse valley – most famous
    vec2(-0.7463,       0.1102),
    vec2(-0.7746806106269039, 0.12486676606681),
    vec2(-0.72689,      0.188887),        // Triple spiral / propeller
    vec2(-1.769383,     0.004237),        // Mini Mandelbrot on the antenna
    vec2(-1.7685,       0.005),
    vec2(-1.62917,     -0.0203968),
    vec2(-1.47711,      0.003322),
    vec2(-1.4011,       0.0),
    vec2( 0.33800,     -0.57500),
    vec2( 0.37500012,  -0.21663939),
    vec2( 0.42884,     -0.231345),
    vec2(-0.1568447,    1.032293),
    vec2(-0.170337,    -1.06506),
    vec2(-0.122561,     0.744862),
    vec2(-0.803858445641739763560, 0.178068463458909115289), // deep embedded spiral
    vec2(-2.0,          0.0),             // far left stem
    vec2(-1.754878,     0.0),
    vec2(-1.0,          0.0),
    vec2(-0.75,         0.0)
    // feel free to append more deep locations here
);

const uint NUM_LOCATIONS = locations.length();

// ────────────────────────────────────────────────
//   Simple hue rotation per location
// ────────────────────────────────────────────────
vec3 getLocationTint(uint idx) {
    float h = fract(float(idx) * 0.137 + 0.6180339887);
    return 0.6 + 0.4 * cos(6.283185 * vec3(h, h+0.33, h+0.67));
}

vec3 computeColor(vec2 c) {
    vec2 z = vec2(0.0);
    uint iter = 0u;
	float xx = 0.0;
	float yy = 0.0;

    for (; iter < MAX_ITER; ++iter) {
        xx = z.x * z.x;
        yy = z.y * z.y;

        if (xx + yy > ESCAPE) {
            break;
        }

        z = vec2(xx - yy, 2.0 * z.x * z.y) + c;
    }

    if (iter == MAX_ITER) {
        return vec3(0.004, 0.007, 0.014); // inside the set – very dark
    }

    // smooth coloring using the last squared magnitude
    float len2 = xx + yy;
    float mu   = float(iter) + 1.0 - log(log(len2 + 1e-6)) / log(2.0); // +1e-6 avoids log(0)
    float t    = mu * 0.021;

    vec3 col = 0.5 + 0.5 * cos(vec3(3.0) + t * vec3(8.4, 7.3, 9.6));
    col = pow(col, vec3(1.12)) * 1.38;

    return col;
}

void main() {
    ivec2 px    = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(hdrImage);
    if (any(greaterThanEqual(px, size))) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(size) * 2.0 - 1.0;
    uv.x *= float(size.x) / float(size.y);

    float now       = pc.totalTime;
    float cyclePos  = mod(now, CYCLE_DURATION);
    uint  location  = uint(floor(now / CYCLE_DURATION)) % NUM_LOCATIONS;

    vec2  target    = locations[location];
    vec3  tint      = getLocationTint(location);

    float phase     = cyclePos / CYCLE_DURATION;  // 0..1 per location

    vec2  from      = vec2(0.0);                  // always start from full view
    vec2  center;
    float zoom;

    if (phase < PAN_FRACTION) {
        // ── Smooth travel to hotspot ───────────────────────────
        float pt = smoothstep(0.0, 1.0, phase / PAN_FRACTION);
        center = mix(from, target, pt);
        zoom   = START_ZOOM;
    } else {
        // ── Zoom-in phase ──────────────────────────────────────
        float zt = (phase - PAN_FRACTION) / ZOOM_FRACTION;
        float exp = zt * MAX_ZOOM_EXP;
        zoom = START_ZOOM * exp2(-exp);

        // Reset to next location before precision is lost
        if (zoom < PRECISION_SAFETY) {
            location = (location + 1u) % NUM_LOCATIONS;
            center   = locations[location];
            zoom     = START_ZOOM * 1.5;  // gentle overshoot
        } else {
            center = target;
        }
    }

    vec2 coord = center + uv * zoom;

    vec3 color = computeColor(coord);

    // Per-location tint + slight vignette + breathing
    color *= mix(vec3(1.0), tint * 1.25, 0.65);
    color *= 1.0 - 0.20 * dot(uv, uv);
    color += 0.035 * sin(now * 0.6 + float(location) * 2.718) * tint;

    imageStore(hdrImage, px, vec4(color, 1.0));
}