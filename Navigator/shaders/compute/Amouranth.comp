#version 460
#extension GL_EXT_scalar_block_layout : enable

// =============================================================================
// AMOURANTH RTX – denim jorts + vivid red-pink V-neck shirt, felt+leather cowboy hat
// Attempt at more "standard person object" with tunable belly region
// =============================================================================

// ── TUNABLE PARAMETERS ──────────────────────────────────────────────────────

// Belly / pregnancy / fat tuning
#define BELLY_Y_CENTER          0.82      // vertical position of belly center
#define BELLY_WIDTH             0.34      // left-right spread
#define BELLY_DEPTH             0.22      // forward protrusion (0 = flat, 0.5+ = very pregnant/fat)
#define BELLY_VERTICAL          0.42      // vertical oval stretch
#define BELLY_BLEND             0.18      // how smoothly it blends into main torso

// General figure tuning
#define GLOBAL_SCALE            1.32
#define TORSO_HEIGHT            0.92
#define TORSO_WIDTH             0.38
#define TORSO_DEPTH             0.28
#define HIP_WIDTH               0.44
#define WAIST_WIDTH             0.29

// Animation
#define JUMP_FREQ               1.8
#define JUMP_AMP                0.16
#define BREATH_SPEED            0.75
#define BREATH_AMP              0.11
#define HEAD_TILT_FREQ          0.42
#define HEAD_TILT_AMP           0.09

// Camera
#define CAMERA_ORBIT_DISTANCE   4.2
#define CAMERA_ORBIT_HEIGHT     1.6
#define CAMERA_ORBIT_SPEED      0.4

// Materials
const int MAT_SKIN  = 1;
const int MAT_HAIR  = 2;
const int MAT_HAT   = 3;
const int MAT_SHIRT = 4;
const int MAT_DENIM = 5;

// =============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

// ── Helpers ─────────────────────────────────────────────────────────────────
mat2 rot2(float a) { float c=cos(a), s=sin(a); return mat2(c,-s,s,c); }

float sdSphere(vec3 p, float r) { return length(p) - r; }

float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - r;
}

float sdEllipsoid(vec3 p, vec3 r) {
    vec3 pr = p / r;
    float k0 = length(pr);
    float k1 = length(pr * pr);
    return k0 * (k0 - 1.0) / k1;
}

float cheapHash13(vec3 p) {
    p = fract(p * 0.3183099 + .1); p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

// ── Animation ───────────────────────────────────────────────────────────────
float jumpOffset() {
    float t = pc.totalTime * JUMP_FREQ;
    float cycle = 0.5 + 0.5 * sin(t);
    float vel = cos(t) * JUMP_FREQ;
    return cycle * JUMP_AMP * (1.0 - exp(-abs(vel) * 0.92));
}

// ── Central body with tunable belly ─────────────────────────────────────────
float sdPersonBody(vec3 p) {
    // Main torso ellipsoid (waist + chest + hips)
    vec3 torso = p;
    torso.y -= 0.95;  // base torso center
    float mainTorso = sdEllipsoid(torso, vec3(TORSO_WIDTH, TORSO_HEIGHT*0.5, TORSO_DEPTH));

    // Belly bulge zone
    vec3 belly = p;
    belly.y -= BELLY_Y_CENTER;
    float bulgeStrength = BELLY_DEPTH *
        exp(-pow(belly.x / (BELLY_WIDTH * 0.5), 2.0)) *
        exp(-pow(belly.y / (BELLY_VERTICAL * 0.5), 2.0));

    // Apply forward displacement
    belly.z += bulgeStrength;

    float bellyShape = sdEllipsoid(belly, vec3(BELLY_WIDTH, BELLY_VERTICAL, BELLY_DEPTH*1.4));

    // Combine: subtract belly cavity or add bulge depending on logic
    // Here we use max → belly pushes out from torso
    return max(mainTorso - BELLY_BLEND, bellyShape - BELLY_BLEND*0.5);
}

// ── Full scene ──────────────────────────────────────────────────────────────
struct Hit { float d; int mat; };

Hit map(vec3 pos) {
    vec3 p = pos / GLOBAL_SCALE;
    float jump  = jumpOffset();
    float breath = sin(pc.totalTime * BREATH_SPEED) * BREATH_AMP;
    float headTilt = sin(pc.totalTime * HEAD_TILT_FREQ + 1.2) * HEAD_TILT_AMP;

    p.y += jump * 0.6 + breath * 0.5;

    Hit res; res.d = 1e10; res.mat = MAT_SKIN;

    // Central body + belly
    float bodyD = sdPersonBody(p);
    res.d = min(res.d, bodyD);
    if (bodyD < res.d + 0.002) res.mat = MAT_SHIRT;  // shirt on torso

    // Head
    vec3 headP = p - vec3(0, 1.78 + HEAD_Y_OFFSET + jump*0.2, 0);
    headP.xz *= rot2(headTilt);
    float headD = sdSphere(headP, 0.34);
    res.d = min(res.d, headD);
    if (headD < res.d + 0.002) res.mat = MAT_SKIN;

    // Neck
    vec3 neckP = p - vec3(0, 1.42 + HEAD_Y_OFFSET + jump*0.15, 0);
    neckP.xz *= rot2(headTilt * 0.6);
    float neckD = sdCapsule(neckP, vec3(0,-0.32,0), vec3(0,0.16,0), 0.105);
    res.d = min(res.d, neckD);

    // Hair (simple)
    vec3 hairP = p - vec3(0, 1.20 + jump*0.2, -0.2);
    hairP.xz *= rot2(headTilt);
    float wave = sin(hairP.y*6.5 + pc.totalTime*10.6 + hairP.z*2.0) * 0.5;
    hairP.x += wave;
    float hairD = sdEllipsoid(hairP, vec3(0.33, 0.86*2.9, 0.35));
    res.d = min(res.d, hairD);
    if (hairD < res.d + 0.002) res.mat = MAT_HAIR;

    // Hat (simplified)
    vec3 hatP = p - vec3(0, 1.60 + jump*0.12 + breath*0.08, 0);
    hatP.xz *= rot2(headTilt * 0.3);
    float hatD = sdCapsule(hatP, vec3(0,0.4,0), vec3(0,0,0), 0.3);
    hatD = min(hatD, sdEllipsoid(hatP + vec3(0,-0.18,0), vec3(0.48,0.04,0.48)));
    res.d = min(res.d, hatD);
    if (hatD < res.d + 0.002) res.mat = MAT_HAT;

    // Arms & legs, hands – can be added later, kept minimal here

    res.d *= GLOBAL_SCALE;
    return res;
}

// ── Normal ──────────────────────────────────────────────────────────────────
vec3 getNormal(vec3 p) {
    vec2 e = vec2(1.0,-1.0)*0.0007;
    vec3 n = normalize(
        e.xyy * map(p + e.xyy).d +
        e.yyx * map(p + e.yyx).d +
        e.yxy * map(p + e.yxy).d +
        e.xxx * map(p + e.xxx).d
    );
    return n;
}

// ── Raymarch ────────────────────────────────────────────────────────────────
float rayMarch(vec3 ro, vec3 rd, out int matID) {
    float t = 0.0;
    matID = 0;
    for (int i = 0; i < 120; i++) {
        vec3 p = ro + rd * t;
        Hit h = map(p);
        t += h.d;
        if (t > 100.0 || abs(h.d) < 0.0008) {
            matID = h.mat;
            break;
        }
    }
    return t;
}

// ── Tonemap ─────────────────────────────────────────────────────────────────
vec3 tonemap(vec3 c) {
    c = c / (c + 1.0);
    c = pow(c, vec3(1.0/2.2));
    return clamp(c * 1.15 - 0.075, 0.0, 1.0);
}

// ── Main ────────────────────────────────────────────────────────────────────
void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(dim) * 2.0 - 1.0;
    uv.x *= float(dim.x) / float(dim.y);

    float camA = pc.totalTime * CAMERA_ORBIT_SPEED;
    vec3 ro = vec3(sin(camA)*CAMERA_ORBIT_DISTANCE, CAMERA_ORBIT_HEIGHT, cos(camA)*CAMERA_ORBIT_DISTANCE);
    vec3 ta = vec3(0.0, 1.5, 0.0);
    vec3 ww = normalize(ta - ro);
    vec3 uu = normalize(cross(ww, vec3(0,1,0)));
    vec3 vv = cross(uu, ww);
    vec3 rd = normalize(uv.x*uu + uv.y*vv + 1.58*ww);

    int matID;
    float t = rayMarch(ro, rd, matID);

    vec3 col = vec3(0.06, 0.04, 0.14);
    float sky = 0.5 + 0.5*uv.y;
    col = mix(vec3(0.18, 0.12, 0.32), vec3(0.45, 0.32, 0.58), sky);

    if (t < 100.0) {
        vec3 p = ro + rd * t;
        vec3 n = getNormal(p);

        vec3 light = normalize(vec3(1.2, 1.4, 1.1));
        float diff = max(0.0, dot(n, light));
        float rim   = pow(1.0 - max(0.0, dot(n, -rd)), 3.4);

        vec3 albedo = vec3(0.9);
        float rough = 0.5;
        float spec  = 0.35;

        if (matID == MAT_HAT) {
            albedo = HAT_FELT_COLOR * (0.88 + 0.12*cheapHash13(p*18.0));
        } else if (matID == MAT_HAIR) {
            albedo = HAIR_COLOR * (0.6 + 0.4*(1.0-cheapHash13(p*vec3(60,5,60))));
        } else if (matID == MAT_SHIRT) {
            albedo = SHIRT_COLOR * (0.85 + 0.15*cheapHash13(p*vec3(8,4,8))*SHIRT_TEXTURE_AMP);
        } else if (matID == MAT_DENIM) {
            albedo = DENIM_COLOR * (0.82 + 0.18*cheapHash13(p*vec3(12,6,12))*DENIM_TEXTURE_AMP);
        } else { // MAT_SKIN
            albedo = SKIN_BASE * (0.92 + 0.08*cheapHash13(p*35.0)*SKIN_TEXTURE_AMP);
        }

        vec3 lighting = albedo * (0.25 + 0.9*diff);
        lighting += vec3(1.00,0.94,0.90) * rim * 2.4;

        if (matID == MAT_SKIN) {
            float sss = max(0.0, 0.6 - diff);
            lighting += SKIN_SUBSURFACE * sss * 1.8;
        }

        vec3 h = normalize(light - rd);
        float specTerm = pow(max(0.0, dot(n, h)), 32.0);
        lighting += vec3(1.0) * specTerm * spec * rim;

        col = lighting;
    }

    col = tonemap(col);
    imageStore(outputImage, pix, vec4(col, 1.0));
}