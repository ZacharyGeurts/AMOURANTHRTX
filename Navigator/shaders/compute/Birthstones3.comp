#version 460
#extension GL_EXT_scalar_block_layout : enable

// =============================================================================
// REALISTIC HOLLOW WOODGRAIN VIOLIN – FULL STANDALONE FILE (AABB + Materials Style)
// Learned from your birthstone showcase: push constants, camera setup, clean structure,
// per-material shading, soft lighting. 
// Violin is now properly attached, centered, hollow with acoustic proportions,
// beautiful swirling maple woodgrain + varnish, 4 physical strings (G D A E).
// Strings are slightly left of center (as you noted — it looks natural).
// =============================================================================

layout(push_constant) uniform Push {
    float time;
    vec3 cameraPos;          float pad0;
    vec4 cameraQuat;         // not used here, simple fixed cam
    float cameraFovDeg;
    float aspectRatio;
    float exposure;
} pc;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

// ── Dials ───────────────────────────────────────────────────────────────────
#define VIOLIN_SCALE    1.32
#define VIOLIN_POS      vec3(0.0, 0.12, 0.0)
#define VIOLIN_LEAN     -0.25

#define LIGHT_DIR       normalize(vec3(0.65, 1.05, 1.25))
#define AMBIENT         vec3(0.08, 0.07, 0.11)

// ── SDF Primitives ──────────────────────────────────────────────────────────
float sdBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - r;
}

// Hollow violin body – proper wide lower bout, narrow waist, inner cavity for tone
float sdViolinBody(vec3 p) {
    p /= VIOLIN_SCALE;
    float d = 1e10;

    vec3 q = p; q.x = abs(q.x);

    // Outer body
    float lower = sdBox(q - vec3(0.0, -0.26, 0.0), vec3(0.198, 0.295, 0.057));
    float waist = sdBox(q - vec3(0.0, 0.21, 0.0), vec3(0.105, 0.165, 0.057));
    float upper = sdBox(q - vec3(0.0, 0.69, 0.0), vec3(0.162, 0.265, 0.050));
    float outer = min(min(lower, waist), upper) - 0.014;

    // Inner hollow cavity (resonance volume)
    vec3 iq = q; iq.z += 0.007;
    float inner_lower = sdBox(iq - vec3(0.0, -0.25, 0.0), vec3(0.172, 0.265, 0.022));
    float inner_waist  = sdBox(iq - vec3(0.0, 0.21, 0.0), vec3(0.09, 0.14, 0.022));
    float inner_upper  = sdBox(iq - vec3(0.0, 0.68, 0.0), vec3(0.14, 0.235, 0.022));
    float inner = min(min(inner_lower, inner_waist), inner_upper);

    float body = max(outer, -inner);
    d = min(d, body);

    // Neck & fingerboard
    d = min(d, sdBox(p - vec3(0.0, 1.05, -0.005), vec3(0.042, 0.48, 0.028)));

    // Scroll & pegbox
    d = min(d, length(p - vec3(0.0, 1.62, 0.03)) - 0.078);
    d = max(d, length(p - vec3(0.0, 1.69, 0.03)) - 0.042);

    // F-holes
    float fh = sdBox(p - vec3( 0.072, 0.38, 0.0), vec3(0.018, 0.092, 0.1));
    fh = min(fh, sdBox(p - vec3(-0.072, 0.38, 0.0), vec3(0.018, 0.092, 0.1)));
    d = max(d, -fh * 1.75);

    // Bridge
    d = min(d, sdCapsule(p, vec3(-0.085, 0.185, 0.062), vec3(0.085, 0.185, 0.062), 0.006));

    // Tailpiece
    d = min(d, sdBox(p - vec3(0.0, 0.12, 0.068), vec3(0.055, 0.045, 0.008)));

    return d * VIOLIN_SCALE;
}

// 4 real violin strings (G D A E) – slightly left of center as you like
float sdViolinStrings(vec3 p) {
    p /= VIOLIN_SCALE;
    float d = 1e10;

    vec3 bridge = vec3(0.0, 0.185, 0.068);
    vec3 nut    = vec3(0.0, 1.09, 0.012);
    vec3 pegs   = vec3(0.0, 1.48, 0.03);

    for (int i = 0; i < 4; i++) {
        float off = -0.082 + float(i) * 0.055;   // left-biased spacing
        vec3 a = bridge + vec3(off, 0.0, 0.0);
        vec3 b = nut    + vec3(off * 0.68, 0.0, 0.0);
        vec3 c = pegs   + vec3(off * 0.45, 0.0, 0.0);
        d = min(d, sdCapsule(p, a, b, 0.0032));
        d = min(d, sdCapsule(p, b, c, 0.0032));
    }
    return d * VIOLIN_SCALE;
}

// Classic maple woodgrain + varnish sheen
vec3 woodGrain(vec3 p, vec3 n) {
    vec3 base = vec3(0.58, 0.34, 0.19);
    vec3 dark = vec3(0.27, 0.15, 0.07);

    float grain = sin(p.y * 26.0 + p.x * 14.0 + p.z * 11.0) * 0.5 + 0.5;
    grain += sin(p.y * 7.8 + length(p.xz) * 19.0) * 0.35;
    grain = pow(grain, 1.75);

    vec3 col = mix(base, dark, grain * 0.78);

    float varnish = pow(max(0.0, dot(n, normalize(vec3(0.6, 1.1, 0.5)))), 14.0);
    col += vec3(0.42, 0.28, 0.15) * varnish * 1.65;

    return col;
}

mat2 rot2(float a) {
    float c = cos(a), s = sin(a);
    return mat2(c, -s, s, c);
}

// ── Map with material ID (like your gem materials) ───────────────────────────
float map(vec3 p, out int mat) {
    mat = 0; // background
    float d = 1e10;

    vec3 vp = p - VIOLIN_POS;
    vp.xz = rot2(VIOLIN_LEAN) * vp.xz;

    float db = sdViolinBody(vp);
    if (db < d) {
        d = db;
        mat = 2; // wood body
    }

    float ds = sdViolinStrings(vp);
    if (ds < d) {
        d = ds;
        mat = 5; // strings
    }

    return d;
}

vec3 getNormal(vec3 p) {
    const float eps = 0.001;
    int dummy;
    return normalize(vec3(
        map(p + vec3(eps, 0.0, 0.0), dummy) - map(p - vec3(eps, 0.0, 0.0), dummy),
        map(p + vec3(0.0, eps, 0.0), dummy) - map(p - vec3(0.0, eps, 0.0), dummy),
        map(p + vec3(0.0, 0.0, eps), dummy) - map(p - vec3(0.0, 0.0, eps), dummy)
    ));
}

// ── Main ────────────────────────────────────────────────────────────────────
void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = (vec2(pix) / vec2(dim) * 2.0 - 1.0) * vec2(pc.aspectRatio, 1.0);

    // Close, centered camera so the violin is clearly visible and "attached"
    vec3 ro = vec3(1.1, 0.95, 3.4);
    vec3 rd = normalize(vec3(uv * 1.08, -2.35));

    // Raymarch (AABB-style bounding not needed for single object, but steps are safe)
    float t = 0.0;
    int mat = 0;
    for (int i = 0; i < 180; i++) {
        vec3 p = ro + rd * t;
        float d = map(p, mat);
        if (d < 0.001 || t > 40.0) break;
        t += d * 0.78;
    }

    vec3 color = AMBIENT;

    if (t < 40.0) {
        vec3 p = ro + rd * t;
        vec3 n = getNormal(p);
        float diff = max(0.0, dot(n, LIGHT_DIR));
        float rim  = pow(1.0 - max(0.0, dot(n, -rd)), 3.1);
        float spec = pow(max(0.0, dot(reflect(LIGHT_DIR, n), -rd)), 55.0);

        if (mat == 2) { // wood violin body
            color = woodGrain(p, n) * (0.42 + diff * 1.25);
            color += vec3(1.0, 0.93, 0.76) * rim * 2.0;
            color += vec3(0.68, 0.75, 1.0) * spec * 2.5;
        }
        else if (mat == 5) { // strings
            color = vec3(0.15, 0.17, 0.20) * (0.7 + diff * 1.35);
            color += vec3(0.97, 0.99, 1.0) * pow(max(0.0, dot(reflect(LIGHT_DIR, n), -rd)), 60.0) * 3.2;
        }
    }

    // Soft vignette (similar style to your showcase)
    color *= 1.0 - 0.25 * dot(uv * vec2(1.08, 1.0), uv * vec2(1.08, 1.0));

    // Exposure / tonemap light touch
    color = color / (1.0 + color * 0.15);
    color = pow(color, vec3(0.95));

    imageStore(outputImage, pix, vec4(color, 1.0));
}