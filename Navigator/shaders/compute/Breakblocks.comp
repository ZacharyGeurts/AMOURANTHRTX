#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

layout(set = 0, binding = 6, std430) buffer AudioCommands {
    float slotCommand[16];
    float slotValue[16];
    float reserved[16];
} audio;

layout(push_constant) uniform PushConstants {
    float       time;                       // total engine time (seconds)
    uint        frameSeed;                  // per-frame RNG seed

    vec3        cameraPos;                  float pad0;
    vec4        cameraQuat;                 // xyzw orientation quaternion
    float       cameraFovDeg;               // vertical FOV in degrees
    float       aspectRatio;                // width / height
    float       nearPlane;
    float       farPlane;

    // Post-process controls — shader applies these
    float       exposure;                   // EV stops compensation
    float       vignetteStrength;           // 0 = off, typical 0.3–0.8
    float       bloomThreshold;             // brightness where glow begins
    float       bloomIntensity;             // self-bloom strength (0 = disabled)
    uint        tonemapMode;                // 0 = linear/raw, 1 = simple filmic, 2 = ACES approx
    float       contrast;                   // 0.8–1.4 typical
    float       saturation;                 // 0.0–2.0 typical
    float       gamma;                      // 1.0 typical

    // Environment / atmosphere
    vec3        sunDir;                     float sunIntensity;
    vec3        moonDir;                    float moonIntensity;
    vec3        windDir;                    float windStrength;
    float       fogDensity;
    float       dayNightFactor;
    float       cloudCoverage;

    // Raymarching quality (unused here but kept for compatibility)
    float       raymarchMaxDist;
    float       raymarchEpsilon;
    uint        raymarchMaxSteps;

    // Full input state — sent every frame
    uint        controllerInput;            // bitfield (keyboard + mouse buttons)
    float       leftStickX;                 float leftStickY;
    float       rightStickX;                float rightStickY;
    float       leftTrigger;                float rightTrigger;

    // Mouse input
    vec2        mouseDelta;                 // raw pixel delta this frame
    vec2        mouseNormalized;            // [0,1] screen space (0,0 = top-left)
    float       mouseWheelDelta;            // accumulated scroll this frame

    float       pad1[3];                    // pad to 16-byte alignment
} pc;

// Audio constants (example command values; host should interpret)
#define AUDIO_CMD_PLAY   0.8
#define AUDIO_CMD_STOP   -0.5

// GAME CONSTANTS
#define PADDLE_WIDTH        0.18
#define PADDLE_HEIGHT       0.018
#define PADDLE_Y            0.08

#define BALL_RADIUS         0.008
#define BALL_BASE_SPEED     0.0075

#define BRICK_ROWS          8
#define BRICK_COLS          14
#define BRICK_HEIGHT        0.028
#define BRICK_GAP           0.004
#define BRICK_TOP_MARGIN    0.12

#define ACCUM_BLEND         0.84

// Input bitflags — match host mapping (keyboard + gamepad)
#define INPUT_LEFT          (1u << 2)
#define INPUT_RIGHT         (1u << 3)
#define INPUT_SHOOT         (1u << 8)
#define INPUT_SPACE         (1u << 9)   // optional: map spacebar
#define INPUT_ESCAPE        (1u << 10)  // optional: map escape for reset

// State row (bottom of screen image)
#define STATE_ROW(h)        ((h) - 1)

// HELPERS
float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    return fract(2.0 * p * p);
}

vec3 brickColor(int row) {
    float t = float(row) / float(BRICK_ROWS - 1);
         if (row < 2) return vec3(1.00, 0.32, 0.42);
    else if (row < 4) return mix(vec3(1.00, 0.32, 0.42), vec3(1.00, 0.92, 0.32), t * 3.0);
    else if (row < 6) return vec3(1.00, 0.92, 0.32);
    else              return vec3(0.22, 0.82, 1.00);
}

bool rectHit(vec2 point, vec2 center, vec2 halfSize) {
    vec2 d = abs(point - center) - halfSize;
    return max(d.x, d.y) < 0.0;
}

vec4 loadState(ivec2 coord) {
    return imageLoad(outputImage, coord);
}

void storeStateVec2(int slotX, vec2 v) {
    imageStore(outputImage, ivec2(slotX, STATE_ROW(imageSize(outputImage).y)), vec4(v, 0.0, 0.0));
}
void storeStateFloat(int slotX, float f) {
    imageStore(outputImage, ivec2(slotX, STATE_ROW(imageSize(outputImage).y)), vec4(f, 0.0, 0.0, 0.0));
}
vec2 loadStateVec2(int slotX) {
    return loadState(ivec2(slotX, STATE_ROW(imageSize(outputImage).y))).xy;
}
float loadStateFloat(int slotX) {
    return loadState(ivec2(slotX, STATE_ROW(imageSize(outputImage).y))).x;
}

// MAIN
void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputImage);
    if (any(greaterThanEqual(pix, dim))) return;

    vec2 uv = vec2(pix) / vec2(dim);
    int stateRow = STATE_ROW(dim.y);
    bool isState = (pix.y == stateRow);

    // Load state (safe even if not initialized)
    vec2  ballPos = loadStateVec2(0);
    vec2  ballVel = loadStateVec2(1);
    float paddleX = loadStateFloat(2);
    float startTime = loadStateFloat(4);

    // If startTime is 0, initialize to current time on first frame
    if (startTime <= 0.0 && pc.frameSeed < 100000u) startTime = pc.time;

    // Input: prefer gamepad sticks / dpad; fallback to mouse
    float stick = pc.leftStickX;
    bool inpLeft  = (pc.controllerInput & INPUT_LEFT)  != 0u;
    bool inpRight = (pc.controllerInput & INPUT_RIGHT) != 0u;
    bool inpShoot = (pc.controllerInput & INPUT_SHOOT) != 0u;
    bool inpSpace = (pc.controllerInput & INPUT_SPACE) != 0u;
    bool inpEsc   = (pc.controllerInput & INPUT_ESCAPE) != 0u;

    // Reset conditions: escape or both triggers fully pressed or ball lost
    bool reset = inpEsc ||
                 (pc.leftTrigger  > 0.98 && pc.rightTrigger > 0.98) ||
                 (pc.frameSeed < 12u) ||
                 (ballPos.y < -0.2);

    // INIT on reset (only written from the state row invocations)
    if (isState && reset) {
        ballPos = vec2(0.5, 0.35);
        ballVel = normalize(vec2(0.4 + hash11(pc.time + float(pc.frameSeed)) * 0.2 - 0.1, 1.0)) * BALL_BASE_SPEED;
        if (length(ballVel) < 0.001) ballVel = vec2(0.0, BALL_BASE_SPEED);
        paddleX = 0.5;
        startTime = pc.time;

        // fill bricks
        for (int r = 0; r < BRICK_ROWS; ++r) {
            uint full = (1u << BRICK_COLS) - 1u;
            imageStore(outputImage, ivec2(3 + r, stateRow), vec4(uintBitsToFloat(full), 0.0, 0.0, 0.0));
        }

        // stop audio slot 0
        audio.slotCommand[0] = AUDIO_CMD_STOP;
        audio.slotValue[0]   = 0.0;
    }

    // PADDLE MOVEMENT
    float paddleDelta = stick * 2.0;
    if (inpLeft)  paddleDelta -= 1.4;
    if (inpRight) paddleDelta += 1.4;
    // mouse fallback: use normalized mouse X
    if (abs(paddleDelta) < 0.04) paddleDelta = (pc.mouseNormalized.x - 0.5) * 3.8;
    paddleX += paddleDelta * 0.017;
    paddleX = clamp(paddleX, PADDLE_WIDTH * 0.5, 1.0 - PADDLE_WIDTH * 0.5);

    // LAUNCH input (spacebar OR shoot bit OR triggers)
    bool launch = inpShoot || inpSpace || pc.leftTrigger > 0.38 || pc.rightTrigger > 0.38;

    // tiny mouse nudge to ball when moving mouse a lot
    ballVel += pc.mouseDelta * vec2(0.0012, -0.0012);

    // PHYSICS (only run on a few pixels wide stripe and state row to limit work)
    if (pix.x < 6 || isState) {
        vec2 next = ballPos + ballVel;

        // walls
        if (next.x <= BALL_RADIUS)  { next.x = BALL_RADIUS;  ballVel.x *= -1.018; }
        if (next.x >= 1.0 - BALL_RADIUS) { next.x = 1.0 - BALL_RADIUS; ballVel.x *= -1.018; }
        if (next.y >= 1.0 - BALL_RADIUS) { next.y = 1.0 - BALL_RADIUS; ballVel.y *= -1.018; }

        // paddle collision
        vec2 padCenter = vec2(paddleX, PADDLE_Y);
        vec2 halfSize  = vec2(PADDLE_WIDTH * 0.5, PADDLE_HEIGHT * 0.5);
        if (rectHit(next, padCenter, halfSize)) {
            ballVel.y = abs(ballVel.y) * 1.045;
            float frac = (next.x - paddleX) / (PADDLE_WIDTH * 0.5);
            frac = clamp(frac, -1.0, 1.0);
            ballVel.x += frac * 1.0 + pc.rightStickX * 0.65;
            ballVel = normalize(ballVel) * BALL_BASE_SPEED * 1.04;
            // push ball out to avoid sticking
            next.y = padCenter.y + halfSize.y + BALL_RADIUS + 0.001;
        }

        // bricks
        int hitRow = -1, hitCol = -1;
        float bw = 1.0 / float(BRICK_COLS + 1);
        float bfh = BRICK_HEIGHT + BRICK_GAP;
        float topY = 1.0 - BRICK_TOP_MARGIN;

        if (next.y <= topY && next.y > topY - float(BRICK_ROWS) * bfh) {
            hitRow = int(floor((topY - next.y) / bfh));
            float left = (1.0 - float(BRICK_COLS) * bw) * 0.5;
            float bfw = bw + BRICK_GAP;
            hitCol = int(floor((next.x - left) / bfw));

            if (hitRow >= 0 && hitRow < BRICK_ROWS && hitCol >= 0 && hitCol < BRICK_COLS) {
                uint mask = floatBitsToUint(loadState(ivec2(3 + hitRow, stateRow)).x);
                uint bit  = 1u << uint(hitCol);
                if ((mask & bit) != 0u) {
                    mask &= ~bit;
                    imageStore(outputImage, ivec2(3 + hitRow, stateRow),
                               vec4(uintBitsToFloat(mask), 0.0, 0.0, 0.0));

                    vec2 brickCenter = vec2(
                        left + (float(hitCol) + 0.5) * bw + BRICK_GAP * 0.5,
                        topY - (float(hitRow) + 0.5) * bfh
                    );
                    vec2 d = next - brickCenter;
                    if (abs(d.y) > abs(d.x)) ballVel.y *= -1.03;
                    else                       ballVel.x *= -1.03;

                    // play hit sound (slot 1) briefly
                    if (isState) {
                        audio.slotCommand[1] = AUDIO_CMD_PLAY;
                        audio.slotValue[1]   = 0.8 + fract(pc.time) * 0.2;
                    }
                }
            }
        }

        ballPos = next;

        // launch if ball nearly still near paddle
        if (launch && abs(ballVel.y) < 0.0008 && ballPos.y < 0.45) {
            ballVel = normalize(vec2(pc.rightStickX * 0.75 + 0.18, 1.0)) * BALL_BASE_SPEED;
            // play launch sound
            if (isState) {
                audio.slotCommand[1] = AUDIO_CMD_PLAY;
                audio.slotValue[1]   = 1.0;
            }
        }
    }

    // SAVE STATE (only state row should write persistent state)
    if (isState) {
        if (pix.x == 0) imageStore(outputImage, pix, vec4(ballPos, 0.0, 0.0));
        if (pix.x == 1) imageStore(outputImage, pix, vec4(ballVel, 0.0, 0.0));
        if (pix.x == 2) imageStore(outputImage, pix, vec4(paddleX, 0.0, 0.0, 0.0));
        if (pix.x == 4) imageStore(outputImage, pix, vec4(startTime, 0.0, 0.0, 0.0));

        // Audio: play slot 0 once after 5 seconds from startTime
        if (pix.x == 0) {
            float elapsed = pc.time - startTime;
            // trigger a single-frame play near the 5s mark
            if (elapsed >= 5.0 && elapsed < 5.0 + (1.0 / 60.0)) {
                audio.slotCommand[0] = AUDIO_CMD_PLAY;
                audio.slotValue[0]   = 1.0;
            }
        }
    }

    if (isState) return; // state row does not render

    // RENDER
    vec3 color = vec3(0.008, 0.015, 0.048);

    // bricks
    for (int r = 0; r < BRICK_ROWS; ++r) {
        uint mask = floatBitsToUint(loadState(ivec2(3 + r, stateRow)).x);
        for (int c = 0; c < BRICK_COLS; ++c) {
            if ((mask & (1u << uint(c))) == 0u) continue;

            float bw = 1.0 / float(BRICK_COLS + 1);
            float bx = (1.0 - float(BRICK_COLS) * bw) * 0.5 + (float(c) + 0.5) * bw + BRICK_GAP * 0.5;
            float by = 1.0 - BRICK_TOP_MARGIN - (float(r) + 0.5) * (BRICK_HEIGHT + BRICK_GAP);

            vec2 center = vec2(bx, by);
            vec2 halfSize = vec2(bw * 0.5, BRICK_HEIGHT * 0.5);

            if (rectHit(uv, center, halfSize)) {
                vec3 bc = brickColor(r);
                color = bc * 0.93;
                vec2 local = (uv - center) / halfSize;
                float shine = 1.0 - smoothstep(0.0, 1.0, length(local));
                color += bc * 0.40 * shine;
            }
        }
    }

    // paddle
    vec2 padCenter = vec2(paddleX, PADDLE_Y);
    vec2 halfSize  = vec2(PADDLE_WIDTH * 0.5, PADDLE_HEIGHT * 0.5);
    if (rectHit(uv, padCenter, halfSize)) {
        color = vec3(0.92, 0.97, 1.00) * 0.97;
    }

    // ball
    float dist = length(uv - ballPos) - BALL_RADIUS;
    float shape = smoothstep(0.0, -0.0045, dist);
    vec3 ballC = vec3(1.00, 0.98, 0.70);
    color = mix(color, ballC, shape);
    float glow = smoothstep(0.065, 0.0, length(uv - ballPos));
    color += ballC * glow * 0.95;

    // top-left debug (shows input/state)
    if (pix.x < 10 && pix.y < 10) {
        if (reset) color = vec3(1.0, 0.0, 0.0);
        else       color = vec3(0.0, 1.0, 0.0);
    }

    // post effects
    color *= pow(2.0, pc.exposure);
    color = pow(color, vec3(1.0 / pc.gamma));
    color = (color - 0.5) * pc.contrast + 0.5;
    float lum = dot(color, vec3(0.299, 0.587, 0.114));
    color = mix(vec3(lum), color, pc.saturation);

    // vignette
    float vig = 1.0 - pc.vignetteStrength * length(uv - 0.5) * 2.2;
    color *= vig;

    // accumulation / persistence
    vec4 prev = imageLoad(outputImage, pix);
    vec4 final = mix(prev, vec4(color, 1.0), ACCUM_BLEND);

    imageStore(outputImage, pix, final);
}