#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D hdrImage;

layout(push_constant) uniform Push {
    float totalTime;
} pc;

// ────────────────────────────────────────────────
//   Infinite Zoom Parameters
// ────────────────────────────────────────────────
#define CYCLE_TIME          48.0     // longer cycles = more breathing room
#define PAN_FRACTION        0.16     // short smooth pan, long zoom
#define START_ZOOM          3.5
#define MAX_ZOOM_EXP        40.0     // extremely deep
#define PRECISION_RESET     1.5e-6   // reset gracefully before precision death

#define BASE_ITER           1200u
#define MAX_ITER            65536u   // for truly deep zooms
#define ESCAPE_RADIUS       1e14     // very high for clean deep rendering

// ────────────────────────────────────────────────
//   High-quality infinite locations
// ────────────────────────────────────────────────
const vec2 locations[] = vec2[](
    vec2(-0.745429,     0.113010),   // Classic Seahorse Valley
    vec2(-0.7746806106, 0.124866766), 
    vec2(-1.769383,     0.004237),   // Mini Mandelbrot
    vec2(-1.62917,     -0.020397),
    vec2(-0.156845,     1.032293),
    vec2(-0.8038584456, 0.1780684635), // Deep embedded spiral
    vec2(-1.4011,       0.0),
    vec2(-0.7463,       0.11025)
);

const uint NUM_LOC = locations.length();

vec3 palette(float t) {
    return 0.5 + 0.5 * cos(6.283185 * (vec3(0.0, 0.1, 0.3) + t * vec3(1.2, 1.1, 0.9)));
}

vec3 mandelbrot(vec2 c, float zoom) {
    // Scale iterations with depth — the deeper we go, the more detail we reveal
    uint maxIter = uint(clamp(float(BASE_ITER) + log(max(1.0 / zoom, 1e-12)) * 920.0,
                              float(BASE_ITER), float(MAX_ITER)));

    vec2 z = vec2(0.0);
    uint i = 0u;

    for (; i < maxIter; ++i) {
        float x2 = z.x * z.x;
        float y2 = z.y * z.y;

        if (x2 + y2 > ESCAPE_RADIUS) break;

        z = vec2(x2 - y2, 2.0 * z.x * z.y) + c;
    }

    if (i == maxIter) {
        return vec3(0.001, 0.0015, 0.004); // deep black inside the set
    }

    // High-quality smooth iteration count
    float len2 = dot(z, z);
    float mu = float(i) + 1.0 - log(log(len2)) / log(2.0);

    // Evolving, rich palette that feels infinite
    float paletteT = mu * 0.0082 + pc.totalTime * 0.028;
    vec3 col = palette(paletteT);

    // Depth shading + glow for "big balls" effect
    float depth = clamp(mu / float(maxIter), 0.0, 1.0);
    col = mix(col * 0.65, col * 2.4, depth * depth);

    // Extra richness at extreme depth
    if (zoom < 1e-5) col += vec3(0.08, 0.04, 0.12) * (1.0 - depth);

    return col;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(hdrImage);
    if (any(greaterThanEqual(px, dim))) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(dim) * 2.0 - 1.0;
    uv.x *= float(dim.x) / float(dim.y);

    float t = pc.totalTime;

    // Infinite cycling through beautiful locations
    float cycle = mod(t, CYCLE_TIME);
    uint locIdx = uint(floor(t / CYCLE_TIME)) % NUM_LOC;

    vec2 target = locations[locIdx];

    float phase = cycle / CYCLE_TIME;

    vec2 center;
    float zoom;

    if (phase < PAN_FRACTION) {
        // Smooth pan to next location
        float pt = smoothstep(0.0, 1.0, phase / PAN_FRACTION);
        center = mix(vec2(0.0), target, pt);
        zoom = START_ZOOM;
    } else {
        // Pure continuous infinite zoom
        float zPhase = (phase - PAN_FRACTION) / (1.0 - PAN_FRACTION);
        zoom = START_ZOOM * exp2(-zPhase * MAX_ZOOM_EXP);

        // Graceful reset — we go infinite without ever breaking
        if (zoom < PRECISION_RESET) {
            locIdx = (locIdx + 1u) % NUM_LOC;
            center = locations[locIdx];
            zoom = START_ZOOM * 3.0;   // gentle restart with new detail
        } else {
            center = target;
        }
    }

    vec2 coord = center + uv * zoom;

    vec3 color = mandelbrot(coord, zoom);

    // Location tint + soft vignette + subtle breathing
    vec3 tint = 0.55 + 0.45 * cos(6.283185 * (float(locIdx) * 0.19 + vec3(0.0, 0.33, 0.67)));
    color = mix(color, color * tint * 1.55, 0.38);

    color *= 1.0 - 0.18 * dot(uv, uv);                    // vignette
    color += 0.018 * sin(t * 0.32 + float(locIdx) * 1.7) * tint; // breathing

    // Final tone mapping
    color = pow(color, vec3(0.90));

    imageStore(hdrImage, px, vec4(color, 1.0));
}