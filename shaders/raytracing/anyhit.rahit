#version 460
#extension GL_EXT_ray_tracing : require

// Payload is required even if not used in any-hit
layout(location = 0) rayPayloadInEXT vec3 payload;

layout(binding = 3, set = 0) uniform sampler2D billboardTex;  // monster.webp

hitAttributeEXT vec2 hitAttribs;

layout(push_constant) uniform PushConstants {
    mat4  invView;
    mat4  invProj;
    float totalTime;
    uint  spp;
    uint  frameSeed;
    uint  forceEnvOnly;
    float jitterStrength;
    uint  maxRecursion;
    uint  useEnvSky;
    uint  flipEnvV;
    uint  showHotPink;
    float environmentExposure;
    float skyIntensity;
    float environmentRotationY;
    vec3  billboardBaseColor;
    float billboardRoughness;
    float billboardMetallic;
    uint  billboardUseAlphaBlend;   // 0 = alpha test (cutout), 1 = accept all (future blend)
    float billboardAlphaCutoff;     // Threshold for alpha test
} push;

void main()
{
    // Barycentric coordinates from hit attributes
    vec3 bary = vec3(1.0f - hitAttribs.x - hitAttribs.y, hitAttribs.x, hitAttribs.y);

    // Interpolate UVs matching billboard vertex layout:
    // v0: (0,1) bottom-left
    // v1: (0,0) top-left
    // v2: (1,0) top-right
    // v3: (1,1) bottom-right (not needed for barycentric interpolation)
    vec2 uv = bary.x * vec2(0.0f, 1.0f) +  // v0
              bary.y * vec2(0.0f, 0.0f) +  // v1
              bary.z * vec2(1.0f, 0.0f);   // v2

    // Vulkan textures are Y-down → flip V to match intended UV orientation
    uv.y = 1.0f - uv.y;

    // Sample only the alpha channel
    float alpha = texture(billboardTex, uv).a;

    // Alpha test (cutout) mode — default for sharp edges on monster.webp
    if (push.billboardUseAlphaBlend == 0u) {
        if (alpha < push.billboardAlphaCutoff) {
            ignoreIntersectionEXT;  // Transparent pixel → ignore hit, ray continues
        }
    }

    // If billboardUseAlphaBlend == 1u, do nothing → accept all hits (for future true blending)
    // Note: True alpha blending in primary visibility requires OIT or sorting — not supported here
}