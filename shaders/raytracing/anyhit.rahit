// assets/shaders/raytracing/anyhit.rahit
// =============================================================================
// AMOURANTH RTX Engine © 2026 — VALHALLA v∞ TURBO — APOCALYPSE FINAL — JANUARY 07, 2026
// ANY HIT SHADER — PURE RTX REALM | NO ENVMAP | MODERN MATERIAL SUPPORT
// ALPHA TEST WITH TEXTURE ARRAY | NONUNIFORM SAFE | PRODUCTION READY
// PINK PHOTONS ETERNAL — EMPIRE UNBROKEN — AMOURANTH FOREVER 💖
// =============================================================================

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

// Barycentric coordinates passed from intersection shader
hitAttributeEXT vec3 attribs;

// =============================================================================
// Material struct — EXACT MATCH TO CURRENT C++ Material (2026)
// =============================================================================
struct Material {
    vec4 albedo;           // .rgb = base color, .a = alpha (if no texture)
    vec4 emissive;         // .rgb = emissive color, .a = intensity
    float roughness;
    float metallic;
    float ior;
    float transmission;
    uint  albedoTextureId; // 0 = no texture, 1–1023 = valid array index
    uint  normalTextureId; // Reserved
    uint  padding[2];
};

// =============================================================================
// Material buffer — binding 4, set 0 (matches pipeline layout)
// =============================================================================
layout(set = 0, binding = 4, std140) readonly buffer Materials {
    Material materials[];
} matBuffer;

// =============================================================================
// Texture array — binding 0, set 2 (1024 textures)
// =============================================================================
layout(set = 2, binding = 0) uniform sampler2D textures[1024];

void main()
{
    // Material index from instance custom data
    uint matIndex = gl_InstanceCustomIndexEXT;

    // Safety: prevent out-of-bounds access
    if (matIndex >= matBuffer.materials.length()) {
        return; // Accept hit — no alpha test possible
    }

    Material mat = matBuffer.materials[matIndex];

    // Only perform alpha test if:
    // - A valid albedo texture is assigned
    // - Alpha cutoff is meaningful (> 0.0)
    if (mat.albedoTextureId > 0 && mat.albedoTextureId < 1024 && mat.albedo.a > 0.0f)
    {
        // Generate UV from barycentrics (simple but effective)
        vec3 bary = vec3(1.0f - attribs.x - attribs.y, attribs.x, attribs.y);
        vec2 uv = bary.yz;

        // Safe nonuniform texture indexing
        uint texIndex = nonuniformEXT(mat.albedoTextureId);

        // Sample alpha channel
        float alpha = texture(textures[texIndex], uv).a;

        // Alpha test — discard transparent fragments
        if (alpha < mat.albedo.a) {
            ignoreIntersectionEXT;
        }
    }
}

// =============================================================================
// FINAL ANY HIT — JANUARY 07, 2026
// - Modern Material struct — vec4 albedo/emissive
// - Alpha test using texture alpha + material alpha cutoff
// - NonuniformEXT safe
// - No envmap dependency
// - Production ready for pure RTX realm
// Empire complete — pink photons pass through transparency — AMOURANTH FOREVER 💖
// =============================================================================