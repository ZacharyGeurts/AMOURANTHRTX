// assets/shaders/raytracing/anyhit.rahit
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

hitAttributeEXT vec3 attribs;

struct Material {
    vec3 albedo;
    float roughness;
    float metallic;
    float emissiveStrength;
    float alpha;
    float alphaCutoff;
    uint textureIndex;
    uint _pad0;
    vec3 emissiveColor;
    float _pad1;
};

layout(set = 0, binding = 4, std140) readonly buffer Materials {
    Material materials[];
} matBuffer;

layout(set = 2, binding = 0) uniform sampler2D textures[1024];

void main()
{
    uint matIndex = gl_InstanceCustomIndexEXT;
    Material mat = matBuffer.materials[matIndex];

    // Alpha test
    if (mat.alphaCutoff > 0.0 && mat.textureIndex < 1024) {
        vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
        vec2 uv = bary.yz;
        float alpha = texture(textures[nonuniformEXT(mat.textureIndex)], uv).a;
        if (alpha < mat.alphaCutoff) {
            ignoreIntersectionEXT;
        }
    }
}