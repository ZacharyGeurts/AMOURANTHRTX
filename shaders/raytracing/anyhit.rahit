// assets/shaders/raytracing/anyhit.rahit
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

// Required for any-hit shaders that may modify or discard hits
hitAttributeEXT vec3 attribs;

// Same Material struct as in closest_hit.rchit – must match C++ exactly
struct Material {
    vec3  albedo;
    float roughness;
    float metallic;
    float emissiveStrength;
    float alpha;
    float alphaCutoff;
    uint  textureIndex;   // 0 = no texture, 1–1023 = valid index in texture array
    uint  _pad0;
    vec3  emissiveColor;
    float _pad1;
};

// Material buffer – matches binding 4 in set 0
layout(set = 0, binding = 4, std140) readonly buffer Materials {
    Material materials[];
} matBuffer;

// Texture array – matches binding 0 in set 2
layout(set = 2, binding = 0) uniform sampler2D textures[1024];

void main()
{
    // Use instance custom index as material index (set during BLAS/TLAS build)
    uint matIndex = gl_InstanceCustomIndexEXT;

    // Safety check – prevent out-of-bounds access (optional but recommended)
    // If materialCount is not available here, you can remove this or add it via UBO if needed
    // if (matIndex >= matBuffer.materials.length()) { return; }

    Material mat = matBuffer.materials[matIndex];

    // Only perform alpha test if:
    // - alphaCutoff is greater than 0 (indicates alpha testing enabled)
    // - a valid texture is assigned (textureIndex > 0)
    if (mat.alphaCutoff > 0.0 && mat.textureIndex > 0 && mat.textureIndex < 1024)
    {
        // Simple barycentric UV generation (same as in closest_hit)
        vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
        vec2 uv = bary.yz; // maps triangle to [0,1] range

        // Sample alpha channel
        float alpha = texture(textures[nonuniformEXT(mat.textureIndex)], uv).a;

        // Discard this intersection if below cutoff
        if (alpha < mat.alphaCutoff)
        {
            ignoreIntersectionEXT;
        }
    }
}