// anyhit.rahit
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_hierarchy : enable

struct Payload {
    vec3 color;
    vec3 attenuation;
    uint depth;
    bool miss;
};

layout(location = 0) rayPayloadInEXT Payload payload;

hitAttributeEXT vec3 hitAttribs;

layout(binding = 3, set = 0) uniform sampler2D snowTex;  // Your sparkly snow particle texture (alpha + bright spots)

layout(push_constant, scalar) uniform PushConstants {
    mat4 invView;
    mat4 invProj;
    float totalTime;
    uint spp;
    uint frameSeed;
    uint forceEnvOnly;
    float jitterStrength;
    uint maxRecursion;
    uint useEnvSky;
    uint flipEnvV;
    uint showHotPink;
    float environmentExposure;
    float skyIntensity;
    float environmentRotationY;
    vec3 billboardBaseColor;
    float billboardAlphaCutoff;
    uint billboardUseAlphaBlend;
    uint showNormals;
    uint showUVs;
    uint showWireframe;
    uint enableReflections;
    uint enableShadows;
    uint enableVolumetrics;
    float fogPulseSpeed;
    float fogPulseAmount;
    float lightBobSpeed;
    float lightBobAmplitude;
    float lightOrbitSpeed;
    float lightOrbitAmplitude;
    float lightColorPulseSpeed;
    float lightColorPulseAmount;
} pc;

// Simple hash for noise
float hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return float(seed) * (1.0 / 4294967296.0);
}

void main()
{
    // Only apply to snow billboards (instance 0 = mug, so use a different custom index or add more instances)
    // For now assuming snow uses instanceCustomIndex == 0 or you have dedicated snow instances
    if (gl_InstanceCustomIndexEXT != 0) return;

    vec3 bary = vec3(1.0 - hitAttribs.x - hitAttribs.y, hitAttribs.x, hitAttribs.y);

    vec2 uv = bary.x * vec2(0.0, 1.0) +
              bary.y * vec2(0.0, 0.0) +
              bary.z * vec2(1.0, 0.0);

    vec4 tex = texture(snowTex, uv);
    float alpha = tex.a;

    // Base alpha test – discard fully transparent parts
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }

    // Add subtle sparkle: boost brightness in bright spots using texture RGB as emissive mask
    // Many snow textures have white/bright flakes – use that to create sparkle
    float sparkleMask = dot(tex.rgb, vec3(0.333));
    float sparkle = max(sparkleMask - 0.7, 0.0) * 5.0;  // Only very bright parts sparkle

    // Optional time-based twinkle
    float twinkle = 0.7 + 0.3 * sin(pc.totalTime * 8.0 + hash(gl_PrimitiveID + gl_InstanceID * 100) * 6.28);

    // If we want additive sparkles instead of alpha cutout
    if (pc.billboardUseAlphaBlend != 0) {
        // Keep intersection, but we’ll handle additive/emissive sparkle in closesthit
        return;
    }

    // Alpha cutout mode – make sparkle areas always visible (no discard)
    if (sparkle > 0.01) {
        return; // Accept hit on sparkly parts even if base alpha is low
    }

    // Standard alpha test with slightly lower threshold for soft snow edges
    if (alpha < pc.billboardAlphaCutoff * 0.8) {
        ignoreIntersectionEXT;
    }
}