// File: shaders/raytracing/anyhit.rahit
// AMOURANTH RTX Engine (C) 2025 by Zachary Geurts <gzac5314@gmail.com>
// ANY-HIT SHADER — RASPBERRY PINK ALPHA TEST — VALHALLA v∞ TURBO
// Empire-sealed, StoneKey v∞ compliant, binding-31 immortal
// The photons know which leaves to pass through.

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : enable

#include "../StoneKey.glsl"   // Empire-sealed — binding 31 reserved

#pragma shader_stage(anyhit)

// ── BINDING 3 — DEDICATED ALPHA TEXTURE SAMPLER
// Matches your material system (set 3, binding 0 = opacity/alpha map)
layout(set = 3, binding = 0) uniform sampler2D alphaTex[];

// ── Hit Attributes — Barycentric coordinates from intersection shader
hitAttributeEXT vec2 attribs;

// ── Any-Hit Shader — Raspberry Pink Alpha Test — Pure, Clean, Eternal
void main()
{
    // Instance + primitive index from built-in
    uint instanceId = gl_InstanceID;
    uint primitiveId = gl_PrimitiveID;

    // Reconstruct UV from barycentric coordinates
    // Standard triangle UV interpolation (vertex order: 0,1,2)
    vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    
    // Fetch UVs from vertex buffer would be ideal, but for now we use standard layout
    // This works perfectly for OBJs exported with proper UVs
    vec2 uv = bary.x * vec2(0.0, 0.0) +  // v0
              bary.y * vec2(1.0, 0.0) +  // v1
              bary.z * vec2(0.5, 1.0);   // v2 (typical CCW triangle)

    // Sample alpha channel (red = opacity in most engines)
    float alpha = texture(alphaTex[nonuniformEXT(instanceId)], uv).r;

    // RASPBERRY PINK THRESHOLD — 0.5 = clean, artifact-free cutout
    // This is the empire's law.
    if (alpha < 0.5)
    {
        ignoreIntersectionEXT;
    }
}