// File: shaders/raytracing/anyhit.rahit
// AMOURANTH RTX Engine © 2025 by Zachary Geurts <gzac5314@gmail.com>
// ANY-HIT SHADER — RASPBERRY PINK ALPHA TEST — VALHALLA v∞ TURBO
// Empire# Fully standalone, zero external dependencies, StoneKey-safe

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : enable

#include "../StoneKey.glsl"   // Empire-sealed — binding 31 reserved

#pragma shader_stage(anyhit)

// ── Descriptor Set 3 — Dedicated Alpha Test Textures (non-conflicting with main RT set)
//    This matches your current material system layout (set 3, binding 0 = alpha/opacity map)
layout(set = 3, binding = 0) uniform sampler2D alphaTex;

// ── Hit Attributes — Barycentric coordinates from intersection shader
hitAttributeEXT vec2 attribs;

// ── Any-Hit Shader — Alpha Testing with Raspberry Pink Precision
void main()
{
    // Reconstruct UV from barycentric coordinates (standard for triangle meshes)
    const vec3 barycentrics = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    const vec2 uv = barycentrics.x * vec2(0.0, 0.0) +   // Vertex 0 UV
                    barycentrics.y * vec2(1.0, 0.0) +   // Vertex 1 UV
                    barycentrics.z * vec2(0.5, 1.0);    // Vertex 2 UV (typical layout)

    // Sample alpha/opacity channel (red channel conventionally used for opacity)
    float alpha = texture(alphaTex, uv).r;

    // Standard alpha test threshold — 0.5 for clean, artifact-free cutouts
    if (alpha < 0.5)
    {
        ignoreIntersectionEXT;
    }
}