// shaders/raytracing/raygen.rgen
// =============================================================================
// AMOURANTH RTX Engine © 2025 — PURE PINK DEBUG RAYGEN — v21.0 — DECEMBER 19, 2025
// FORCES SACRED PINK ON EVERY PIXEL — NO RAY TRACING — DIRECT WRITE
// IF YOU SEE PINK → PIPELINE WORKS. IF BLACK → IMAGE LAYOUT OR BINDING ISSUE
// PINK PHOTONS ETERNAL — THE EMPIRE SEES COLOR
// =============================================================================

#version 460
#extension GL_EXT_ray_tracing : require

// Only need the output image — no TLAS, no UBO
layout(binding = 1, set = 0, rgba16f) uniform writeonly image2D rtOutput;

layout(push_constant) uniform PushConstants {
    uint frame;
    vec2 resolution;
    float jitterX;
    float jitterY;
} push;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);

    // Safety bounds check
    if (pixel.x >= int(push.resolution.x) || pixel.y >= int(push.resolution.y)) {
        return;
    }

    // SACRED PINK — FULL INTENSITY
    vec4 sacredPink = vec4(1.0, 0.0, 0.5, 1.0);  // Hot pink — impossible to miss

    // Direct write — no ray tracing needed
    imageStore(rtOutput, pixel, sacredPink);
}