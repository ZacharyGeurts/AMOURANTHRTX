// shaders/raytracing/raygen.rgen — FINAL & ETERNAL
// AMOURANTH RTX Engine (C) 2025 — VALHALLA v∞ TURBO
// First light achieved. The photons obey. The sky is real.

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../StoneKey.glsl"   // Empire-sealed — binding 31 reserved

// ── Descriptor Set 0 — Core Bindings
layout(set = 0, binding = 0)  uniform accelerationStructureEXT topLevelAS;

layout(set = 0, binding = 1, rgba32f) uniform writeonly  image2D  rtOutput;
layout(set = 0, binding = 2, rgba32f) uniform readonly   image2D  accumulation;

layout(set = 0, binding = 3, scalar) uniform FrameData {
    mat4  viewToWorld;
    mat4  projToWorld;
    vec4  camPos;
    uint  frameIndex;
    float time;
    float jitterX;
    float jitterY;
    vec4  _padding;
} frame;

layout(set = 0, binding = 6, rgba32f) uniform writeonly image2D nexusScore;

// ── BINDING 7 — HDR CUBEMAP SKY — PROTECTED BY STONEKEY v∞
layout(set = 0, binding = 7) uniform samplerCube envMap;

// ── Push Constants — Control from C++
layout(push_constant, std430) uniform PushBlock {
    uint   currentFrame;
    uint   enableNexus;
    uint   enableEnvMap;     // 0 = procedural sky, 1 = real HDR sky
    float  exposure;         // Sky exposure control
    float  skyRotation;      // Y-axis rotation in degrees
    uint   _pad[3];
} push;

// ── Ray Payload
layout(location = 0) rayPayloadEXT vec3 radiance;

// ── Helper: Rotate direction around Y axis
vec3 rotateY(vec3 v, float angleDeg)
{
    float angle = radians(angleDeg);
    float c = cos(angle);
    float s = sin(angle);
    return vec3(
        v.x * c + v.z * s,
        v.y,
        -v.x * s + v.z * c
    );
}

// ── Main Ray Generation
void main()
{
    const uvec2 pixel = gl_LaunchIDEXT.xy;
    const uvec2 size  = gl_LaunchSizeEXT.xy;

    // Screen UV with jitter
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc += vec2(frame.jitterX, frame.jitterY);

    // World-space ray target
    vec4 target = frame.projToWorld * vec4(ndc, 1.0, 1.0);
    target /= target.w;

    vec3 origin    = frame.camPos.xyz;
    vec3 direction = normalize(target.xyz - origin);

    radiance = vec3(0.0);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF,
        0, 0, 0,
        origin, 0.001,
        direction, 10000.0,
        0
    );

    vec3 color = radiance;

    // ── PURE HDR CUBEMAP SKY — MODE 0 TRUTH
    if (push.enableEnvMap != 0u && length(color) < 0.001)
    {
        // Rotate sky if desired
        vec3 skyDir = direction;
        if (push.skyRotation != 0.0)
            skyDir = rotateY(direction, push.skyRotation);

        vec3 skyColor = texture(envMap, skyDir).rgb;

        // Exposure + ACES-like tone mapping
        skyColor = vec3(1.0) - exp(-skyColor * push.exposure);
        skyColor = skyColor / (skyColor + vec3(1.0));
        skyColor = pow(skyColor, vec3(1.0 / 2.2));

        color = skyColor;
    }

    // Temporal accumulation
    vec3 prevColor = imageLoad(accumulation, ivec2(pixel)).rgb;
    color = mix(prevColor, color, 1.0 / float(push.currentFrame + 1u));

    // Final output
    imageStore(rtOutput, ivec2(pixel), vec4(color, 1.0));

    // Nexus feedback
    if (push.enableNexus != 0u && pixel.x == 0 && pixel.y == 0)
    {
        imageStore(nexusScore, ivec2(0,0), vec4(color, 1.0));
    }
}