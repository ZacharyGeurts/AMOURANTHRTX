// raygen.rgen (or raygen.glsl)
#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(push_constant) uniform PushConstants {
    mat4 invView;
    mat4 invProj;
    float totalTime;
    uint spp;
    uint frameSeed;
} push;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D outputImage;
layout(set = 0, binding = 2) uniform sampler2D envMap;

layout(location = 0) rayPayloadEXT vec3 hitColor;

void main() {
    uvec2 launchID = gl_LaunchIDEXT.xy;
    uvec2 launchSize = gl_LaunchSizeEXT.xy;

    // Simple random offset for anti-aliasing (using frameSeed for temporal variation)
    float randX = fract(sin(float(launchID.x + launchID.y * launchSize.x + push.frameSeed)) * 43758.5453);
    float randY = fract(sin(float(launchID.y + launchID.x * launchSize.y + push.frameSeed + 1)) * 43758.5453);

    vec2 pixelCenter = (vec2(launchID) + vec2(0.5) + vec2(randX - 0.5, randY - 0.5)) / vec2(launchSize);
    vec2 inUV = pixelCenter * 2.0 - 1.0;

    vec4 target = push.invProj * vec4(inUV.xy, 1.0, 1.0);
    vec3 origin = (push.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 direction = normalize((push.invView * vec4(normalize(target.xyz), 0.0)).xyz);

    hitColor = vec3(0.0);
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, 0.001, direction, 10000.0, 0);

    // Progressive accumulation
    vec4 prev = imageLoad(outputImage, ivec2(launchID));
    vec3 accum = (prev.rgb * float(push.spp) + hitColor) / float(push.spp + 1);
    imageStore(outputImage, ivec2(launchID), vec4(accum, 1.0));
}