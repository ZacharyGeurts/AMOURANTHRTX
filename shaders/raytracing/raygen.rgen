#version 460 core
#extension GL_EXT_ray_tracing : require

// Payload (not used, but required)
layout(location = 0) rayPayloadEXT vec3 payload;

// RT output image – binding 1 (matches your rtOutputViews)
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outColor;

void main()
{
    // Pure hot pink — no ray tracing, no envmap, no nothing
    imageStore(outColor, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 0.0, 0.8, 1.0));
}