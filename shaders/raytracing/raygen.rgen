#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable

layout(location = 0) rayPayloadEXT vec3 hitValue;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba32f) uniform image2D storageImage;
layout(binding = 2, set = 0) uniform sampler2D envMap;

layout(push_constant) uniform PushConstants {
    mat4  invView;
    mat4  invProj;
    float totalTime;
    uint  spp;
    uint  frameSeed;
    uint  forceEnvOnly;
    float jitterStrength;
    uint  maxRecursion;
    uint  useEnvSky;
    uint  flipEnvV;
    uint  showHotPink;
    float environmentExposure;
    float skyIntensity;
    float environmentRotationY;
} push;

// Fast PCG RNG
uint pcg_hash(uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand(inout uint state)
{
    state = pcg_hash(state);
    return float(state) / float(0xFFFFFFFFu);
}

void main()
{
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 inUV = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = inUV * 2.0 - 1.0;

    // Base ray direction
    vec4 target = push.invProj * vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec3 rayDir = normalize((push.invView * vec4(target.xyz, 0.0)).xyz);
    vec3 rayOrigin = (push.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    // Jitter for temporal AA
    uint rngState = push.frameSeed + uint(gl_LaunchIDEXT.x) + uint(gl_LaunchIDEXT.y) * gl_LaunchSizeEXT.x;
    vec2 jitter = vec2(rand(rngState), rand(rngState)) - 0.5;
    jitter *= push.jitterStrength / vec2(gl_LaunchSizeEXT.xy);

    vec2 jitteredNDC = ndc + jitter * 2.0;
    vec4 jitteredTarget = push.invProj * vec4(jitteredNDC.x, jitteredNDC.y, 1.0, 1.0);
    rayDir = normalize((push.invView * vec4(jitteredTarget.xyz, 0.0)).xyz);

    hitValue = vec3(0.0);

    traceRayEXT(topLevelAS,
                gl_RayFlagsOpaqueEXT,
                0xFF,
                0,   // sbtRecordOffset
                0,   // sbtRecordStride
                0,   // missIndex
                rayOrigin,
                0.001,
                rayDir,
                10000.0,
                0);

    // Force environment only (debug) — show pure sky
    if (push.forceEnvOnly != 0u)
    {
        vec2 envUV = vec2(atan(rayDir.z, rayDir.x) * (1.0 / (2.0 * 3.14159265359)) + 0.5,
                          acos(clamp(rayDir.y, -1.0, 1.0)) * (1.0 / 3.14159265359));

        if (push.flipEnvV != 0u)
            envUV.y = 1.0 - envUV.y;

        float rotRad = radians(push.environmentRotationY);
        envUV.x = envUV.x - 0.5;
        envUV.x = envUV.x * cos(rotRad) - envUV.y * sin(rotRad) + 0.5;
        envUV.x = fract(envUV.x);

        hitValue = texture(envMap, envUV).rgb * push.environmentExposure * push.skyIntensity;
    }

    // ONLY apply hot pink if debug is enabled AND we actually hit geometry
    // This ensures true material colors are shown when debug is off
    if (push.showHotPink != 0u)
    {
        if (hitValue != vec3(0.0))  // hitValue != 0 means closest-hit ran (geometry hit)
        {
            hitValue = vec3(1.0, 0.0, 1.0);  // Hot pink for debug
        }
        // If no hit (miss), keep env sky color — no forced pink background
    }

    imageStore(storageImage, ivec2(gl_LaunchIDEXT.xy), vec4(hitValue, 1.0));
}