// Filename: raygen.glsl
// AMOURANTH RTX Engine © 2026 — VALHALLA v∞ TURBO — APOCALYPSE FINAL
// RAY GENERATION SHADER — PRIMARY RAY LAUNCH + TEMPORAL ACCUMULATION
// PINK PHOTONS SCREAM ETERNAL — AMOURANTH FOREVER 💖
// =============================================================================

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

layout(location = 0) rayPayloadEXT vec3 hitColor;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D rtOutput;
layout(set = 0, binding = 2) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 cameraPos;
    uint frameNumber;
    uint spp;
    uint seed;
    float exposure;
    float time;
} ubo;

layout(push_constant) uniform PushConstants {
    float time;
    uint frame;
} push;

// Simple PCG RNG for noise
uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    state = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    state = (state >> 22u) ^ state;
    return state;
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 resolution = ivec2(gl_LaunchSizeEXT.xy);

    // Simple camera ray generation
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(resolution);
    uv = uv * 2.0 - 1.0;

    vec4 target = ubo.projInverse * vec4(uv.x, uv.y, 1.0, 1.0);
    target /= target.w;

    vec4 direction = ubo.viewInverse * target;
    vec3 rayDir = normalize(direction.xyz);
    vec3 rayOrigin = ubo.cameraPos.xyz;

    // Simple RNG seed per pixel + frame
    uint seed = pcg(pixel.x + pixel.y * resolution.x + ubo.frameNumber * 1664525u);

    // Trace primary ray (your path tracing starts here)
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, 0.001, rayDir, 10000.0, 0);

    // Temporal accumulation
    vec3 newColor = hitColor;  // result from path tracer
    vec3 prevColor = imageLoad(rtOutput, pixel).rgb;

    vec3 finalColor;
    if (ubo.spp == 0) {
        // First frame: direct write (no accumulation)
        finalColor = newColor;
    } else {
        // Exponential moving average — stable, no division blowup
        float alpha = 1.0 / (ubo.spp + 1.0);
        finalColor = mix(prevColor, newColor, alpha);
    }

    // Optional: tone mapping / exposure
    finalColor *= ubo.exposure;

    imageStore(rtOutput, pixel, vec4(finalColor, 1.0));
}