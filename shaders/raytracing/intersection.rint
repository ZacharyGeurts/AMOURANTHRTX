// Filename: assets/shaders/raytracing/intersection.glsl
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

hitAttributeEXT vec3 hitPoint;  // reported hit position in object space

layout(set = 0, binding = 4) readonly buffer Primitives {
    vec4 aabbMin;
    vec4 aabbMax;
    mat4 transform;
    uint type;
    uint materialIndex;
    float destruction;
} primitives[];

layout(push_constant) uniform Push {
    float time;
} pc;

void main() {
    uint primIndex = gl_PrimitiveID;  // instance custom index → primitive index in buffer

    vec3 aabbMin = primitives[primIndex].aabbMin.xyz;
    vec3 aabbMax = primitives[primIndex].aabbMax.xyz;

    // Transform ray into object space (if needed — here assuming AABBs are already in world space)
    vec3 rayOrigin    = gl_WorldRayOriginEXT;
    vec3 rayDirection = gl_WorldRayDirectionEXT;

    vec3 invDir = 1.0 / rayDirection;
    vec3 tbot   = (aabbMin - rayOrigin) * invDir;
    vec3 ttop   = (aabbMax - rayOrigin) * invDir;

    vec3 tmin = min(ttop, tbot);
    vec3 tmax = max(ttop, tbot);

    float t0 = max(max(tmin.x, tmin.y), tmin.z);
    float t1 = min(min(tmax.x, tmax.y), tmax.z);

    if (t0 > t1 || t1 < 0.0) {
        // No intersection
        return;
    }

    float hitT = (t0 > 0.0) ? t0 : t1;

    if (hitT < gl_RayTminEXT || hitT > gl_RayTmaxEXT) {
        return;
    }

    // Report hit
    reportIntersectionEXT(hitT, 0u);  // hit kind 0 = generic procedural hit
}