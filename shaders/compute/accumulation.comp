//
// Temporal Accumulation Compute Shader — Production Ready
// Fixed: Removed invalid 'writeonly' qualifier (GLSL does not allow dropping qualifiers)
// Now uses standard rgba16f storage image binding
// Stable exponential accumulation with jitter-based reprojection
// =============================================================================

#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_ARB_gpu_shader_int64 : enable

// -----------------------------------------------------------------------------
// Layout: Local workgroup size
// -----------------------------------------------------------------------------
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// -----------------------------------------------------------------------------
// Descriptor Set 0 — Matches VulkanRenderer accumulation pipeline bindings
// -----------------------------------------------------------------------------
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D  imgCurrentColor;     // Current frame ray traced output
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D  imgHistory;          // Previous accumulated frame
layout(set = 0, binding = 2, rgba16f) uniform image2D           imgAccumulation;     // Output: new accumulated result

layout(set = 0, binding = 4, std140) uniform CameraSceneData {
    float     time;
    uint      frame;
    uint      currentSpp;
    uint      totalSpp;
    float     exposure;
    uint      enableEnvMap;
    uint      hypertraceEnabled;
    uint      denoisingEnabled;
    uint      adaptiveEnabled;
    uint      debugMode;
    float     envIntensity;
    float     envRotation;

    vec2      resolution;
    vec2      jitter;
    vec2      jitterPrev;
    float     nexusScoreThreshold;
    float     hypertraceJitterScale;
    float     _pad0;
    float     _pad1;

    mat4      view;
    mat4      proj;
    mat4      invView;
    mat4      invProj;

    vec4      camPos;
    vec4      camDir;
    float     fov;
    float     aperture;
    float     focusDistance;
    uint      _pad2;

    uint      materialCount;
    uint      activeMaterialIndex;
    float     metallicOverride;
    float     roughnessOverride;
    float     emissiveIntensity;
    uint      enableBlueNoise;
    uint      enableTAA;
    float     taaAlpha;

    vec3      sunDirection;
    float     sunIntensity;
    vec3      sunColor;
    float     fogDensity;
    vec3      fogColor;
    float     _pad3;

    uint      showNexusScore;
    uint      showSppHeatmap;
    uint      showAccumulationCount;
    uint      showGpuTimestamps;
    float     debugFloat1;
    float     debugFloat2;
    float     debugFloat3;
    float     debugFloat4;
} camData;

// -----------------------------------------------------------------------------
// Clamping for FP16 stability
// -----------------------------------------------------------------------------
const float COLOR_CLAMP_MIN = 0.0;
const float COLOR_CLAMP_MAX = 65504.0;  // Max safe value in rgba16f

vec3 safeClamp(vec3 color) {
    return clamp(color, vec3(COLOR_CLAMP_MIN), vec3(COLOR_CLAMP_MAX));
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x >= int(camData.resolution.x) || coord.y >= int(camData.resolution.y)) {
        return;
    }

    vec3 currentColor = imageLoad(imgCurrentColor, coord).rgb;
    currentColor = safeClamp(currentColor);

    vec3 accumulated = currentColor;

    if (camData.frame > 0 && camData.enableTAA != 0) {
        // Reproject using previous jitter
        vec2 uv = (vec2(coord) + 0.5) / camData.resolution;
        vec2 uvReproj = uv + (camData.jitterPrev - camData.jitter);

        // Sample history (clamped to border to avoid artifacts)
        vec3 history = imageLoad(imgHistory, ivec2(uvReproj * camData.resolution)).rgb;
        history = safeClamp(history);

        // Exponential blend
        float alpha = camData.taaAlpha;
        accumulated = mix(history, currentColor, alpha);
    }

    imageStore(imgAccumulation, coord, vec4(accumulated, 1.0));
}