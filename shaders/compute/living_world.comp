#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// Output: small storage buffer for living world params (64 bytes)
layout(set = 0, binding = 7, scalar) buffer LivingWorldBuffer {
    vec4 sunDirAndIntensity;     // .xyz = direction, .w = intensity
    vec4 windDirAndSpeed;        // .xyz = direction, .w = speed
    float temperature;
    float humidity;
    uint frameSeed;              // for RNG seeding if needed
    uint padding;
} world;

// Push: just dt + totalTime from CPU (8 bytes)
layout(push_constant) uniform Push {
    // float deltaTime; RKO
    float totalTime;
} pc;

void main() {
    float t = pc.totalTime;

    // Sun cycle — simple 24-hour sin wave
    float dayFrac = fract(t / 24.0);
    float elevation = sin(dayFrac * 6.28318530718 - 1.57079632679); // peak at noon
    float azimuth   = dayFrac * 6.28318530718;

    vec3 sunDir = vec3(
        cos(elevation) * sin(azimuth),
        sin(elevation),
        cos(elevation) * cos(azimuth)
    );
    sunDir = normalize(sunDir);

    float sunInt = max(0.0, elevation * 1.5 + 0.2); // day/night falloff

    world.sunDirAndIntensity = vec4(sunDir, sunInt);

    // Wind — swirling over time
    float windAngle = t * 0.01;
    vec3 windDir = vec3(cos(windAngle), 0.0, sin(windAngle));
    windDir = normalize(windDir);

    float windSpd = 5.0 + sin(t * 0.1) * 4.0 + sin(t * 0.03) * 2.0;

    world.windDirAndSpeed = vec4(windDir, windSpd);

    // Temperature & humidity — derived from day/night
    float dayFactor = sin(dayFrac * 6.28318530718);
    world.temperature = 15.0 + dayFactor * 15.0;
    world.humidity    = 0.5 + (1.0 - abs(dayFactor)) * 0.5;

    // Frame seed — simple LCG for RNG if shaders need it
    world.frameSeed = uint(t * 1000.0) * 1664525u + 1013904223u; // classic LCG params
}