#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// ────────────────────────────────────────────────────────────────
// Single small persistent storage buffer — written once per frame
// 64 bytes total — nicely aligned, scalar layout
// ────────────────────────────────────────────────────────────────
layout(set = 0, binding = 7, scalar) buffer restrict writeonly LivingWorldBuffer
{
    vec4  sunDirAndIntensity;     // .xyz = normalized direction, .w = intensity (~0..1.7)
    vec4  windDirAndSpeed;        // .xyz = normalized direction, .w = speed (~1..13 m/s)
    float temperature;            // °C, roughly 0..35
    float humidity;               // 0..1
    uint  frameSeed;              // simple LCG seed for other shaders
    uint  padding;                // keep block 64 bytes / 16 floats
} world;

// ────────────────────────────────────────────────────────────────
// Push constant: only absolute total time (no deltaTime anywhere)
// ────────────────────────────────────────────────────────────────
layout(push_constant) uniform Push
{
    float totalTime;
} pc;


void main()
{
    float t = pc.totalTime;

    // ── Day fraction [0,1) ────────────────────────────────────────
    float dayFrac = fract(t / 86400.0);           // 86400 = 24*60*60 — real seconds

    // ── Sun ───────────────────────────────────────────────────────
    // Noon at dayFrac ≈ 0.5 → elevation = 90° at noon
    float sunTime   = dayFrac * 6.283185307179586; // 2π
    float elevation = sin(sunTime - 1.5707963267948966); // peak at noon
    float azimuth   = sunTime * 0.25;              // one full rotation per day

    vec3 sunDir = normalize(vec3(
        cos(elevation) * sin(azimuth),
        sin(elevation),
        cos(elevation) * cos(azimuth)
    ));

    // Intensity: ~0 at night, ~1.7 at noon, smooth
    float sunIntensity = max(0.0, elevation) * 1.5 + 0.2;

    world.sunDirAndIntensity = vec4(sunDir, sunIntensity);


    // ── Wind ──────────────────────────────────────────────────────
    // Low-frequency base + faster turbulence
    float windTurbulence = t * 0.007;
    float windBase       = t * 0.0008;

    vec3 windDir = normalize(vec3(
        sin(windBase * 1.3) * 0.7 + cos(windTurbulence * 2.1) * 0.3,
        0.0,
        cos(windBase * 1.1) * 0.7 + sin(windTurbulence * 1.7) * 0.3
    ));

    // Speed 2–14 m/s, natural variation
    float windSpeed = 5.0 + 
                      sin(t * 0.0009) * 4.0 + 
                      sin(t * 0.0042 + 1.7) * 3.0 +
                      cos(t * 0.013) * 2.0;

    world.windDirAndSpeed = vec4(windDir, windSpeed);


    // ── Temperature & Humidity ────────────────────────────────────
    // Temperature: 5–32 °C, peaks in afternoon
    float tempFactor = sin(sunTime - 0.4);           // slight afternoon bias
    world.temperature = 18.5 + tempFactor * 13.5;    // ~5–32 °C

    // Humidity: inverse to temperature (simplified)
    world.humidity = 0.45 + (1.0 - abs(tempFactor)) * 0.45;  // 0.45–0.9


    // ── Simple LCG seed for other shaders ─────────────────────────
    // Good enough for blue-noise offset, dither, etc.
    uint seed = uint(t * 54321.0);                   // arbitrary large multiplier
    seed      = seed * 1664525u + 1013904223u;       // classic LCG
    world.frameSeed = seed;
}