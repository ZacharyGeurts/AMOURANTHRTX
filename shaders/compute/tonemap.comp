#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 5, rgba16f) uniform readonly image2D imgInput;  // Free binding in set 0 (RT uses 0-4,6-11,31)
layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D imgOutput;  // Free binding
layout(set = 0, binding = 13, std140) uniform TonemapUBO {  // Free binding for post-process UBO
    float     exposure;
    uint      type;              // 0=ACES, 1=Filmic, 2=Reinhard
    uint      enabled;
    float     nexusScore;
    uint      frame;
    uint      spp;
    
    float     gamma;
    float     bloomThreshold;
    float     bloomIntensity;
    float     vignetteIntensity;
    float     filmGrainStrength;
    float     lensFlareIntensity;
    
    float     _pad[2];
} ubo;

// Simple inline film grain noise (no external include needed)
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 uv) {
    vec2 i = floor(uv), f = fract(uv);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), f.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

float filmGrain(vec2 uv, uint frame) {
    return noise(uv * 100.0 + float(frame) * 0.01) * 2.0 - 1.0;
}

// Tonemapping operators — EMPIRE FILMIC ETERNAL
vec3 reinhard(vec3 x) {
    return x / (1.0 + x);
}

vec3 filmic(vec3 x) {
    // Uncharted 2 approximation
    const float A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

vec3 aces(vec3 x) {
    // ACES Filmic Curve
    const mat3 ACES_INPUT = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777
    );
    const mat3 ACES_OUTPUT = mat3(
        1.60475, -0.10208, -0.00327,
        -0.53108,  1.10813, -0.07276,
        -0.07367, -0.00605,  1.07795
    );
    x = ACES_INPUT * x;
    x = clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
    return ACES_OUTPUT * x;
}

// Bloom: threshold-based intensity boost
vec3 applyBloom(vec3 color) {
    float luma = dot(color, vec3(0.299, 0.587, 0.114));
    float bloom = smoothstep(ubo.bloomThreshold - 0.5, ubo.bloomThreshold + 0.5, luma);
    return color + color * bloom * ubo.bloomIntensity;
}

// Vignette: radial falloff
float applyVignette(vec2 uv) {
    vec2 center = uv - 0.5;
    float dist = length(center);
    return 1.0 - ubo.vignetteIntensity * dist * dist;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    vec2 res = vec2(imageSize(imgInput));
    if (pix.x >= int(res.x) || pix.y >= int(res.y)) {
        return;
    }

    vec2 uv = (vec2(pix) + 0.5) / res;

    if (ubo.enabled == 0u) {
        vec3 color = imageLoad(imgInput, pix).rgb;
        imageStore(imgOutput, pix, vec4(color, 1.0));
        return;
    }

    vec3 color = imageLoad(imgInput, pix).rgb;

    // Exposure adjustment
    color *= ubo.exposure;

    // Select tonemap operator
    if (ubo.type == 0u) {
        color = aces(color);
    } else if (ubo.type == 1u) {
        color = filmic(color);
    } else {
        color = reinhard(color);  // Default: Reinhard
    }

    // Post-tonemap effects
    color = applyBloom(color);
    color *= applyVignette(uv);

    // Film grain (additive noise scaled by color)
    if (ubo.filmGrainStrength > 0.0) {
        float grain = filmGrain(uv * res, ubo.frame) * ubo.filmGrainStrength;
        color += color * grain * 0.05;  // Subtle scaling
    }

    // Gamma correction
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / ubo.gamma));

    // Lens flare stub: simple bright boost (expand with samples if needed)
    if (ubo.lensFlareIntensity > 0.0) {
        float luma = dot(color, vec3(0.299, 0.587, 0.114));
        color += vec3(1.0, 0.8, 0.6) * luma * luma * ubo.lensFlareIntensity * 0.1;
    }

    imageStore(imgOutput, pix, vec4(color, 1.0));
}