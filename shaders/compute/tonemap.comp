// tonemap.comp
#version 460

layout(binding = 1, set = 0, rgba32f) uniform readonly image2D rtInput;
layout(binding = 0, set = 0, rgba32f) uniform writeonly image2D outputImage;

layout(push_constant) uniform Constants {
    float exposure;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rtInput);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 color = imageLoad(rtInput, pixel).rgb;

    color *= pc.exposure;

    // ACES Filmic
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    color = clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);

    color = pow(color, vec3(1.0 / 2.2));

    imageStore(outputImage, pixel, vec4(color, 1.0));
}