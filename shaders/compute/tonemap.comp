// assets/shaders/compute/tonemap.comp
// =============================================================================
// AMOURANTH RTX Engine (C) 2025-2026 — Tonemap Compute Shader
// Production-ready ACES-inspired tonemapping with exposure, bloom threshold,
// film grain, vignette, and lens flare controls
// =============================================================================

#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings match VulkanRenderer tonemap pipeline
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D imgInput;        // HDR input (accumulated or denoised)
layout(set = 0, binding = 1, rgba8)   uniform writeonly image2D imgOutput;      // LDR swapchain output

layout(set = 0, binding = 2, std140) uniform TonemapData {
    float  exposure;
    uint   type;             // 0 = ACES, 1 = Filmic, 2 = Reinhard
    uint   enabled;
    float  nexusScore;
    uint   frame;
    uint   spp;

    float  gamma;
    float  bloomThreshold;
    float  bloomIntensity;
    float  vignetteIntensity;
    float  filmGrainStrength;
    float  lensFlareIntensity;

    float  _pad[2];
} tonemap;

// ACES fitted (from https://github.com/TheRealMJP/BakingLab)
vec3 ACESFitted(vec3 color)
{
    const mat3 ACESInputMat = mat3(
        vec3( 0.59719, 0.07600, 0.02840),
        vec3( 0.35458, 0.90834, 0.13383),
        vec3( 0.04823, 0.01566, 0.83777)
    );

    const mat3 ACESOutputMat = mat3(
        vec3( 1.60475, -0.10208, -0.00327),
        vec3(-0.53108,  1.10813, -0.07276),
        vec3(-0.07367, -0.00605,  1.07602)
    );

    color = ACESInputMat * color;

    // Apply RRT and ODT
    vec3 a = color * (color + 0.0245786) - 0.000090537;
    vec3 b = color * (0.983729 * color + 0.4329510) + 0.238081;
    color = a / b;

    return clamp(ACESOutputMat * color, 0.0, 1.0);
}

// Simple filmic curve
vec3 FilmicTonemap(vec3 color)
{
    color = max(vec3(0.0), color - 0.004);
    color = (color * (6.2 * color + 0.5)) / (color * (6.2 * color + 1.7) + 0.06);
    return color;
}

// Reinhard
vec3 ReinhardTonemap(vec3 color)
{
    return color / (color + 1.0);
}

// Simple bloom extract (threshold only)
vec3 ExtractBloom(vec3 color)
{
    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
    float contrib = smoothstep(tonemap.bloomThreshold, tonemap.bloomThreshold + 0.5, luminance);
    return color * contrib;
}

// Film grain
float FilmGrain(vec2 uv, float strength)
{
    float noise = fract(sin(dot(uv * tonemap.frame, vec2(12.9898, 78.233))) * 43758.5453);
    return mix(1.0, noise, strength);
}

// Vignette
float Vignette(vec2 uv)
{
    uv = uv * 2.0 - 1.0;
    float dist = length(uv);
    return 1.0 - smoothstep(0.7, 1.4, dist) * tonemap.vignetteIntensity;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 resolution = vec2(imageSize(imgInput));

    if (coord.x >= resolution.x || coord.y >= resolution.y)
        return;

    vec3 hdrColor = imageLoad(imgInput, coord).rgb;

    // Exposure
    hdrColor *= tonemap.exposure;

    // Tonemapping
    vec3 ldrColor;
    if (tonemap.type == 0) {
        ldrColor = ACESFitted(hdrColor);
    } else if (tonemap.type == 1) {
        ldrColor = FilmicTonemap(hdrColor);
    } else {
        ldrColor = ReinhardTonemap(hdrColor);
    }

    // Bloom add (simple)
    vec3 bloom = ExtractBloom(hdrColor) * tonemap.bloomIntensity;
    ldrColor += bloom;

    // Vignette
    vec2 uv = vec2(coord) / resolution;
    ldrColor *= Vignette(uv);

    // Film grain
    ldrColor *= FilmGrain(uv, tonemap.filmGrainStrength);

    // Gamma correction
    ldrColor = pow(ldrColor, vec3(1.0 / tonemap.gamma));

    // Output
    imageStore(imgOutput, coord, vec4(ldrColor, 1.0));
}