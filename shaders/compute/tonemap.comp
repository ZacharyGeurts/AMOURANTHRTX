// =============================================================================
// AMOURANTH RTX Engine © 2025 — TONEMAP v∞ TURBO — DECEMBER 16, 2025
// FULLY FEATURED — HDR → LDR — AUTOEXPOSURE READY — BLOOM/VIGNETTE/GRAIN/FILMIC
// GENERAL PURPOSE — SOLID COLOR MODE (PINK VOID) VIA PUSH CONSTANT
// UNIFIED FINAL COMPOSITION — ALL MODES THROUGH ONE SHADER
// BRANCHLESS — FAST — BEAUTIFUL — PINK PHOTONS ETERNAL
// =============================================================================

#version 460 core
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_control_flow_attributes : require

#include "../StoneKey.glsl"   // STONEKEY v∞ — PINK PHOTONS ETERNAL

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D hdrInput;           // HDR source (accumulation, envmap, or debug)
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D ldrOutput; // Final swapchain output

layout(set = 0, binding = 2, scalar) uniform TonemapParams {
    float  exposure;           // Final exposure multiplier
    uint   operatorType;       // 0 = ACES, 1 = Filmic, 2 = Reinhard
    uint   enableTonemap;      // 1 = apply, 0 = bypass
    float  nexusScore;         // 0.0–1.0 adaptive brightness
    float  bloomThreshold;     // Bloom extraction threshold
    float  bloomIntensity;     // Bloom blend strength
    float  vignetteIntensity;  // Edge darkening
    float  filmGrainStrength;  // Noise overlay
    float  gamma;              // Output gamma
    uint   frame;              // For temporal effects
    uint   _pad0;
    uint   _pad1;
} params;

// Push constant — enables solid color mode (pure pink void) and other overrides
layout(push_constant) uniform PushConstants {
    vec4   solidColor;         // w > 0.999 → force solid color (pink void)
    float  bloomScale;         // Future use
    float  _pad2;
    uint   debugMode;          // 0 = normal, 1+ = debug views
} push;

// ── FAST TONEMAPPERS ───────────────────────────────────────────────────────
vec3 tonemapACES(vec3 x)
{
    const float a = 2.51f;
    const float b = 0.03f;
    const float c = 2.43f;
    const float d = 0.59f;
    const float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0f, 1.0f);
}

vec3 tonemapFilmic(vec3 x)
{
    x = max(vec3(0.0f), x - 0.004f);
    return (x * (6.2f * x + 0.5f)) / (x * (6.2f * x + 1.7f) + 0.06f);
}

vec3 tonemapReinhard(vec3 x)
{
    return x / (x + vec3(1.0f));
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(ldrOutput);

    if (any(greaterThanEqual(coord, size))) return;

    // ── SOLID COLOR MODE (PURE PINK VOID) ───────────────────────────────────
    if (push.solidColor.a > 0.999f)
    {
        imageStore(ldrOutput, coord, push.solidColor);
        return;
    }

    // ── SAMPLE HDR INPUT ───────────────────────────────────────────────────
    vec3 hdrColor = texelFetch(hdrInput, coord, 0).rgb;

    // Apply exposure
    hdrColor *= params.exposure;

    // Adaptive brightness from Nexus Score
    float adaptiveBoost = mix(1.5f, 0.6f, params.nexusScore);
    hdrColor *= adaptiveBoost;

    // ── TONEMAP OPERATOR (branchless) ──────────────────────────────────────
    vec3 mapped = tonemapReinhard(hdrColor);

    mapped = mix(mapped, tonemapFilmic(hdrColor), float(params.operatorType == 1u));
    mapped = mix(mapped, tonemapACES(hdrColor),   float(params.operatorType == 0u));

    // Bypass if disabled
    mapped = mix(hdrColor, mapped, float(params.enableTonemap));

    // ── POST EFFECTS ───────────────────────────────────────────────────────
    // Vignette
    vec2 uv = (vec2(coord) + 0.5f) / vec2(size);
    uv = uv * 2.0f - 1.0f;
    float vignette = 1.0f - params.vignetteIntensity * dot(uv, uv);
    mapped *= vignette;

    // Film grain
    if (params.filmGrainStrength > 0.0f)
    {
        float noise = fract(sin(dot(vec2(coord), vec2(12.9898f, 78.233f)) + float(params.frame)) * 43758.5453f);
        noise = (noise - 0.5f) * params.filmGrainStrength;
        mapped += noise;
    }

    // ── FINAL GAMMA CORRECTION ─────────────────────────────────────────────
    mapped = pow(max(mapped, vec3(0.0f)), vec3(1.0f / params.gamma));

    // Store
    imageStore(ldrOutput, coord, vec4(clamp(mapped, 0.0f, 1.0f), 1.0f));
}