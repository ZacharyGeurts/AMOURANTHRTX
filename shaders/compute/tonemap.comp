// AMOURANTH RTX Engine © 2025 — TONEMAP v∞ TURBO — PURE FINAL COMPOSITION
// HDR → LDR — AUTOEXPOSURE — BLOOM/VIGNETTE/GRAIN/FILMIC/ACES/REINHARD
// NEW: GENERATED NORMAL ENV HDR FALLBACK — SOFT BLUE SKY + SUN + GROUND
// SOLID COLOR MODE (PINK VOID) VIA PUSH CONSTANT
// NO EXTERNAL TEXTURE DEPENDENCY — ALWAYS WORKS — PINK PHOTONS ETERNAL
// =============================================================================

#version 460 core
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D hdrInput;           // HDR source (RT output, accumulation, or fallback)
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D ldrOutput; // Final swapchain output

layout(set = 0, binding = 2, scalar) uniform TonemapParams {
    float  exposure;           // Final exposure multiplier
    uint   operatorType;       // 0 = ACES, 1 = Filmic, 2 = Reinhard
    uint   enableTonemap;      // 1 = apply, 0 = bypass
    float  nexusScore;         // 0.0–1.0 adaptive brightness
    float  bloomThreshold;     // Bloom extraction threshold
    float  bloomIntensity;     // Bloom blend strength
    float  vignetteIntensity;  // Edge darkening
    float  filmGrainStrength;  // Noise overlay
    float  gamma;              // Output gamma
    uint   frame;              // For temporal effects
    uint   _pad0;
    uint   _pad1;
} params;

// Push constant — controls render mode and overrides
layout(push_constant) uniform PushConstants {
    vec4   solidColor;         // w > 0.999 → force solid color (pink void)
    uint   envMode;            // 0 = use hdrInput, 1 = generated normal env HDR
    float  _pad2;
    uint   debugMode;          // Future use
} push;

// ── GENERATED NORMAL ENVIRONMENT HDR — SOFT BLUE SKY + SUN + GROUND ────────
vec3 normalEnvHDR(vec3 dir)
{
    // Normalize direction
    dir = normalize(dir);

    // Sky gradient — soft blue
    float skyFactor = max(dir.y, 0.0);
    vec3 skyColor = mix(vec3(0.35, 0.45, 0.65), vec3(0.6, 0.8, 1.0), skyFactor * skyFactor);

    // Ground — subtle brown/gray
    float groundFactor = max(-dir.y, 0.0);
    vec3 groundColor = vec3(0.4, 0.35, 0.3) * groundFactor;

    // Sun — bright directional light
    vec3 sunDir = normalize(vec3(0.3, 0.8, 0.4));
    float sun = pow(max(dot(dir, sunDir), 0.0), 256.0) * 30.0;

    return skyColor + groundColor + vec3(1.0) * sun;
}

// ── FAST TONEMAPPERS ───────────────────────────────────────────────────────
vec3 tonemapACES(vec3 x)
{
    const float a = 2.51f;
    const float b = 0.03f;
    const float c = 2.43f;
    const float d = 0.59f;
    const float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0f, 1.0f);
}

vec3 tonemapFilmic(vec3 x)
{
    x = max(vec3(0.0f), x - 0.004f);
    return (x * (6.2f * x + 0.5f)) / (x * (6.2f * x + 1.7f) + 0.06f);
}

vec3 tonemapReinhard(vec3 x)
{
    return x / (x + vec3(1.0f));
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(ldrOutput);

    if (any(greaterThanEqual(coord, size))) return;

    vec3 hdrColor;

    // ── GENERATED NORMAL ENV HDR MODE ───────────────────────────────────────
    if (push.envMode == 1u) {
        // Equirectangular projection
        vec2 uv = (vec2(coord) + 0.5f) / vec2(size);
        float longitude = uv.x * 2.0 * 3.14159265;
        float latitude  = uv.y * 3.14159265;

        vec3 dir = vec3(
            sin(latitude) * cos(longitude),
            cos(latitude),
            sin(latitude) * sin(longitude)
        );

        hdrColor = normalEnvHDR(dir);
    }
    // ── SOLID COLOR MODE (PURE PINK VOID) ───────────────────────────────────
    else if (push.solidColor.a > 0.999f) {
        imageStore(ldrOutput, coord, push.solidColor);
        return;
    }
    // ── NORMAL HDR INPUT (RT OUTPUT OR ACCUMULATION) ────────────────────────
    else {
        hdrColor = texelFetch(hdrInput, coord, 0).rgb;
    }

    // Apply exposure
    hdrColor *= params.exposure;

    // Adaptive brightness from Nexus Score
    float adaptiveBoost = mix(1.5f, 0.6f, params.nexusScore);
    hdrColor *= adaptiveBoost;

    // ── TONEMAP OPERATOR (branchless) ──────────────────────────────────────
    vec3 mapped = tonemapReinhard(hdrColor);

    [[flatten]] if (params.operatorType == 1u) mapped = tonemapFilmic(hdrColor);
    [[flatten]] if (params.operatorType == 0u) mapped = tonemapACES(hdrColor);

    // Bypass if disabled
    mapped = mix(hdrColor, mapped, float(params.enableTonemap));

    // ── POST EFFECTS ───────────────────────────────────────────────────────
    // Vignette
    vec2 uv = (vec2(coord) + 0.5f) / vec2(size);
    uv = uv * 2.0f - 1.0f;
    float vignette = 1.0f - params.vignetteIntensity * dot(uv, uv);
    mapped *= vignette;

    // Film grain
    if (params.filmGrainStrength > 0.0f) {
        float noise = fract(sin(dot(vec2(coord), vec2(12.9898f, 78.233f)) + float(params.frame)) * 43758.5453f);
        noise = (noise - 0.5f) * params.filmGrainStrength;
        mapped += noise;
    }

    // ── FINAL GAMMA CORRECTION ─────────────────────────────────────────────
    mapped = pow(max(mapped, vec3(0.0f)), vec3(1.0f / params.gamma));

    // Store final LDR
    imageStore(ldrOutput, coord, vec4(clamp(mapped, 0.0f, 1.0f), 1.0f));
}