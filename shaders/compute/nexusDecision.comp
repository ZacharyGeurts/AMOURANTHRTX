// shaders/compute/nexusdecision.comp — FIXED COMPILATION — DECEMBER 18, 2025
// =============================================================================
// AMOURANTH RTX Engine © 2025 — NEXUS DECISION v∞ TURBO — ADAPTIVE SAMPLING BRAIN
// Computes per-pixel variance + luminance → nexus score for adaptive sampling
// R16G16_SFLOAT target — variance in R, luminance in G
// HIGH PRECISION — TEMPORAL STABILITY — NOISE-FREE DECISION
// FIXED: removed 'writeonly' on imageStore target (GLSL restriction)
// PINK PHOTONS ETERNAL — EMPIRE SAMPLES WISELY
// =============================================================================

#version 460 core
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly uniform image2D currentColor;   // Current frame RT output
layout(set = 0, binding = 1, rgba16f) readonly uniform image2D historyColor;   // Previous accumulated frame
layout(set = 0, binding = 2, rg16f) uniform image2D nexusOutput;               // R = variance, G = luminance (removed writeonly)

layout(set = 0, binding = 3, scalar) uniform NexusParams {
    float varianceSensitivity;   // How sensitive to variance (50.0 typical)
    float luminanceThreshold;    // Base luminance for high-detail areas
    float temporalStability;     // Blend factor with history (0.9 = stable)
    float _pad;
} params;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(currentColor);

    if (any(greaterThanEqual(coord, size))) return;

    vec3 current = imageLoad(currentColor, coord).rgb;
    vec3 history = imageLoad(historyColor, coord).rgb;

    // Convert to luminance
    float lumCurrent = dot(current, vec3(0.2126f, 0.7152f, 0.0722f));
    float lumHistory = dot(history, vec3(0.2126f, 0.7152f, 0.0722f));

    // Variance — difference in luminance (simple but effective)
    float variance = abs(lumCurrent - lumHistory);

    // Apply sensitivity
    variance *= params.varianceSensitivity;

    // Clamp variance to reasonable range
    variance = clamp(variance, 0.0f, 1.0f);

    // Final luminance — use current for responsiveness
    float luminance = lumCurrent;

    // Boost variance in bright areas (edges in highlights)
    variance *= mix(1.0f, 2.0f, step(params.luminanceThreshold, luminance));

    // Temporal smoothing of variance (reduces flickering decisions)
    float historyVariance = imageLoad(nexusOutput, coord).r;
    variance = mix(variance, historyVariance, params.temporalStability);

    // Output: R = variance (for adaptive sampling), G = luminance (for UI/debug)
    imageStore(nexusOutput, coord, vec4(variance, luminance, 0.0f, 0.0f));
}