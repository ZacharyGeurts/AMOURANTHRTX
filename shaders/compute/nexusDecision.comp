#version 460
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D imgCurrent;   // Current noisy frame (RT output)
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D imgHistory;   // Previous denoised/accum frame
layout(set = 0, binding = 2, rg16f)   uniform writeonly image2D imgScore;     // Output: R = variance, G = luminance

layout(push_constant) uniform Push {
    float varianceClip;     // Clip fireflies (e.g., 10.0)
    float luminanceWeight;  // Boost score in dark areas (e.g., 3.0)
    float minVariance;      // Floor to prevent zero sampling (e.g., 0.001)
} pc;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= imageSize(imgCurrent).x || pix.y >= imageSize(imgCurrent).y) return;

    vec3 curr = imageLoad(imgCurrent, pix).rgb;
    vec3 hist = imageLoad(imgHistory, pix).rgb;

    vec3 diff = curr - hist;
    float variance = dot(diff, diff);

    variance = min(variance, pc.varianceClip);

    float lum = luminance(hist);
    float darkBoost = 1.0 + (1.0 - smoothstep(0.0, 0.2, lum)) * pc.luminanceWeight;

    variance = max(variance * darkBoost, pc.minVariance);

    imageStore(imgScore, pix, vec4(variance, lum, 0.0, 0.0));
}