// assets/shaders/compute/nexusDecision.comp
// =============================================================================
// AMOURANTH RTX Engine (C) 2025-2026 — Nexus Adaptive Sampling Decision Shader
// Computes per-pixel variance and luminance to drive adaptive sampling
// Outputs to rgba16f image: variance in R, average luminance in G
// Fixed: uses rgba16f instead of invalid r16g16
// =============================================================================

#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings — matches renderer expectations
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D  imgCurrent;     // Current frame color
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D  imgHistory;      // Previous accumulated frame
layout(set = 0, binding = 2, rgba16f) uniform image2D           imgNexusScore;   // Output: variance (R), luminance (G), 0, 1

layout(set = 0, binding = 4, std140) uniform CameraSceneData {
    float     time;
    uint      frame;
    uint      currentSpp;
    uint      totalSpp;
    float     exposure;
    uint      enableEnvMap;
    uint      hypertraceEnabled;
    uint      denoisingEnabled;
    uint      adaptiveEnabled;
    uint      debugMode;
    float     envIntensity;
    float     envRotation;

    vec2      resolution;
    vec2      jitter;
    vec2      jitterPrev;
    float     nexusScoreThreshold;
    float     hypertraceJitterScale;
    float     _pad0;
    float     _pad1;

    mat4      view;
    mat4      proj;
    mat4      invView;
    mat4      invProj;

    vec4      camPos;
    vec4      camDir;
    float     fov;
    float     aperture;
    float     focusDistance;
    uint      _pad2;

    uint      materialCount;
    uint      activeMaterialIndex;
    float     metallicOverride;
    float     roughnessOverride;
    float     emissiveIntensity;
    uint      enableBlueNoise;
    uint      enableTAA;
    float     taaAlpha;

    vec3      sunDirection;
    float     sunIntensity;
    vec3      sunColor;
    float     fogDensity;
    vec3      fogColor;
    float     _pad3;

    uint      showNexusScore;
    uint      showSppHeatmap;
    uint      showAccumulationCount;
    uint      showGpuTimestamps;
    float     debugFloat1;
    float     debugFloat2;
    float     debugFloat3;
    float     debugFloat4;
} camData;

// Sample 3x3 neighborhood safely
vec3 sampleColor(ivec2 base, int dx, int dy)
{
    ivec2 offset = ivec2(dx, dy);
    ivec2 coord = clamp(base + offset, ivec2(0), ivec2(camData.resolution - 1.0));
    return imageLoad(imgCurrent, coord).rgb;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x >= int(camData.resolution.x) || coord.y >= int(camData.resolution.y))
        return;

    vec3 center = imageLoad(imgCurrent, coord).rgb;

    // 3x3 neighborhood samples
    vec3 samples[9];
    int idx = 0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            samples[idx++] = sampleColor(coord, dx, dy);
        }
    }

    // Compute mean
    vec3 mean = vec3(0.0);
    for (int i = 0; i < 9; ++i)
        mean += samples[i];
    mean /= 9.0;

    // Spatial variance
    float variance = 0.0;
    for (int i = 0; i < 9; ++i) {
        vec3 diff = samples[i] - mean;
        variance += dot(diff, diff);
    }
    variance /= 9.0;

    // Temporal variance (compare with history)
    vec3 history = imageLoad(imgHistory, coord).rgb;
    vec3 temporalDiff = center - history;
    float temporalVariance = dot(temporalDiff, temporalDiff);
    variance = max(variance, temporalVariance * 0.5);  // Weight temporal slightly less

    // Perceptual luminance
    float luminance = dot(center, vec3(0.2126, 0.7152, 0.0722));

    // Output: variance in R, luminance in G, 0 in B/A
    imageStore(imgNexusScore, coord, vec4(variance, luminance, 0.0, 1.0));
}