// assets/shaders/compute/envmap_display.comp
// =============================================================================
// AMOURANTH RTX Engine (C) 2025-2026 — Environment Map Direct Display Shader
// Renders the equirectangular HDR environment map directly to the swapchain
// Used as a fallback when ray tracing is not ready or for debug visualization
// UPDATED JANUARY 03, 2026 — Proper aspect-ratio preserving display with letterboxing
// No vertical flip (zenith at top), exposure boost, black bars for correct proportions
// Production-ready, efficient, and HDR-aware
// =============================================================================

#version 460
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings — matches VulkanRenderer envmap display pipeline
layout(set = 0, binding = 0) uniform sampler2D envMap;          // HDR equirectangular environment map
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outColor;  // Swapchain storage image (assumed float16 capable)

// Push constants: screen resolution
layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x >= pc.width || coord.y >= pc.height)
        return;

    // Normalized UV (center sampling, no Y flip — zenith at top of screen)
    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(pc.width, pc.height);

    // Preserve 2:1 envmap aspect ratio with letterboxing/pillarboxing
    const float envAspect = 2.0;
    float screenAspect = float(pc.width) / float(pc.height);

    vec2 scaledUV = uv;

    if (screenAspect > envAspect) {
        // Screen wider than 2:1 → pillarbox (black bars on sides)
        float widthScale = envAspect / screenAspect;
        scaledUV.x = (uv.x - 0.5) / widthScale + 0.5;
    } else {
        // Screen taller than 2:1 → letterbox (black bars on top/bottom)
        float heightScale = screenAspect / envAspect;
        scaledUV.y = (uv.y - 0.5) / heightScale + 0.5;
    }

    vec3 envColor;

    // Outside the fitted region → sacred black (avoids stretching/distortion)
    if (scaledUV.x < 0.0 || scaledUV.x > 1.0 || scaledUV.y < 0.0 || scaledUV.y > 1.0) {
        envColor = vec3(0.0);
    } else {
        // Sample environment map
        envColor = texture(envMap, scaledUV).rgb;

        // Exposure boost to match engine default (makes pink fallback and dim HDRs visible)
        envColor *= 4.0;

        // Clamp to FP16 safe range (prevents fireflies/NaN)
        envColor = clamp(envColor, vec3(0.0), vec3(65504.0));
    }

    // Write to swapchain
    imageStore(outColor, coord, vec4(envColor, 1.0));
}