#version 460 core

// envmap_display.comp - Compute shader to tonemap and display envmap (cube or equirect) to screen/output
// Dispatch with: (width + 15)/16, (height + 15)/16, 1
// Local size 16x16x1

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube envSampler;  // Input cubemap sampler (or sampler2D for equirect)
layout(set = 0, binding = 1, rgba16f) uniform image2D outputImage;  // Output storage image (RT output or swapchain, GENERAL layout)

layout(push_constant) uniform PushConstants {
    vec2 resolution;  // Screen resolution
    float exposure;   // Exposure value
    uint tonemapType; // 0: Reinhard, 1: ACES, etc.
} pc;

const float PI = 3.1415926535897932384626433832795;

// Tonemapping operators
vec3 reinhard(vec3 color) {
    return color / (color + vec3(1.0));
}

vec3 aces(vec3 color) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
}

vec3 tonemap(vec3 color) {
    color *= pc.exposure;
    if (pc.tonemapType == 0) return reinhard(color);
    else return aces(color);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.resolution.x) || coord.y >= int(pc.resolution.y)) return;

    vec2 uv = (vec2(coord) + 0.5) / pc.resolution;

    // Simple spherical projection for direction
    float theta = uv.y * PI;
    float phi = uv.x * 2.0 * PI - PI;  // Adjust for correct mapping

    vec3 dir;
    float sinTheta = sin(theta);
    dir.x = sinTheta * cos(phi);
    dir.y = cos(theta);
    dir.z = sinTheta * sin(phi);

    // Sample cubemap
    vec3 color = texture(envSampler, dir).rgb;

    // Apply tonemapping
    color = tonemap(color);

    // Store to output
    imageStore(outputImage, coord, vec4(color, 1.0));
}