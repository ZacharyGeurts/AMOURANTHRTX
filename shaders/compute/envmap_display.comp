// assets/shaders/compute/envmap_display.comp
// =============================================================================
// AMOURANTH RTX Engine (C) 2025-2026 — Environment Map Direct Display Shader
// Renders the equirectangular HDR environment map directly to the swapchain
// Used as a fallback when ray tracing is not ready or for debug visualization
// Production-ready, efficient, and HDR-aware
// =============================================================================

#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings — matches VulkanRenderer envmap display pipeline
layout(set = 0, binding = 0) uniform sampler2D envMap;          // HDR equirectangular environment map
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outColor;  // Swapchain storage image

// Push constants: resolution
layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

// Helper: Convert UV to spherical direction for equirectangular sampling
vec3 equirectDirection(vec2 uv)
{
    // uv in [0,1] → spherical coordinates
    vec2 spherical = uv * vec2(2.0 * 3.14159265359, 3.14159265359) - vec2(3.14159265359, 1.57079632679);
    float sinPhi = sin(spherical.y);
    vec3 dir;
    dir.x = sinPhi * sin(spherical.x);
    dir.y = cos(spherical.y);
    dir.z = sinPhi * cos(spherical.x);
    return dir;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x >= pc.width || coord.y >= pc.height)
        return;

    // Normalized UV with center sampling
    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(pc.width, pc.height);

    // Flip Y to match Vulkan coordinate system (top-left origin)
    uv.y = 1.0 - uv.y;

    // Sample environment map
    vec3 envColor = texture(envMap, uv).rgb;

    // Optional: simple exposure adjustment (can be controlled externally if needed)
    envColor *= 1.5;  // Slight boost for visibility

    // Clamp to prevent fireflies in FP16
    envColor = clamp(envColor, vec3(0.0), vec3(65504.0));

    // Write to swapchain
    imageStore(outColor, coord, vec4(envColor, 1.0));
}